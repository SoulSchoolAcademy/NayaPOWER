<script>
(() => {
  "use strict";

  /* =========================================================
     MAXESS E02 RESULT BINDING

     Authority is intentionally narrow:
       1. window.MAXESS_RESULT
       2. parent.MAXESS_RESULT
       3. top.MAXESS_RESULT

     No storage authority.
     No hash authority.
     No second scoring engine.
     No fabricated production scores.
     ========================================================= */

  const root = document.getElementById("maxess-e02-v2");

  if (!root) {
    return;
  }

  const CONTRACT_VERSION = "MAXESS_RESULT_V1";

  const DIMENSIONS = [
    "DIRECTION",
    "COMMUNICATION",
    "EVALUATION",
    "ITERATION",
    "SYSTEMS THINKING"
  ];

  const dimensionNodes = Array.from(
    root.querySelectorAll(".e02-dimension")
  );

  let lastSignature = "";

  /* =========================================================
     SAFE NUMBER HANDLING
     ========================================================= */

  function clampScore(value) {
    if (
      value === null ||
      value === undefined ||
      value === ""
    ) {
      return null;
    }

    const number = Number(value);

    if (!Number.isFinite(number)) {
      return null;
    }

    return Math.max(
      0,
      Math.min(100, number)
    );
  }

  /* =========================================================
     DIMENSION ID NORMALIZATION
     ========================================================= */

  function normalize(value) {
    return String(value || "")
      .toLowerCase()
      .replace(/[^a-z0-9]/g, "");
  }

  /* =========================================================
     RESULT CONTRACT VALIDATION
     ========================================================= */

  function isValidResult(result) {
    if (
      !result ||
      typeof result !== "object"
    ) {
      return false;
    }

    if (
      result.contractVersion !== CONTRACT_VERSION
    ) {
      return false;
    }

    if (
      !Array.isArray(result.dimensions) ||
      result.dimensions.length !== 5
    ) {
      return false;
    }

    return true;
  }

  /* =========================================================
     AUTHORITATIVE RESULT LOOKUP
     ========================================================= */

  function readAuthoritativeResult() {
    const sources = [];

    try {
      sources.push(window.MAXESS_RESULT);
    } catch (error) {
      /* inaccessible source — continue */
    }

    try {
      if (
        window.parent &&
        window.parent !== window
      ) {
        sources.push(
          window.parent.MAXESS_RESULT
        );
      }
    } catch (error) {
      /* cross-origin parent — continue */
    }

    try {
      if (
        window.top &&
        window.top !== window &&
        window.top !== window.parent
      ) {
        sources.push(
          window.top.MAXESS_RESULT
        );
      }
    } catch (error) {
      /* cross-origin top — continue */
    }

    for (const result of sources) {
      if (isValidResult(result)) {
        return result;
      }
    }

    return null;
  }

  /* =========================================================
     DIMENSION SCORE LOOKUP
     ========================================================= */

  function readDimensionScore(
    result,
    dimensionName,
    index
  ) {
    if (
      !result ||
      !Array.isArray(result.dimensions)
    ) {
      return null;
    }

    const target = normalize(dimensionName);

    for (
      const dimension of result.dimensions
    ) {
      if (
        !dimension ||
        typeof dimension !== "object"
      ) {
        continue;
      }

      const identity = normalize(
        dimension.id ||
        dimension.dimensionId ||
        dimension.name ||
        dimension.label ||
        dimension.title
      );

      if (identity !== target) {
        continue;
      }

      const rawScore =
        dimension.score !== undefined
          ? dimension.score
          : dimension.value !== undefined
            ? dimension.value
            : dimension.overallScore;

      return clampScore(rawScore);
    }

    /*
      Contract-compatible positional fallback.
      This does not create a score; it only reads the
      already-authoritative fifth-element result contract.
    */

    const fallback = result.dimensions[index];

    if (
      fallback &&
      typeof fallback === "object"
    ) {
      const rawScore =
        fallback.score !== undefined
          ? fallback.score
          : fallback.value !== undefined
            ? fallback.value
            : fallback.overallScore;

      return clampScore(rawScore);
    }

    return clampScore(fallback);
  }

  /* =========================================================
     RESULT SIGNATURE
     Used only to avoid unnecessary DOM writes.
     It is not a second source of truth.
     ========================================================= */

  function getSignature(result) {
    if (!isValidResult(result)) {
      return "";
    }

    return [
      result.contractVersion,
      result.overallScore,
      result.dimensions
        .map((dimension) => {
          if (
            !dimension ||
            typeof dimension !== "object"
          ) {
            return "";
          }

          return [
            dimension.id ||
              dimension.dimensionId ||
              dimension.name ||
              dimension.label ||
              dimension.title ||
              "",
            dimension.score !== undefined
              ? dimension.score
              : dimension.value !== undefined
                ? dimension.value
                : dimension.overallScore
          ].join(":");
        })
        .join("|")
    ].join("::");
  }

  /* =========================================================
     SCORE DISPLAY
     ========================================================= */

  function formatScore(score) {
    if (score === null) {
      return "—";
    }

    if (Number.isInteger(score)) {
      return String(score);
    }

    return String(
      Math.round(score * 10) / 10
    );
  }

  /* =========================================================
     ACCESSIBILITY UPDATE
     ========================================================= */

  function updateAccessibility(
    orb,
    dimensionName,
    score
  ) {
    if (score === null) {
      orb.setAttribute(
        "aria-label",
        dimensionName +
          " score unavailable"
      );
      return;
    }

    orb.setAttribute(
      "aria-label",
      dimensionName +
        " score " +
        formatScore(score) +
        " out of 100"
    );
  }

  /* =========================================================
     RENDER
     ========================================================= */

  function render() {
    const result =
      readAuthoritativeResult();

    const nextSignature =
      getSignature(result);

    if (
      nextSignature === lastSignature
    ) {
      return !!result;
    }

    lastSignature = nextSignature;

    dimensionNodes.forEach(
      (dimensionNode, index) => {
        const dimensionName =
          DIMENSIONS[index];

        const scoreNode =
          dimensionNode.querySelector(
            ".e02-score"
          );

        const orbNode =
          dimensionNode.querySelector(
            ".e02-orb"
          );

        if (!scoreNode || !orbNode) {
          return;
        }

        const score =
          readDimensionScore(
            result,
            dimensionName,
            index
          );

        scoreNode.textContent =
          formatScore(score);

        scoreNode.dataset.score =
          score === null
            ? ""
            : String(score);

        scoreNode.dataset.demo =
          "false";

        updateAccessibility(
          orbNode,
          dimensionName,
          score
        );
      }
    );

    return !!result;
  }

  /* =========================================================
     EVENT / HYDRATION SUPPORT
     ========================================================= */

  function refresh() {
    render();
  }

  render();

  window.addEventListener(
    "maxess:result-updated",
    refresh
  );

  window.addEventListener(
    "MAXESS_RESULT_READY",
    refresh
  );

  window.addEventListener(
    "pageshow",
    refresh
  );

  /*
    The assessment may establish MAXESS_RESULT after the
    section is inserted. Poll briefly for that authoritative
    object, then stop. The section never invents fallback data.
  */

  let attempts = 0;

  const hydrationPoll =
    window.setInterval(() => {
      attempts += 1;

      const hasResult = render();

      if (
        hasResult ||
        attempts >= 120
      ) {
        window.clearInterval(
          hydrationPoll
        );
      }
    }, 250);
})();
</script>

