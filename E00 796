const Q=[['q01','direction','DIRECTION','When you ask AI to create something important, how clearly do you define the destination?',['Extremely clearly','I define the destination precisely.'],['Very clearly','I usually know what great looks like.'],['Fairly clearly','I give AI a clear direction, then refine it.'],['Somewhat clearly','I have the destination, but it evolves.'],['I figure it out as I go','The first result often helps me discover what I want.']],['q02','direction','DIRECTION','How clearly do you communicate what you want AI to understand, create, or change?',['Extremely clearly','I communicate the outcome, context, constraints, and important details.'],['Very clearly','AI usually understands exactly what I mean.'],['Fairly clearly','I communicate the main idea and refine details later.'],['Somewhat clearly','Sometimes AI understands me, sometimes I need to clarify.'],['I explain it as I go','I discover what I mean through the conversation.']],['q03','direction','DIRECTION','How consistently do you give AI the context it needs before asking it to solve an important problem?',['Almost always','I make sure AI understands the situation first.'],['Very often','I provide context whenever the task matters.'],['Often','I usually give useful background information.'],['Sometimes','I add context when AI gets confused.'],['Rarely','I usually get straight to the request.']],['q04','communication','COMMUNICATION','How effectively do you explain your intended audience, purpose, and desired outcome to AI?',['Extremely effectively','Audience and purpose are always part of my direction.'],['Very effectively','I usually make the audience clear.'],['Fairly effectively','I explain it when it is important.'],['Sometimes','I think about the audience after the first result.'],['Rarely','I mostly let AI decide how to present it.']],['q05','communication','COMMUNICATION','How consistently do you give AI the background information that changes how a problem should be solved?',['Almost always','I make sure AI has the relevant situation first.'],['Very often','I provide important background whenever it matters.'],['Often','I usually provide useful background.'],['Sometimes','I add background when the first answer misses context.'],['Rarely','I usually start with the immediate request.']],['q06','communication','COMMUNICATION','How well do you recognize which details are important enough for AI to know before it begins?',['Extremely well','I quickly identify the details that materially affect the outcome.'],['Very well','I usually know what context matters most.'],['Fairly well','I identify the major details and refine later.'],['Somewhat well','I often discover important context during the conversation.'],['Not very well yet','I tend to provide details only when they become necessary.']],['q07','systemsThinking','SYSTEMS THINKING','How effectively do you correct AI when it misunderstands what you want?',['Extremely effectively','I diagnose the misunderstanding and redirect precisely.'],['Very effectively','I usually correct AI quickly.'],['Fairly effectively','I can usually get things back on track.'],['Sometimes','I often need several attempts.'],['Not very effectively','I often abandon the direction and start again.']],['q08','systemsThinking','SYSTEMS THINKING','How effectively do you use feedback from one AI result to produce a better next result?',['Extremely effectively','Every revision gives AI specific information about what to improve.'],['Very effectively','I usually give useful feedback and get better results.'],['Fairly effectively','I make useful corrections as I go.'],['Sometimes','My feedback is often fairly general.'],['Not very effectively','I often start over instead of diagnosing the issue.']],['q09','systemsThinking','SYSTEMS THINKING','When AI gives you a result that is close but not quite right, how do you normally work with it?',['Diagnose and improve it','I identify what is missing and direct the next version.'],['Refine it','I give feedback and continue improving the result.'],['Try another version','I ask AI to make another attempt.'],['Make a few changes','I fix obvious issues and move forward.'],['Usually accept it','I normally use the first useful result.']],['q10','evaluation','EVALUATION','When AI gives you an answer, how deliberately do you judge whether it is actually good enough?',['Very deliberately','I use clear standards and actively look for weaknesses.'],['Usually deliberately','I regularly inspect quality before accepting the result.'],['Sometimes','I evaluate important outputs but not everything.'],['Occasionally','I usually know when something feels wrong.'],['Rarely','If the answer looks useful, I usually move on.']],['q11','evaluation','EVALUATION','How consistently do you verify important AI-generated information before relying on it?',['Almost always','I verify important claims before relying on them.'],['Very often','I verify information when accuracy matters.'],['Often','I check important information most of the time.'],['Sometimes','I verify things when something feels questionable.'],['Rarely','I generally trust useful-looking answers.']],['q12','evaluation','EVALUATION','How often do you deliberately look for what could be wrong with an AI-generated result?',['Almost always','I actively challenge important outputs.'],['Very often','I deliberately look for weaknesses.'],['Often','I check important results for obvious problems.'],['Sometimes','I inspect results when something feels off.'],['Rarely','I usually focus on what is useful.']],['q13','iteration','ITERATION','When the first AI result is not a 10, what do you normally do?',['Diagnose and improve it','I identify exactly why it is not a 10 and direct AI to improve it.'],['Refine it','I give feedback and continue improving the result.'],['Try another version','I ask AI to make another attempt.'],['Make a few changes','I fix obvious issues and move forward.'],['Usually accept it','I normally use the first useful result.']],['q14','iteration','ITERATION','How intentionally do you preserve what is already working while improving what is not?',['Extremely intentionally','I protect what works while targeting specific weaknesses.'],['Very intentionally','I usually preserve strong elements during revisions.'],['Fairly intentionally','I try not to lose good parts.'],['Sometimes','Improvement sometimes changes more than necessary.'],['Rarely','I often replace the whole thing when revising.']],['q15','iteration','ITERATION','How effectively do you turn individual AI successes into a larger repeatable capability?',['Extremely effectively','I turn successful experiments into durable capability.'],['Very effectively','I regularly capture and reuse what works.'],['Fairly effectively','I reuse some successful approaches.'],['Sometimes','I remember useful methods but do not formalize them.'],['Rarely','Most successes stay as one-off experiences.']]];
const state={i:0,selected:null,responses:[],first:true,finalizing:false,mode:'ASSESSMENT',result:null};
const MAXESS_ROOT=document.currentScript?.closest('#maxess-ai-score')||document.getElementById('maxess-ai-score');
if(!MAXESS_ROOT)throw Error('MAXESS root not found');
const $=id=>MAXESS_ROOT.querySelector('#'+CSS.escape(id));const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));const band=s=>s<50?'foundation':s<75?'developing':s<90?'advancing':'mastery';
function validate(){if(Q.length!==15||D.length!==5)throw Error('MAXESS structure invalid');if(!S||typeof S!=='object'||Array.isArray(S)||Object.keys(S).length!==15)throw Error('Score matrix structure invalid');Object.keys(S).forEach(k=>{if(!/^([1-9]|1[0-5])$/.test(k)||!Array.isArray(S[k])||S[k].length!==5)throw Error('Score matrix row invalid');});Q.forEach((q,i)=>{if(q[0]!=='q'+String(i+1).padStart(2,'0')||q[4]===undefined||q.length!==9)throw Error('Question structure invalid');if(q.slice(4).length!==5)throw Error('Five answers required');if(!Array.isArray(S[i+1])||S[i+1].length!==5)throw Error('Score map invalid');});D.forEach(d=>{if(Q.filter(q=>q[1]===d[0]).length!==3)throw Error('Dimension structure invalid');});}
function hideResultsSections(){const selectors=['#e01','#e02','#e03','#e04','#e05','#e06','#e07','#e08','#e09'];const roots=[document];try{if(window.parent&&window.parent!==window)roots.push(window.parent.document);}catch(e){}roots.forEach(root=>{selectors.forEach(sel=>{try{root.querySelectorAll(sel).forEach(el=>{if(el!==$('maxess-ai-score'))el.setAttribute('data-maxess-hidden','true');if(el!==$('maxess-ai-score'))el.style.setProperty('display','none','important');});}catch(e){}});});}
function releaseResultsSections(result){const selectors=['#e01','#e02','#e03','#e04','#e05','#e06','#e07','#e08','#e09'];const roots=[document];try{if(window.parent&&window.parent!==window)roots.push(window.parent.document);}catch(e){}roots.forEach(root=>{selectors.forEach(sel=>{try{root.querySelectorAll(sel).forEach(el=>{if(el!==$('maxess-ai-score')){el.removeAttribute('data-maxess-hidden');el.style.removeProperty('display');}});}catch(e){}});try{root.dispatchEvent(new CustomEvent('MAXESS_RESULT_READY',{detail:result}));root.dispatchEvent(new CustomEvent('maxess:result-updated',{detail:result}));}catch(e){}});}
function render(){if(state.mode!=='ASSESSMENT')return;const q=Q[state.i],n=state.i+1;$('progressLabel').textContent=`QUESTION ${n} OF 15`;$('progressFill').style.width=(n/15*100)+'%';$('progressPercent').textContent=Math.round(n/15*100)+'%';$('questionLabel').textContent=q[2];$('questionTitle').textContent=q[3];$('answers').innerHTML='';q.slice(4).map((a,i)=>({id:String.fromCharCode(97+i),title:a[0],sub:a[1],score:S[n][i],accent:['#ffd45a','#35e39b','#3ca8ff','#765cff','#ed42c4'][i]})).sort(()=>Math.random()-.5).forEach(a=>{const b=document.createElement('button');b.type='button';b.className='answer';b.dataset.id=a.id;b.style.setProperty('--accent',a.accent);b.setAttribute('aria-pressed','false');b.innerHTML=`<span class="jewel"><span class="glyph">${['◆','✦','△','✧','✦'][a.id.charCodeAt(0)-97]}</span></span>`+`<span class="answer-copy"><span class="answer-title">${esc(a.title)}</span>`+`<span class="answer-sub">${esc(a.sub)}</span></span>`+`<span class="chevron">›</span>`;b.onclick=()=>select(a.id,b);$('answers').appendChild(b);});state.selected=null;updateContinue();}
function select(id,b){if(state.finalizing||state.mode!=='ASSESSMENT')return;state.selected=id;$('answers').querySelectorAll('.answer').forEach(x=>{const yes=x===b;x.classList.toggle('selected',yes);x.setAttribute('aria-pressed',String(yes));});updateContinue();}
function updateContinue(){const disabled=!state.selected||state.finalizing||state.mode!=='ASSESSMENT';$('continueButton').setAttribute('aria-disabled',String(disabled));}
function save(){const q=Q[state.i];const idx=state.selected.charCodeAt(0)-97;if(idx<0||idx>4||!Array.isArray(S[state.i+1])||S[state.i+1].length!==5)throw Error('Invalid answer score mapping');const r={questionId:q[0],questionOrder:state.i+1,dimensionId:q[1],answerId:state.selected,score:S[state.i+1][idx]};const old=state.responses.findIndex(x=>x.questionId===q[0]);old>=0?state.responses[old]=r:state.responses.push(r);}
function calculate(){if(state.responses.length!==15)throw Error('Exactly 15 responses required');if(!Array.isArray(D)||D.length!==5)throw Error('Invalid dimension matrix');const dimensions=D.map(d=>{const rs=state.responses.filter(r=>r.dimensionId===d[0]);if(rs.length!==3)throw Error('Invalid dimension response count');const raw=rs.reduce((a,r)=>a+r.score,0);return{id:d[0],name:d[1],score:Math.round(raw/12*100)};});const raw=state.responses.reduce((a,r)=>a+r.score,0);if(raw<0||raw>60)throw Error('Overall score outside 0-60 matrix');return{overallScore:Math.round(raw/60*100),dimensions};}
function buildResult(){const x=calculate();const sorted=[...x.dimensions].sort((a,b)=>b.score-a.score);return{contractVersion:'MAXESS_RESULT_V1',assessmentId:'ai-mastery',assessmentVersion:'CLEAN-V2',completedAt:new Date().toISOString(),overallScore:x.overallScore,masteryBand:band(x.overallScore),dimensions:x.dimensions.map(d=>({...d,band:band(d.score)})),fiveDimensions:x.dimensions.map(d=>({...d,band:band(d.score)})),dimensionScores:Object.fromEntries(x.dimensions.map(d=>[d.id,d.score])),strongestDimension:{...sorted[0],band:band(sorted[0].score)},opportunityDimension:{...sorted[sorted.length-1],band:band(sorted[sorted.length-1].score)},strongestCapability:sorted[0].name,opportunityCapability:sorted[sorted.length-1].name,responses:state.responses.map(r=>({questionId:r.questionId,dimensionId:r.dimensionId,answerId:r.answerId,score:r.score})),selectedInterests:[],naya:{overallNarrativeId:band(x.overallScore)},audio:{overallReportId:band(x.overallScore),overallReportUrl:null}};}
function valid(c){return !!c&&c.contractVersion==='MAXESS_RESULT_V1'&&Number.isInteger(c.overallScore)&&c.overallScore>=0&&c.overallScore<=100&&Array.isArray(c.dimensions)&&c.dimensions.length===5&&c.dimensions.every(d=>Number.isInteger(d.score)&&d.score>=0&&d.score<=100)&&Array.isArray(c.responses)&&c.responses.length===15&&new Set(c.responses.map(r=>r.questionId)).size===15;}
function encode(c){const bytes=new TextEncoder().encode(JSON.stringify(c));let s='';bytes.forEach(b=>s+=String.fromCharCode(b));return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');}
function broadcast(c){window.MAXESS_RESULT=c;window.MAXESS_RESULT_V1=c;try{sessionStorage.setItem('MAXESS_RESULT_V1',JSON.stringify(c));}catch(e){}try{localStorage.setItem('MAXESS_RESULT_V1',JSON.stringify(c));}catch(e){}['MAXESS_RESULT_READY','maxess:result-updated'].forEach(n=>{try{window.dispatchEvent(new CustomEvent(n,{detail:c}))}catch(e){}try{if(window.parent&&window.parent!==window)window.parent.dispatchEvent(new CustomEvent(n,{detail:c}));}catch(e){}});try{if(window.parent&&window.parent!==window){window.parent.MAXESS_RESULT=c;window.parent.MAXESS_RESULT_V1=c;window.parent.postMessage({type:'MAXESS_RESULT_READY',result:c},'*');}}catch(e){}}
function persistResult(c){try{sessionStorage.setItem('MAXESS_RESULT_V1',JSON.stringify(c));}catch(e){}try{localStorage.setItem('MAXESS_RESULT_V1',JSON.stringify(c));}catch(e){}}
function renderLocalResults(result){if(!valid(result))throw Error('Cannot render invalid MAXESS_RESULT_V1');$('assessmentStage').style.display='none';$('localResults').classList.add('active');$('localOverallScore').textContent=String(result.overallScore);$('localDimensions').innerHTML=result.dimensions.map(d=>`<div class="dimension-card"><strong>${esc(d.score)}</strong><span>${esc(d.name)}</span></div>`).join('');$('localResultsStatus').textContent=`Verified MAXESS_RESULT_V1 · ${result.responses.length} responses · ${result.dimensions.length} dimensions`;state.result=result;state.mode='RESULTS';}
function verifyLocalResults(result){if(!valid(result))throw Error('Result failed final validation');if(result.responses.length!==15)throw Error('Result does not contain exactly 15 responses');if(result.dimensions.length!==5)throw Error('Result does not contain exactly 5 dimensions');if($('localOverallScore').textContent!==String(result.overallScore))throw Error('Local overall score mismatch');result.dimensions.forEach((d,i)=>{const el=$('localDimensions').children[i];if(!el||el.querySelector('strong').textContent!==String(d.score))throw Error('Local dimension score mismatch');});return true;}
function attemptResultsHandoff(result){const encoded=encode(result);if(!encoded)throw Error('MAXESS_RESULT_V1 encoding failed');const resultsUrl='https://results.nayanet.app/#maxess-result='+encoded;window.MAXESS_RESULT_HANDOFF_URL=resultsUrl;try{if(window.top&&window.top!==window)window.top.location.assign(resultsUrl);else window.location.assign(resultsUrl);return true;}catch(e){console.warn('MAXESS external Results navigation unavailable; local Results retained.',e);return false;}}
function publish(){if(state.finalizing)return false;state.finalizing=true;updateContinue();try{if(state.i!==14||!state.selected)throw Error('Q15 terminal save requires the final selected answer');save();if(state.responses.length!==15)throw Error('Exactly 15 responses required');const result=buildResult();if(!valid(result))throw Error('MAXESS_RESULT_V1 validation failed');window.MAXESS_E00_RESULTS_HANDOFF_V1=true;window.MAXESS_RESULT_V1=result;persistResult(result);broadcast(result);state.mode='RESULTS';renderLocalResults(result);verifyLocalResults(result);releaseResultsSections(result);attemptResultsHandoff(result);return true;}catch(e){console.error('MAXESS E00 terminal Results error',e);state.finalizing=false;state.mode='ASSESSMENT';updateContinue();$('localResults').classList.remove('active');$('assessmentStage').style.display='block';$('continueText').textContent='Continue';return false;}}
function next(){
 if(state.finalizing||!state.selected||state.mode!=='ASSESSMENT')return;
 try{
  save();
  if(state.i===14){publish();return;}
  state.i++;
  render();
  setTimeout(()=>openNaya(),120);
 }catch(e){
  console.error('MAXESS Continue execution error',e);
  state.finalizing=false;
  updateContinue();
  $('continueText').textContent='Continue';
 }
}
function openNaya(){if(state.mode!=='ASSESSMENT')return;const q=Q[state.i];$('dialogKicker').textContent=state.first?'MAXESS AI MASTERY ASSESSMENT':`${q[2]} · QUESTION ${state.i+1}`;$('dialogTitle').textContent=state.first?'Welcome to the MAXESS AI Mastery Assessment':"Here's what we're really looking at.";$('dialogBody').innerHTML=state.first?'<p>I’m going to walk you through this assessment.</p><p>It takes about three minutes.</p><p>Answer honestly based on what you actually do today.</p><p>Ready?</p>':`<p>${esc(q[3])}</p>`;$('playNaya').style.display=state.first?'none':'inline-block';$('closeNaya').textContent=state.first?"LET'S GO →":'Got it — let’s go →';$('nayaDialog').classList.add('open');state.first=false;}
function closeNaya(){$('nayaDialog').classList.remove('open');$('nayaButton').focus();}
let maxessContinueExecuting=false;
function executeContinueBoundary(e){
 const target=e.target instanceof Element?e.target:null;
 const btn=target?.closest('#continueButton');
 if(!btn||!MAXESS_ROOT.contains(btn))return;
 if(state.finalizing||state.mode!=='ASSESSMENT'||!state.selected)return;
 if(maxessContinueExecuting)return;
 maxessContinueExecuting=true;
 e.preventDefault();
 e.stopPropagation();
 try{next();}catch(err){
  console.error('MAXESS Continue boundary failure',err);
  state.finalizing=false;
  updateContinue();
  $('continueText').textContent='Continue';
 }finally{
  maxessContinueExecuting=false;
 }
}
document.addEventListener('click',executeContinueBoundary,true);
$('nayaButton').onclick=openNaya;$('closeNaya').onclick=closeNaya;$('playNaya').onclick=()=>{if(state.mode!=='ASSESSMENT')return;const q=Q[state.i];if('speechSynthesis' in window){speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(q[3]);u.rate=.94;u.pitch=1.02;speechSynthesis.speak(u);}$('nayaDialog').classList.remove('open');};
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('nayaDialog').classList.contains('open'))closeNaya();});
try{validate();hideResultsSections();render();setTimeout(openNaya,180);window.MAXESS_E00_RESULTS_HANDOFF_V1=true;window.MAXESS_RESULT_BRIDGE_V2=true;window.MAXESS_RESULT_MODE='ASSESSMENT';}catch(e){console.error(e);$('questionLabel').textContent='ASSESSMENT ERROR';$('questionTitle').textContent='MAXESS is temporarily unavailable.';}
window.MAXESS_AISCORE={questions:Q,dimensions:D,scoreValues:S,buildContract:buildResult,validateContract:valid,publish};
window.MAXESS_E00_DIAGNOSTICS={
 root:MAXESS_ROOT,
 continueButton:$('continueButton'),
 answerCount:()=>MAXESS_ROOT.querySelectorAll('.answer').length,
 state:state,
 testNext:()=>next()
};
