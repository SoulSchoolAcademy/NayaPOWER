{
  "schema": "naya-power-retrieval/v3",
  "status": "CANONICAL",
  "canonical_primary_store": ".naya/memory/smart-notes/",
  "retrieval_runtime": ".naya/memory/smart_notes_v3.py",
  "index": ".naya/memory/smart-notes/REGISTRY.json",
  "organization": "IB identity first; the registry resolves canonical projections; date/category/topic are organizational metadata; event lineage is separate",
  "strategies": [
    {
      "name": "canonical_ib_registry",
      "weight": 100,
      "fields": [
        "intelligent_block_id",
        "topic",
        "category",
        "date",
        "status",
        "canonical_projection_content"
      ]
    },
    {
      "name": "exact",
      "weight": 100,
      "fields": [
        "event_id",
        "title",
        "subject",
        "tags",
        "aliases"
      ]
    },
    {
      "name": "lexical",
      "weight": 60,
      "fields": [
        "title",
        "subject",
        "summary",
        "representations",
        "tags",
        "aliases",
        "concepts"
      ]
    },
    {
      "name": "semantic_tfidf",
      "weight": 50,
      "fields": [
        "content",
        "summary",
        "representations",
        "concepts",
        "aliases"
      ]
    },
    {
      "name": "relationship",
      "weight": 45,
      "fields": [
        "relationships.related",
        "relationships.depends_on",
        "relationships.supersedes",
        "relationships.superseded_by",
        "relationships.source_events"
      ]
    },
    {
      "name": "temporal",
      "weight": 40,
      "fields": [
        "event_at",
        "created_at",
        "effective_at",
        "observed_at",
        "effective_from",
        "effective_to"
      ]
    },
    {
      "name": "authority",
      "weight": 80,
      "fields": [
        "status",
        "authority",
        "source",
        "confidence",
        "verification",
        "evidence"
      ]
    },
    {
      "name": "scope_permission",
      "weight": 90,
      "fields": [
        "scope",
        "project",
        "permissions"
      ]
    }
  ],
  "ranking": {
    "current_active_bonus": 30,
    "canonical_bonus": 25,
    "superseded_penalty": -60,
    "stale_penalty": -40,
    "conflicted_penalty": -20,
    "exact_phrase_bonus": 80,
    "relationship_bonus": 35
  },
  "restore_rules": [
    "Restore current operational truth from .naya/control-plane before historical memory.",
    "Resolve authorized scope and permissions before delivering retrieved intelligence.",
    "Prefer the canonical IB from the registry when canonical intelligence exists; use event lineage only to establish provenance and lifecycle.",
    "Use legacy archive only for historical reconciliation, migration, or provenance.",
    "Never create a new legacy root note format.",
    "Never treat a repository projection as proof that the live receiver persisted or learned an object.",
    "Never treat retrieval as learning; learning requires verified reuse/outcome.",
    "Expose conflicts and supersession instead of silently choosing a convenient source."
  ],
  "promotion_boundary": {
    "runtime": ".naya/runtime/promotion_runtime.py",
    "levels": [
      "UNVERIFIED",
      "BUILDER_VERIFIED",
      "OSCAR_ACCEPTED",
      "CANONICAL_VERIFIED",
      "PRODUCTION_SAFE"
    ],
    "rule": "CLAIM + QUALIFYING EVIDENCE + BUILDER VERIFICATION + INDEPENDENT OSCAR ACCEPTANCE + CURRENT COMMIT = ELIGIBLE FOR PROMOTION",
    "canonical_requires_explicit_decision": true,
    "production_safe_requires_production_evidence": true,
    "oscar_provenance_required": true,
    "oscar_input_fingerprints_required": true,
    "oscar_implementation_provenance_required": true,
    "oscar_result_integrity_digest_required": true,
    "oscar_active_ci_run_binding_required": true
  },
  "temporal_policy": {
    "timezone_required": true,
    "precision": "second",
    "history_is_append_only": true,
    "backdating_requires_source": true,
    "future_effective_dates_allowed": true
  },
  "boundary_policy": {
    "scope_resolution_before_retrieval": true,
    "permission_filter_before_context_delivery": true,
    "default_cross_scope": "DENY_UNLESS_AUTHORIZED",
    "canonical_identity_required": true,
    "legacy_archive_read_only": true
  },
  "canonical_intelligence_object": ".naya/memory/smart-notes/YYYY/MM/DD/category/topic/IB-XXXXXX/smart-note.md",
  "canonical_registry": ".naya/memory/smart-notes/REGISTRY.json",
  "identity_authority": "live canonical receiver v7-smart-note-canonical",
  "event_lineage_store": ".naya/memory/events/",
  "canonical_projection_root": ".naya/memory/smart-notes/YYYY/MM/DD/category/topic/IB-XXXXXX/smart-note.md",
  "lineage_index": ".naya/memory/events/INDEX.json",
  "canonical_retrieval_entrypoint": "smart_notes_v3.retrieve_canonical_ibs(query, limit, root)"
}
