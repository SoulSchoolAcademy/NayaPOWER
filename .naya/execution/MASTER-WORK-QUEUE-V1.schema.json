{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya/master-work-queue/v1",
  "title": "MASTER_WORK_QUEUE_V1",
  "description": "One durable, priority-aware work queue for Naya Power continuous execution. Subordinate to the constitution, control plane, and governance kernel. Feeds .naya/runtime/priority_decision.py. Does not define a competing state machine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "status", "authority", "quality_policy", "tasks"],
  "properties": {
    "$schema": { "const": "naya/master-work-queue/v1" },
    "status": { "enum": ["CANONICAL"] },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subordinate_to", "selector", "record_layer"],
      "properties": {
        "subordinate_to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "selector": { "type": "string" },
        "record_layer": { "type": "string" }
      }
    },
    "quality_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_score", "target_score", "objective_score", "regression_law"],
      "properties": {
        "minimum_score": { "type": "number", "minimum": 9.0 },
        "target_score": { "type": "number", "minimum": 9.0 },
        "objective_score": { "type": "number", "minimum": 9.0 },
        "regression_law": { "type": "string", "minLength": 1 }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "mission", "objective", "current_state", "why_it_matters",
        "dependencies", "authority", "constraints", "protected_boundaries",
        "acceptance_criteria", "test_requirements", "evidence_requirements",
        "quality_scorecard", "minimum_score", "target_score", "risk",
        "rollback_repair", "next_action", "successor_action", "autonomy_level",
        "status", "selector"
      ],
      "properties": {
        "task_id": { "type": "string", "pattern": "^TASK-[A-Z0-9-]+$" },
        "mission": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "current_state": { "type": "string", "minLength": 1 },
        "why_it_matters": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[A-Z0-9-]+$" } },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "scope"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "constraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "protected_boundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "test_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "quality_scorecard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimensions"],
          "properties": {
            "dimensions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "minimum_score": { "type": "number", "minimum": 9.0 },
        "target_score": { "type": "number", "minimum": 9.0 },
        "risk": { "type": "string", "pattern": "^R[0-5]$" },
        "rollback_repair": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 },
        "successor_action": { "type": "string", "minLength": 1 },
        "autonomy_level": { "type": "integer", "minimum": 1, "maximum": 8 },
        "status": { "enum": ["PROPOSED", "READY", "IN_PROGRESS", "COMPLETE", "BLOCKED", "DEFERRED", "FAILED", "CANCELLED"] },
        "blocked_reason": { "type": "string" },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mission_alignment", "expected_value", "urgency", "dependency_impact", "reversibility", "risk", "executable", "blocked"],
          "properties": {
            "mission_alignment": { "type": "number", "minimum": 0, "maximum": 1 },
            "expected_value": { "type": "number", "minimum": 0, "maximum": 1 },
            "urgency": { "type": "number", "minimum": 0, "maximum": 1 },
            "dependency_impact": { "type": "number", "minimum": 0, "maximum": 1 },
            "reversibility": { "type": "number", "minimum": 0, "maximum": 1 },
            "risk": { "type": "number", "minimum": 0, "maximum": 1 },
            "executable": { "type": "boolean" },
            "blocked": { "type": "boolean" }
          }
        }
      }
    }
  }
}
