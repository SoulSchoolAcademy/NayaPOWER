{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nayanet.local/schemas/NAYA-CONTRIBUTION-VALUE-V2.1.schema.json",
  "title": "NayaNET Contribution Value Receipt V2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_type",
    "schema_version",
    "engine_version",
    "contribution_id",
    "action_class",
    "provenance",
    "privacy",
    "raw_activity",
    "factors",
    "verified_delta",
    "cvs",
    "scoring_profile",
    "points_awarded",
    "explanation",
    "evidence_refs",
    "verification"
  ],
  "properties": {
    "receipt_type": { "const": "CONTRIBUTION_VALUE" },
    "schema_version": { "const": "2.1" },
    "engine_version": { "const": "DECISION-VALUE-CALCULUS-V2.1" },
    "contribution_id": { "type": "string", "minLength": 1 },
    "action_class": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object" },
    "privacy": {
      "type": "object",
      "required": ["classification"],
      "properties": {
        "classification": { "enum": ["PRIVATE", "SHARED", "COLLECTIVE", "PUBLIC"] },
        "consent_state": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "raw_activity": { "type": "object" },
    "factors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality", "relevance", "verification_strength", "impact", "novelty"],
      "properties": {
        "quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
        "verification_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "impact": { "type": "number", "minimum": 0, "maximum": 1 },
        "novelty": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "verified_delta": { "type": ["number", "null"] },
    "cvs": { "type": "number", "minimum": -9, "maximum": 9 },
    "scoring_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "points_per_unit", "repeat_decay"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "points_per_unit": { "type": "number", "minimum": 0 },
        "repeat_decay": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "points_awarded": { "type": "number", "minimum": 0 },
    "explanation": { "type": "string" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verification": {
      "enum": ["UNVERIFIED", "OBSERVED", "VERIFIED", "FAIL", "ESCALATE"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verification": { "const": "VERIFIED" } },
        "required": ["verification"]
      },
      "then": {
        "properties": { "verified_delta": { "type": "number" } }
      }
    },
    {
      "if": {
        "properties": {
          "verification": { "enum": ["UNVERIFIED", "OBSERVED", "FAIL", "ESCALATE"] }
        },
        "required": ["verification"]
      },
      "then": {
        "properties": { "points_awarded": { "const": 0 } }
      }
    }
  ]
}
