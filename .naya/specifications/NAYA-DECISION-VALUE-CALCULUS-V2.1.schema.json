{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nayanet.local/schemas/NAYA-DECISION-VALUE-CALCULUS-V2.1.schema.json",
  "title": "NayaPOWER Decision Value Calculus V2.1 Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_type",
    "schema_version",
    "engine_version",
    "decision_id",
    "objective",
    "baseline_id",
    "stakeholders",
    "horizon",
    "evaluation",
    "authority_basis",
    "evidence_refs",
    "observation_window",
    "verification",
    "delta_v_predicted",
    "delta_v_actual",
    "d_verified",
    "calibration_error"
  ],
  "properties": {
    "receipt_type": {
      "const": "ALIGNMENT_DECISION"
    },
    "schema_version": {
      "const": "2.1"
    },
    "engine_version": {
      "const": "DECISION-VALUE-CALCULUS-V2.1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "horizon": {
      "type": "string",
      "minLength": 1
    },
    "evaluation": {
      "type": "object",
      "required": [
        "decision",
        "selected",
        "top3",
        "rows",
        "frontier"
      ],
      "properties": {
        "decision": {
          "enum": [
            "ACT",
            "READ_MORE",
            "ASK",
            "REFUSE"
          ]
        },
        "selected": {
          "type": [
            "string",
            "null"
          ]
        },
        "relative_margin": {
          "type": [
            "number",
            "null"
          ]
        },
        "top3": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/evaluationRow"
          }
        },
        "frontier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evaluationRow"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evaluationRow"
          }
        },
        "interval_gap": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "authority_basis": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observation_window": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "starts_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ends_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "enum": [
        "UNVERIFIED",
        "PASS_PENDING_WINDOW",
        "VERIFIED_PASS",
        "FAIL",
        "ESCALATE"
      ]
    },
    "delta_v_predicted": {
      "type": [
        "number",
        "null"
      ]
    },
    "delta_v_actual": {
      "type": [
        "number",
        "null"
      ]
    },
    "d_verified": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -9,
      "maximum": 9,
      "description": "Verified display value on the -9..+9 ladder. Reconciled 2026-10-11: canonical spec (NAYANODE/0025, section 4) defines D_verified = clamp(Normalize(dV_actual), -9, +9); prior +/-10 schema bound was a discrepancy. Raw delta remains preserved in delta_v_actual."
    },
    "value_interpretation": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "TRUE_ZERO",
        "PRACTICALLY_NEUTRAL",
        "UNKNOWN",
        "UNMEASURED",
        "DELAYED",
        "INCONCLUSIVE",
        null
      ],
      "description": "Zero Value Law (additive, 2026-10-11): orthogonal classification of what a zero/null value MEANS. TRUE_ZERO = exact zero established by adequate evidence for the defined calculation and scope. PRACTICALLY_NEUTRAL = measured effect within a justified tolerance epsilon with adequate observation coverage. UNKNOWN = outcome cannot currently be determined. UNMEASURED = required measurement not performed. DELAYED = consequences not yet observed; assessment provisional until window closes. INCONCLUSIVE = uncertainty interval permits positive, neutral, or negative effects. The last four are NEVER evidence of zero value."
    },
    "calibration_error": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "allOf": [
    {
      "description": "ZERO VALUE LAW 1: UNVERIFIED receipts must not carry a numeric verified ladder value. d_verified is a VERIFIED display value; without verification it must be null, never 0.",
      "if": {
        "properties": {
          "verification": {
            "const": "UNVERIFIED"
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "properties": {
          "d_verified": {
            "type": "null"
          }
        }
      }
    },
    {
      "description": "ZERO VALUE LAW 2: null actual means no established result. A numeric d_verified with null delta_v_actual is a false zero and is invalid.",
      "if": {
        "properties": {
          "delta_v_actual": {
            "type": "null"
          }
        },
        "required": [
          "delta_v_actual"
        ]
      },
      "then": {
        "properties": {
          "d_verified": {
            "type": "null"
          }
        }
      }
    },
    {
      "description": "ZERO VALUE LAW 3: an open observation window means affected outcomes are provisional. A numeric d_verified while the window is OPEN contradicts provisionality.",
      "if": {
        "properties": {
          "observation_window": {
            "properties": {
              "status": {
                "const": "OPEN"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "observation_window"
        ]
      },
      "then": {
        "properties": {
          "d_verified": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "evaluationRow": {
      "type": "object",
      "required": [
        "candidate_id",
        "gate",
        "gate_reasons",
        "q",
        "pv",
        "delta_v",
        "v_safe",
        "residual_risk",
        "effective_stakes",
        "reversible",
        "dependency_unlock",
        "human_burden",
        "is_baseline",
        "v_low",
        "v_high",
        "interval_width"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "enum": [
            "PROHIBITED",
            "NEEDS_AUTHORITY",
            "NEEDS_EVIDENCE",
            "ADMISSIBLE"
          ]
        },
        "gate_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "q": {
          "type": "object",
          "required": [
            "Q",
            "confidence_aggregate",
            "confidence_critical",
            "critical_confidences",
            "dimensions",
            "confidences",
            "missing_dimensions",
            "weights"
          ],
          "properties": {
            "Q": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "confidence_aggregate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence_critical": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "critical_confidences": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "dimensions": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            },
            "confidences": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "missing_dimensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "weights": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "additionalProperties": false
        },
        "pv": {
          "type": "number"
        },
        "delta_v": {
          "type": "number"
        },
        "v_safe": {
          "type": "number"
        },
        "residual_risk": {
          "type": "number",
          "minimum": 0
        },
        "effective_stakes": {
          "enum": [
            "low",
            "high",
            "consequential"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "dependency_unlock": {
          "type": "number"
        },
        "human_burden": {
          "type": "number",
          "minimum": 0
        },
        "is_baseline": {
          "type": "boolean"
        },
        "v_low": {
          "type": "number"
        },
        "v_high": {
          "type": "number"
        },
        "interval_width": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
