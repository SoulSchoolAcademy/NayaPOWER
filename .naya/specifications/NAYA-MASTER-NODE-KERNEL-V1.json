  "global_invariants": {
    "must": [
      "Every consequential execution resolves identity, authority, scope, evidence requirements, and applicable intelligence before action.",
      "Every contract 00-26 has exactly one primary Master Node owner.",
      "Node-to-node transfer preserves relevant provenance, epistemic state, scope, and authority context.",
      "Meaningful execution completion preserves successor context where reasonably preservable.",
      "Completion claims require evidence at the declared claim strength."
    ],
    "must_not": [
      "A Master Node must not self-authorize an action.",
      "A Master Node must not self-ratify a constitutional change or consequential release.",
      "A Master Node must not create a competing canonical intelligence store.",
      "A Master Node must not locally allocate canonical Intelligent Block identity.",
      "A Master Node must not upgrade UNKNOWN/IMPLEMENTED/TESTED to VERIFIED without required evidence.",
      "A Master Node must not silently override higher authority."
    ]
  },
