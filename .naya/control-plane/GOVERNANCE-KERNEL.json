{
  "$schema": "naya/governance-kernel/v1",
  "status": "CANONICAL",
  "version": "1.0.1",
  "kernel_id": "NAYAPOWER-GOVERNANCE-KERNEL-V1",
  "purpose": "Provide one deterministic constitutional control plane for consequential decisions before execution.",
  "constitutional_authority": ".naya/codex/11-RUNTIME-CONSTITUTION.md",
  "constitutional_authority_status": "CURRENT_REPOSITORY_CONSTITUTION",
  "future_authority_note": "The planned NayaPOWER Ultimate Governance Act is not yet a current repository artifact and therefore cannot be named as present authority. When formally adopted, its promotion must be governed and recorded as a constitutional amendment.",
  "fail_closed": true,
  "mandatory_gates": [
    "identity",
    "authority",
    "protected_boundaries",
    "risk",
    "decision_contract",
    "governance_state",
    "verification_plan",
    "stop_conditions",
    "receipt_requirements"
  ],
  "required_decision_fields": [
    "mission",
    "actor",
    "request",
    "purpose",
    "authority",
    "scope",
    "boundaries",
    "evidence",
    "uncertainty",
    "consequence",
    "reversibility",
    "risk",
    "alternatives",
    "value",
    "required_permission",
    "decision",
    "execution_plan",
    "verification_plan",
    "stop_conditions",
    "receipt_requirements",
    "learning_output"
  ],
  "risk_model": {
    "dimensions": ["uncertainty", "consequence", "irreversibility"],
    "formula": "uncertainty * consequence * irreversibility",
    "implementation_mapping": "The decision field `reversibility` is currently interpreted as the numeric irreversibility factor for backward compatibility with the executable governance adapter. Future schema promotion must rename this field only through a governed migration.",
    "tiers": {
      "R0": {"max_score": 1, "governance": "autonomous"},
      "R1": {"max_score": 8, "governance": "lightweight_verification"},
      "R2": {"max_score": 27, "governance": "decision_contract"},
      "R3": {"max_score": 64, "governance": "explicit_authority_and_strong_evidence"},
      "R4": {"max_score": 125, "governance": "human_approval_and_independent_verification"},
      "R5": {"max_score": null, "governance": "refuse"}
    }
  },
  "governance_states": [
    "PROPOSED",
    "INVESTIGATING",
    "READY_FOR_DECISION",
    "AUTHORIZED",
    "EXECUTING",
    "EXECUTED",
    "OBSERVED",
    "VERIFIED",
    "ASK",
    "DEFERRED",
    "REFUSED",
    "STOPPED",
    "FAILED",
    "REQUIRES_REPAIR"
  ],
  "terminal_non_success_states": ["ASK", "DEFERRED", "REFUSED", "STOPPED", "FAILED", "REQUIRES_REPAIR"],
  "legal_transitions": {
    "PROPOSED": ["INVESTIGATING", "ASK", "DEFERRED", "REFUSED", "STOPPED"],
    "INVESTIGATING": ["READY_FOR_DECISION", "ASK", "DEFERRED", "REFUSED", "STOPPED", "FAILED"],
    "READY_FOR_DECISION": ["AUTHORIZED", "ASK", "DEFERRED", "REFUSED", "STOPPED"],
    "AUTHORIZED": ["EXECUTING", "STOPPED", "REQUIRES_REPAIR"],
    "EXECUTING": ["EXECUTED", "FAILED", "STOPPED", "REQUIRES_REPAIR"],
    "EXECUTED": ["OBSERVED", "FAILED", "STOPPED", "REQUIRES_REPAIR"],
    "OBSERVED": ["VERIFIED", "FAILED", "REQUIRES_REPAIR"],
    "VERIFIED": [],
    "ASK": [],
    "DEFERRED": ["INVESTIGATING", "READY_FOR_DECISION"],
    "REFUSED": [],
    "STOPPED": ["INVESTIGATING", "READY_FOR_DECISION"],
    "FAILED": ["INVESTIGATING", "REQUIRES_REPAIR"],
    "REQUIRES_REPAIR": ["INVESTIGATING", "STOPPED", "DEFERRED"]
  },
  "verification_chain": ["INTENDED", "AUTHORIZED", "EXECUTED", "OBSERVED", "VERIFIED"],
  "receipt_minimum": [
    "receipt_id",
    "decision_id",
    "actor",
    "authority_id",
    "request",
    "decision",
    "state",
    "result",
    "observation",
    "verification",
    "timestamp",
    "uncertainty",
    "failure",
    "repair",
    "next_action",
    "integrity_hash"
  ]
}
