{
  "$schema": "naya/github-optimization-gate/v1",
  "name": "NayaPOWER GitHub Optimization Gate",
  "purpose": "Make GitHub a clean, coherent, machine-checkable operating environment rather than a pile of competing instructions.",
  "authority": {
    "repository": "SoulSchoolAcademy/NayaPOWER",
    "branch": "main",
    "state": ".naya/control-plane/STATE.json",
    "block": ".naya/control-plane/BLOCKS.json",
    "map": ".naya/control-plane/MAP.json",
    "proof": ".naya/control-plane/PROOF.json"
  },
  "required_questions": [
    "WHAT_ARE_WE_BUILDING",
    "WHY",
    "WHAT_IS_AUTHORITATIVE",
    "WHAT_IS_CURRENT",
    "WHAT_IS_PROTECTED",
    "WHAT_IS_ACTUALLY_VERIFIED",
    "WHAT_IS_BROKEN",
    "WHAT_IS_OBSOLETE",
    "SINGLE_HIGHEST_VALUE_NEXT_ACTION",
    "HOW_IS_IT_PROVEN",
    "WHERE_IS_IT_RECORDED",
    "WHAT_DOES_NEXT_NAYA_DO"
  ],
  "invariants": {
    "one_canonical_state": true,
    "one_canonical_machine_event_store": true,
    "one_human_activity_projection": true,
    "one_highest_value_next_action": true,
    "unknown_is_not_verified": true,
    "blocked_is_not_pass": true,
    "historical_is_not_current": true,
    "builder_is_not_judge": true,
    "no_unclassified_open_issue": true,
    "no_unclassified_workflow_authority": true,
    "no_unresolved_runtime_authority_conflict": true
  },
  "audit_inputs": {
    "issue_inventory": ".naya/control-plane/GITHUB-ISSUE-AUDIT.json",
    "workflow_inventory": ".naya/control-plane/GITHUB-WORKFLOW-AUDIT.json",
    "authority_inventory": ".naya/control-plane/GITHUB-AUTHORITY-AUDIT.json"
  },
  "status_values": [
    "CANONICAL",
    "ACTIVE_DEPENDENCY",
    "PRODUCT_ASSET",
    "HISTORICAL_INTELLIGENCE",
    "REFERENCE",
    "DUPLICATE",
    "SUPERSEDED",
    "ORPHAN",
    "UNKNOWN",
    "BLOCKED"
  ],
  "failure_policy": "The gate fails closed. A passing gate means the repository structure is internally classifiable; it does not by itself prove a live runtime is correct.",
  "next_action": "Classify every open GitHub issue and every workflow/deployment authority, resolve duplicate or superseded authority, then rerun this gate until GREEN."
}
