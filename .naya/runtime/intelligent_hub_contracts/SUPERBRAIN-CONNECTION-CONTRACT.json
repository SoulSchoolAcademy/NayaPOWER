{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya://intelligent-hub/superbrain-connection/1.0",
  "title": "Superbrain Connection Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "connection_id", "participant", "provider", "resource", "capabilities", "consent", "status"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "connection_id": {"type": "string", "pattern": "^conn_[A-Za-z0-9_-]+$"},
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "identity_exposure"],
      "properties": {
        "subject_ref": {"type": "string", "description": "Non-public installation/participant reference."},
        "identity_exposure": {"const": "none"}
      }
    },
    "provider": {"type": "string", "minLength": 1},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation_ref", "resource_ref"],
      "properties": {
        "installation_ref": {"type": "string"},
        "resource_ref": {"type": "string"}
      }
    },
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection", "wisdom_contribution"],
      "properties": {
        "connection": {"enum": ["granted", "revoked"]},
        "wisdom_contribution": {"enum": ["granted", "revoked"]}
      }
    },
    "status": {"enum": ["PENDING", "CONNECTED", "DEGRADED", "REVOKED", "UNKNOWN"]}
  }
}
