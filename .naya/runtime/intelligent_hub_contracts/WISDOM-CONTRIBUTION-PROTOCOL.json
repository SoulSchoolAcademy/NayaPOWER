{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya://intelligent-hub/wisdom-contribution/1.0",
  "title": "Wisdom Contribution Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "contribution_id", "connection_id", "consent", "human_approved", "wisdom", "why_it_matters", "applicability", "evidence", "confidence"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "contribution_id": {"type": "string"},
    "connection_id": {"type": "string"},
    "consent": {"const": "wisdom_contribution"},
    "human_approved": {"const": true},
    "wisdom": {"type": "string", "minLength": 1},
    "why_it_matters": {"type": "string", "minLength": 1},
    "applicability": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "subject": {"type": "string", "description": "Generalized topic only; must not identify the participant."}
  },
  "not": {
    "anyOf": [
      {"required": ["raw_source"]},
      {"required": ["conversation"]},
      {"required": ["transcript"]},
      {"required": ["private_memory"]},
      {"required": ["repository_contents"]},
      {"required": ["notes"]}
    ]
  }
}
