{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya/action/v1",
  "title": "NAYA_ACTION_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "mission",
    "human_intent",
    "naya_understanding",
    "authority",
    "constraints",
    "plan",
    "actions",
    "observations",
    "evidence",
    "verification",
    "result",
    "lesson",
    "memory",
    "next_action",
    "state"
  ],
  "properties": {
    "schema": {"const": "naya/action/v1"},
    "id": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "human_intent": {"type": "string", "minLength": 1},
    "naya_understanding": {"type": "string", "minLength": 1},
    "authority": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "plan": {"type": "array", "items": {"type": "string"}},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "observations": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "verification": {"type": "object"},
    "result": {"type": "string", "minLength": 1},
    "value_cost_risk": {"type": "object"},
    "failure_repair": {"type": "array", "items": {"type": "object"}},
    "lesson": {"type": "string", "minLength": 1},
    "memory": {"type": "array", "items": {"type": "string"}},
    "related_actions": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "object"},
    "workflow": {"type": "object"},
    "runtime_evidence": {"type": "array", "items": {"type": "object"}},
    "human_confirmation": {"type": ["boolean", "null"]},
    "next_action": {"type": "object"},
    "state": {"type": "string", "enum": ["PROPOSED", "INVESTIGATING", "READY", "AUTHORIZED", "EXECUTING", "EXECUTED", "OBSERVED", "VERIFIED", "COMPLETE", "UNKNOWN"]}
  }
}
