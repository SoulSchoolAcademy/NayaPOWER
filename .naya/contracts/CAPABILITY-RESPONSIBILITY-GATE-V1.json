{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nayanet://schemas/nayapower-capability-responsibility-gate-v1",
  "title": "NayaPOWER Capability Responsibility Gate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "version",
    "principle",
    "capabilities",
    "controls",
    "enforcement"
  ],
  "properties": {
    "contract_id": {
      "const": "NAYAPOWER-CAPABILITY-RESPONSIBILITY-GATE-V1"
    },
    "version": {
      "const": "1.0"
    },
    "principle": {
      "const": "Increasing capability requires nondecreasing responsibility; capability never creates authority."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_control",
        "authority_separation",
        "monotonicity"
      ],
      "properties": {
        "missing_control": {
          "const": "BLOCK"
        },
        "authority_separation": {
          "const": true
        },
        "monotonicity": {
          "const": true
        }
      }
    }
  }
}
