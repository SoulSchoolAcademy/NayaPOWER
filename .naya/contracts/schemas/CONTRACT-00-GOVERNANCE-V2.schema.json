{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya://contracts/schemas/CONTRACT-00-GOVERNANCE-V2",
  "title": "Contract 00 V2 Governance Model",
  "type": "object",
  "required": ["contract_id","version","status","canonical_path","core","precedence","truth_states","decision_procedure","action_classes","enforcement","self_governance","amendment","reachability"],
  "properties": {
    "contract_id": {"const": "CC-000"},
    "version": {"type": "string"},
    "status": {"enum": ["CANDIDATE","RATIFIED","ACTIVE","SUPERSEDED"]},
    "canonical_path": {"const": ".naya/contracts/00-NAYANET-CONSTITUTIONAL-CONTRACT-LAW.md"},
    "core": {"type": "object","required": ["identity","authority","precedence","truth_states","anti_guessing","source_of_truth","conflict","proof","stop_conditions","successor"]},
    "precedence": {"type": "array","minItems": 1,"items":{"type":"string"}},
    "truth_states": {"type":"array","minItems": 1,"items":{"type":"string"}},
    "decision_procedure": {"type":"string"},
    "action_classes": {"type":"array","minItems":4,"items":{"type":"string","pattern":"^L[0-3]$"}},
    "enforcement": {"type":"string"},
    "self_governance": {"type":"string"},
    "amendment": {"type":"string"},
    "reachability": {"type":"string"}
  },
  "additionalProperties": false
}