{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya/intelligence-evaluation-receipt/v1",
  "title": "Naya Intelligence Evaluation Receipt",
  "type": "object",
  "required": [
    "schema", "test_id", "fixture_id", "source_commit", "runtime_version",
    "input_hash", "execution_path", "state_before", "state_after",
    "evidence_ids", "authority_decision", "expected", "actual",
    "reproduction", "evidence_level", "evaluator_integrity"
  ],
  "properties": {
    "schema": {"const": "naya/intelligence-evaluation-receipt/v1"},
    "test_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "minLength": 1},
    "runtime_version": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "minLength": 1},
    "execution_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "state_before": {"type": "object"},
    "state_after": {"type": "object"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authority_decision": {"type": "string"},
    "expected": {"type": "object"},
    "actual": {"type": "object"},
    "failures": {"type": "array"},
    "uncertainties": {"type": "array"},
    "reproduction": {
      "type": "object",
      "required": ["command", "result"],
      "properties": {"command": {"type": "string", "minLength": 1}, "result": {"type": "string"}}
    },
    "evidence_level": {"enum": [
      "L0_ASSERTED", "L1_STRUCTURALLY_PRESENT", "L2_EXECUTED",
      "L3_BEHAVIORALLY_OBSERVED", "L4_VERIFIED", "L5_CAUSALLY_ATTRIBUTED",
      "L6_GENERALIZED", "L7_COMPOUNDED", "L8_COLD_SUCCESSOR_PROVEN"
    ]},
    "source_freshness": {"enum": ["CURRENT", "REVALIDATED", "STALE", "UNKNOWN"]},
    "evaluator_integrity": {
      "type": "object",
      "required": ["positive_control", "negative_control", "mutation_control",
        "contradiction_control", "stale_control", "cold_control"],
      "properties": {
        "positive_control": {"const": "PASS"},
        "negative_control": {"const": "PASS"},
        "mutation_control": {"const": "PASS"},
        "contradiction_control": {"const": "PASS"},
        "stale_control": {"const": "PASS"},
        "cold_control": {"const": "PASS"}
      }
    }
  },
  "additionalProperties": true
}
