{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nayanet://schemas/verification-receipt/v1",
  "title": "NayaNET Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id","schema_version","subject_ref","verification_state","verified_at","verifier_type","evidence_refs"],
  "properties": {
    "receipt_id": {"type":"string","minLength":1},
    "schema_version": {"const":"1.0"},
    "subject_ref": {"type":"string","minLength":1},
    "verification_state": {"enum":["recorded","evidence_available","verified","valued","applied","outcome_verified","rejected"]},
    "verified_at": {"type":"string","format":"date-time"},
    "verifier_type": {"enum":["system","rule","human","external_evidence","mixed"]},
    "evidence_refs": {"type":"array","minItems":1,"items":{"type":"string"}},
    "verification_method": {"type":"string","minLength":1},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "notes": {"type":"string"}
  }
}
