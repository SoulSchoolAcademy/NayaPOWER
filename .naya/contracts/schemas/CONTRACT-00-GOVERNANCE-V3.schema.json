{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya://contracts/schemas/CONTRACT-00-GOVERNANCE-V3",
  "title": "Contract 00 V3 Constitutional Governance Model",
  "type": "object",
  "required": ["contract_id","version","status","canonical_path","canonicality","core","precedence","truth_states","decision_procedure","action_classes","enforcement","self_governance","amendment","reachability","ratification"],
  "properties": {
    "contract_id": {"const": "CC-000"},
    "version": {"const": "3.0-candidate"},
    "status": {"enum": ["CANDIDATE","RATIFIED","ACTIVE","SUPERSEDED","BLOCKED","CONFLICTED"]},
    "canonical_path": {"const": ".naya/contracts/00-NAYANET-CONSTITUTIONAL-CONTRACT-LAW.md"},
    "canonicality": {"type":"object","required":["canonical_contract","max_in_force_constitutional_claimants","unmapped_in_force_claimants_before_ratification"],"properties":{
      "canonical_contract":{"const":".naya/contracts/00-NAYANET-CONSTITUTIONAL-CONTRACT-LAW.md"},
      "max_in_force_constitutional_claimants":{"const":1},
      "unmapped_in_force_claimants_before_ratification":{"const":0}
    },"additionalProperties":false},
    "core": {"type":"object","required":["identity","human_authority","precedence","truth_states","anti_guessing","source_of_truth","contract_discovery","conflict","proof","stop_conditions","execution_ownership","successor","non_delegable_rules"]},
    "precedence": {"type":"array","minItems":1,"items":{"type":"string"}},
    "truth_states": {"type":"array","minItems":8,"items":{"type":"string"}},
    "decision_procedure": {"const":".naya/contracts/CONTRACT-00-DECISION-PROCEDURE-V3.json"},
    "action_classes": {"const":["L0","L1","L2","L3"]},
    "enforcement": {"const":".naya/contracts/CONTRACT-00-ENFORCEMENT-REGISTRY-V3.json"},
    "self_governance": {"type":"string"},
    "amendment": {"type":"string"},
    "reachability": {"type":"string"},
    "ratification": {"type":"object","required":["human_only","machine_cannot_ratify","required_gates"],"properties":{
      "human_only":{"const":true},
      "machine_cannot_ratify":{"const":true},
      "required_gates":{"type":"array","minItems":10,"items":{"type":"string"}}
    },"additionalProperties":false}
  },
  "additionalProperties": false
}