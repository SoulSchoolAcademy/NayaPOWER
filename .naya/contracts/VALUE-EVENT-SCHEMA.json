{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nayanet://schemas/value-event-v1",
  "title": "NayaNET Value Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["value_event_id", "schema_version", "ledger_event_id", "verification_state", "value_class", "points", "calculation_version"],
  "properties": {
    "value_event_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "ledger_event_id": {"type": "string", "minLength": 1},
    "verification_state": {"const": "verified"},
    "value_class": {"type": "string", "minLength": 1},
    "value_score": {"type": "integer", "minimum": -9, "maximum": 9},
    "points": {"type": "integer"},
    "calculation_version": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1}
  }
}
