{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nayanet://schemas/smart-ledger-event-v1",
  "title": "NayaNET Smart Ledger Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_event_id",
    "schema_version",
    "event_type",
    "event_at",
    "created_at",
    "status"
  ],
  "properties": {
    "ledger_event_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "event_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "integrity_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_integrity_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "privacy_class": {
      "type": "string",
      "enum": [
        "private",
        "protected",
        "collective",
        "public"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "evidence_available",
        "verified",
        "valued",
        "applied",
        "outcome_verified",
        "rejected",
        "superseded"
      ]
    },
    "supersedes_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_verification_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "governance_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "governance_receipt": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "schema_version",
        "actor_id",
        "authority_id",
        "decision_id",
        "action_id",
        "capability_envelope",
        "responsibility_controls",
        "binding_hash"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "1.0"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "action_type": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "permission": {
          "type": "string"
        },
        "governance_state": {
          "type": "string"
        },
        "risk_tier": {
          "type": "string"
        },
        "capability_envelope": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "responsibility_controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binding_hash": {
          "type": "string",
          "minLength": 1
        },
        "validated_at": {
          "type": "string"
        }
      }
    }
  }
}
