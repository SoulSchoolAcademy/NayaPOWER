{
  "schema": "maxis.living-sun-design",
  "version": "1.0.0",
  "status": "active_design_contract",
  "authority": "NayaPOWER Issue #69",
  "purpose": "Define the canonical MAXIS assessment presentation while preserving assessment and scoring truth as an independent authority.",
  "decision": "NAYA_LIVING_SUN",
  "protected": {
    "orb_count": 24,
    "orb_count_meaning": "24-hour clock cycle",
    "color_cycle_count": 12,
    "color_cycle": ["MAGENTA", "RED", "ORANGE", "GOLD", "YELLOW", "GREEN", "TEAL", "CYAN", "BLUE", "INDIGO", "PURPLE", "LAVENDER"],
    "color_cycle_repetitions": 2,
    "active_orb_default": 1,
    "active_orb_behavior": "slow_circumferential_comet_or_energy_pulse",
    "default_trail": false,
    "visual_hierarchy": ["QUESTION", "ANSWERS", "NAYA", "PROGRESS_NAVIGATION", "LIVING_FIELD"],
    "naya_guide": ["PROFILE", "CONCISE_QUESTION_EXPLANATION", "PLAY_NAYA", "LETS_GO"],
    "navigation": ["BACK", "NEXT"],
    "architecture_boundary": "presentation_must_not_modify_assessment_or_scoring_truth",
    "mobile_first": true,
    "accessibility_first_class": true,
    "reduced_motion_required": true
  },
  "replaceable": [
    "implementation_technology",
    "orb_pixel_size",
    "orb_spacing",
    "orbital_radius",
    "depth_parallax_intensity",
    "glow_strength",
    "animation_duration",
    "animation_easing",
    "trail_if_evidence_supports_it",
    "typography",
    "responsive_layout_adaptation"
  ],
  "unknown_until_proven": [
    "optimal_orb_speed",
    "optimal_field_brightness",
    "whether_clock_symbolism_is_self_evident",
    "whether_trail_improves_focus",
    "optimal_mobile_field_representation"
  ],
  "answer_response": ["ACKNOWLEDGE_SELECTION", "BRIEF_FIELD_RESPONSE", "COMMIT_ENGINE_STATE", "ADVANCE_EFFICIENTLY"],
  "naya_rule": "Naya helps without interrupting or slowing the assessment.",
  "motion_rule": "Energy surrounds the experience; it never competes with the experience.",
  "proof_required": [
    "comprehension",
    "question_dominance",
    "answer_clarity",
    "progression_integrity",
    "scoring_integrity",
    "mobile_usability",
    "keyboard_accessibility",
    "screen_reader_accessibility",
    "reduced_motion",
    "performance",
    "naya_usability",
    "back_next_behavior",
    "result_continuity",
    "oscar_review",
    "exact_artifact_identity"
  ],
  "implementation_gate": {
    "minimum_vertical_slice": "five_real_questions_using_existing_maxis_engine",
    "sequence": ["BUILD", "STEP_BACK", "BECOME_HUMAN", "OSCAR", "SCORE", "REPAIR", "TEST", "PROVE", "RECORD"],
    "production_claim_requires_evidence": true
  },
  "truth_rules": [
    "implementation_is_not_proof",
    "presentation_is_not_assessment_truth",
    "unknown_is_not_verified",
    "local_visual_success_is_not_production_proof"
  ]
}
