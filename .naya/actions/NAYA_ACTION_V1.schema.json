{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"naya/action/v1",
  "title":"NAYA_ACTION_V1",
  "description":"Canonical atomic record for a governed Naya intelligence action. It records mission intent, understanding, authority, execution, evidence, verification, learning, provenance, and continuation. It reuses the existing NayaPOWER governance state machine.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","id","mission","human_intent","naya_understanding","authority","constraints","plan","actions","observations","evidence","verification","result","value","cost","risk","failure","lesson","memory","related_actions","provenance","human_confirmation","next_action","state"],
  "properties":{
    "schema":{"const":"naya/action/v1"},
    "id":{"type":"string","pattern":"^NAYA-ACTION-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$"},
    "mission":{"type":"string","minLength":1},
    "human_intent":{"type":"string","minLength":1},
    "naya_understanding":{"type":"string","minLength":1},
    "authority":{"type":"object","additionalProperties":false,"required":["source","authorized_scope"],"properties":{"source":{"type":"string"},"authorized_scope":{"type":"array","items":{"type":"string"}},"required_permission":{"type":"string"}}},
    "constraints":{"type":"array","items":{"type":"string"}},
    "plan":{"type":"array","items":{"type":"string"}},
    "actions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["action","status"],"properties":{"action":{"type":"string"},"status":{"type":"string"},"timestamp":{"type":"string"},"actor":{"type":"string"}}}},
    "observations":{"type":"array","items":{"type":"string"}},
    "evidence":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["claim_type","description","status"],"properties":{"claim_type":{"type":"string"},"description":{"type":"string"},"status":{"type":"string","enum":["CURRENT","HISTORICAL","STALE","UNKNOWN","BLOCKED"]},"source":{"type":"string"},"commit_sha":{"type":"string"},"url":{"type":"string"}}}},
    "verification":{"type":"object","additionalProperties":false,"required":["status","required_for_verification"],"properties":{"status":{"type":"string","enum":["NOT_STARTED","PARTIAL","VERIFIED","UNKNOWN","BLOCKED"]},"required_for_verification":{"type":"array","items":{"type":"string"}},"verified_claims":{"type":"array","items":{"type":"string"}},"unverified_claims":{"type":"array","items":{"type":"string"}}}},
    "result":{"type":"string"},
    "value":{"type":"object","additionalProperties":false,"required":["benefit","harm","cost","risk_adjusted_loss"],"properties":{"benefit":{"type":"number"},"harm":{"type":"number"},"cost":{"type":"number"},"risk_adjusted_loss":{"type":"number"},"responsible_verified_value":{"type":"number"}}},
    "cost":{"type":"object","additionalProperties":false,"properties":{"human_effort":{"type":"string"},"system_effort":{"type":"string"},"time":{"type":"string"}}},
    "risk":{"type":"object","additionalProperties":false,"required":["uncertainty","consequence","irreversibility","tier"],"properties":{"uncertainty":{"type":"number","minimum":0,"maximum":5},"consequence":{"type":"number","minimum":0,"maximum":5},"irreversibility":{"type":"number","minimum":0,"maximum":5},"tier":{"type":"string","pattern":"^R[0-5]$"}}},
    "failure":{"type":"object","additionalProperties":false,"required":["occurred"],"properties":{"occurred":{"type":"boolean"},"description":{"type":"string"},"root_cause":{"type":"string"},"repair":{"type":"string"},"safeguard":{"type":"string"}}},
    "lesson":{"type":"array","items":{"type":"string"}},
    "memory":{"type":"object","additionalProperties":false,"required":["durable","content"],"properties":{"durable":{"type":"boolean"},"content":{"type":"array","items":{"type":"string"}}}},
    "related_actions":{"type":"array","items":{"type":"string"}},
    "provenance":{"type":"object","additionalProperties":false,"required":["source_commit"],"properties":{"source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"workflow_run":{"type":["string","integer","null"]},"execution_evidence":{"type":"array","items":{"type":"string"}},"runtime_evidence":{"type":"array","items":{"type":"string"}},"deployment":{"type":["string","null"]}}},
    "human_confirmation":{"type":"string"},
    "next_action":{"type":"object","additionalProperties":false,"required":["title","instruction","actor","blocked","ready_to_run_execution"],"properties":{"title":{"type":"string"},"instruction":{"type":"string"},"actor":{"type":"string"},"blocked":{"type":"boolean"},"block_reason":{"type":"string"},"ready_to_run_execution":{"type":"string","minLength":1}}},
    "state":{"type":"string","enum":["PROPOSED","INVESTIGATING","READY_FOR_DECISION","AUTHORIZED","EXECUTING","EXECUTED","OBSERVED","VERIFIED","ASK","DEFERRED","REFUSED","STOPPED","FAILED","REQUIRES_REPAIR"]}
  }
}
