{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naya:smart-door-lifecycle:v1",
  "title": "NayaPOWER Smart Door Lifecycle Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability_id",
    "request_id",
    "idempotency_key",
    "registry_version",
    "state",
    "complete",
    "required_authority",
    "authority_enforcement_observed",
    "receipts",
    "terminal_receipt_sha256",
    "truth_boundary"
  ],
  "properties": {
    "schema": {
      "const": "naya-smart-door-run/v1"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "state": {
      "enum": [
        "DISCOVER",
        "REQUEST",
        "AUTHORIZE",
        "EXECUTE",
        "RECEIVE",
        "VERIFY",
        "PERSIST",
        "INDEX",
        "LEARN",
        "COMPLETE"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "required_authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_enforcement_observed": {
      "enum": [
        "AUTHENTICATION_ONLY",
        "OWNER_SCOPE_VALIDATED",
        "EXPLICIT_GRANT_VALIDATED",
        "SIGNED_EXTERNAL_INPUT",
        "NOT_TESTED"
      ]
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "terminal_receipt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "truth_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "capability_id",
        "request_id",
        "idempotency_key",
        "registry_version",
        "sequence",
        "state",
        "previous_receipt_sha256",
        "details",
        "receipt_sha256"
      ],
      "properties": {
        "schema": {
          "const": "naya-smart-door-receipt/v1"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "registry_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "state": {
          "enum": [
            "DISCOVER",
            "REQUEST",
            "AUTHORIZE",
            "EXECUTE",
            "RECEIVE",
            "VERIFY",
            "PERSIST",
            "INDEX",
            "LEARN"
          ]
        },
        "previous_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "details": {
          "type": "object"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
