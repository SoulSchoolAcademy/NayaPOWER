{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naya:capability-registry:v1",
  "title": "NayaPOWER Capability Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "authority_boundary",
    "provenance",
    "capabilities",
    "excluded_surfaces"
  ],
  "properties": {
    "schema": {
      "const": "NAYA_CAPABILITY_REGISTRY_V1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "authority_boundary": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_spec",
        "runtime_baseline_commit",
        "inventory_method",
        "runtime_mutation"
      ],
      "properties": {
        "canonical_spec": {
          "type": "string",
          "minLength": 1
        },
        "runtime_baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "inventory_method": {
          "type": "string",
          "minLength": 1
        },
        "runtime_mutation": {
          "const": false
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "excluded_surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excluded_surface"
      }
    }
  },
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "inputs",
        "outputs",
        "required_authority",
        "allowed_scope",
        "risk",
        "reversibility",
        "receipt_required",
        "verification_required",
        "implementation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "outputs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "required_authority": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "allowed_scope": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "risk": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ]
        },
        "reversibility": {
          "enum": [
            "READ_ONLY",
            "REVERSIBLE",
            "RECOVERABLE",
            "IRREVERSIBLE"
          ]
        },
        "receipt_required": {
          "type": "boolean"
        },
        "verification_required": {
          "type": "boolean"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence_state",
            "authority_enforcement",
            "source_paths",
            "invocation",
            "transport_aliases",
            "notes"
          ],
          "properties": {
            "status": {
              "enum": [
                "DEFINED",
                "IMPLEMENTED",
                "CONNECTED",
                "AUTHENTICATED",
                "AUTHORIZED",
                "HEALTHY",
                "DEGRADED",
                "BLOCKED",
                "REVOKED",
                "EXPIRED",
                "FAILED",
                "DISCONNECTED"
              ]
            },
            "evidence_state": {
              "enum": [
                "UNKNOWN",
                "IMPLEMENTED",
                "TESTED",
                "VERIFIED",
                "RUNTIME-PROVEN",
                "PRODUCTION-PROVEN"
              ]
            },
            "authority_enforcement": {
              "enum": [
                "AUTHENTICATION_ONLY",
                "OWNER_SCOPE_VALIDATED",
                "EXPLICIT_GRANT_VALIDATED",
                "SIGNED_EXTERNAL_INPUT",
                "NOT_TESTED"
              ]
            },
            "source_paths": {
              "$ref": "#/$defs/non_empty_string_array"
            },
            "invocation": {
              "$ref": "#/$defs/non_empty_string_array"
            },
            "transport_aliases": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "excluded_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "reason",
        "source_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "classification": {
          "enum": [
            "OUT_OF_SCOPE",
            "OWNER_UI",
            "REPOSITORY_TOOLING",
            "SOURCE_DRIFT",
            "UNRESOLVED_AUTHORITY",
            "FUTURE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_paths": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    }
  }
}
