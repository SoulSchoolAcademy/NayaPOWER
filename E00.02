<style id="MAXESS-ISOLATION-V6-CSS">

/*
 * ============================================================
 * MAXESS ISOLATION V6
 * ============================================================
 *
 * Purpose:
 * 1. Protect E00 assessment layout.
 * 2. Keep Results hidden until E00 completes.
 * 3. Prevent E01-E09 from occupying the visible viewport early.
 * 4. Restore full-width behavior for E00.
 * 5. Provide a clean Results release boundary.
 */

html[data-maxess-results-state="waiting"] #e00,
html[data-maxess-results-state="waiting"] .maxess-e00,
html[data-maxess-results-state="waiting"] [data-maxess-e00] {
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

html[data-maxess-results-state="waiting"] #e00 .app,
html[data-maxess-results-state="waiting"] #e00 .shell,
html[data-maxess-results-state="waiting"] #e00 .board,
html[data-maxess-results-state="waiting"] #e00 .content {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
}

html[data-maxess-results-state="waiting"] [id="e01"],
html[data-maxess-results-state="waiting"] [id="maxess-e02-v2"],
html[data-maxess-results-state="waiting"] [id="e03"],
html[data-maxess-results-state="waiting"] [id="e04"],
html[data-maxess-results-state="waiting"] [id="e05"],
html[data-maxess-results-state="waiting"] [id="e06"],
html[data-maxess-results-state="waiting"] [id="e07"],
html[data-maxess-results-state="waiting"] [id="e08"],
html[data-maxess-results-state="waiting"] [id="e09"] {
  display: none !important;
}

html[data-maxess-results-state="waiting"] [data-maxess-result-section],
html[data-maxess-results-state="waiting"] .maxess-result-section {
  display: none !important;
}

html[data-maxess-results-state="released"] [data-maxess-result-section],
html[data-maxess-results-state="released"] .maxess-result-section {
  display: block !important;
}

html[data-maxess-results-state="waiting"] #e00,
html[data-maxess-results-state="waiting"] #e00 * {
  box-sizing: border-box;
}

html[data-maxess-results-state="waiting"] #e00 {
  flex: 0 0 100% !important;
  align-self: stretch !important;
}

html[data-maxess-results-state="waiting"] body {
  width: 100% !important;
  max-width: 100% !important;
  overflow-x: hidden !important;
}

</style>

<script id="MAXESS-ISOLATION-V6">
(function () {
  'use strict';

  if (window.__MAXESS_ISOLATION_V6__) return;
  window.__MAXESS_ISOLATION_V6__ = true;

  const ROOT_STATE = 'data-maxess-results-state';

  function markWaiting() {
    document.documentElement.setAttribute(
      ROOT_STATE,
      'waiting'
    );
  }

  function findSections() {
    return [
      document.getElementById('e01'),
      document.getElementById('maxess-e02-v2'),
      document.getElementById('e03'),
      document.getElementById('e04'),
      document.getElementById('e05'),
      document.getElementById('e06'),
      document.getElementById('e07'),
      document.getElementById('e08'),
      document.getElementById('e09')
    ].filter(Boolean);
  }

  function markResultSections() {
    findSections().forEach(function (section) {
      section.setAttribute(
        'data-maxess-result-section',
        ''
      );

      section.classList.add(
        'maxess-result-section'
      );
    });
  }

  function release(result) {
    if (!result) return;

    document.documentElement.setAttribute(
      ROOT_STATE,
      'released'
    );

    markResultSections();

    const e00 =
      document.getElementById('e00') ||
      document.querySelector('[data-maxess-e00]') ||
      document.querySelector('.maxess-e00');

    if (e00) {
      e00.style.width = '100%';
      e00.style.maxWidth = 'none';
      e00.style.minWidth = '0';
    }

    const first = document.getElementById('e01');

    if (first) {
      setTimeout(function () {
        first.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }, 80);
    }

    console.log(
      '[MAXESS ISOLATION] Results released:',
      result.overallScore
    );
  }

  markWaiting();

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      markResultSections,
      { once: true }
    );
  } else {
    markResultSections();
  }

  window.addEventListener(
    'MAXESS_ISOLATION_RELEASE',
    function (event) {
      release(
        event &&
        event.detail &&
        event.detail.result
      );
    }
  );

})();
</script>
