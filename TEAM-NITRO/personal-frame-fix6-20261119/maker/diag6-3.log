10948: /* âââ Toast âââ
10949:    Two call conventions live in this file â honor both (P2 fix2, 2026-11-11):
10950:    (message, accent, ms)            â accent is a color/var, ms a number
10951:    (message, subtext, accentColor)  â subtext is a sentence, accent a color
10952:    The old signature (message, accent, ms) treated the subtext as the accent
10953:    and the color as ms, so setTimeout got NaN â 0 and every 3-arg toast
10954:    vanished instantly (diag11: 'LINK COPIED' already class 'out' at 8ms).
10955:    The subtext now renders as a second line; ms is always a real number. */
10956: function toast(message, second, third, fourth) {
10957:   function isColor(v) {
10958:     return typeof v === 'string' && (/^#[0-9a-f]{3,8}$/i.test(v.trim()) ||
10959:       /^var\(--[^)]+\)$/.test(v.trim()) ||
10960:       /^(gold|silver|white|black|red|green|blue|purple|magenta|teal|emerald)$/i.test(v.trim()));
10961:   }
10962:   let text = null, accent = 'var(--magenta)', ms = 4200;
10963:   if (isColor(second)) { accent = second; if (typeof third === 'number') ms = third; }
10964:   else {
10965:     if (second != null) text = second;
10966:     if (typeof third === 'string') accent = third;
10967:     else if (typeof third === 'number') ms = third;
10968:     if (typeof fourth === 'number') ms = fourth;
10969:   }
10970:   if (!(ms > 0)) ms = 4200;
10971:   let stack = document.querySelector('.toast-stack');
10972:   if (!stack) { stack = el('div', 'toast-stack'); document.body.appendChild(stack); }
10973:   const t = el('div', 'toast', text ? `<span>${message}</span><small>${text}</small>` : `<span>${message}</span>`);
10974:   if (text) {
10975:     t.style.flexDirection = 'column'; t.style.alignItems = 'flex-start'; t.style.gap = '2px';
10976:     const s = t.querySelector('small');
10977:     if (s) { s.style.fontWeight = '400'; s.style.opacity = '.85'; }
10978:   }
10979:   t.style.setProperty('--toast-accent', accent);
10980:   stack.appendChild(t);
10981:   setTimeout(() => { t.classList.add('out'); setTimeout(() => t.remove(), 350); }, ms);
10982: }
