<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>NayaNET — Smart Identity Activation</title>
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <meta name="theme-color" content="#a855f7">
  <script src="/NAYANET/name-first-auth-adapter.js" defer></script>
  <style>
    :root { --bg-obsidian:#010103; --text-main:#fff; --text-muted:#cbd5e1; --purple-electric:#a855f7; --purple-border:rgba(168,85,247,.85); --purple-aura:rgba(168,85,247,.45); --readiness-green:#10b981; --readiness-green-glow:rgba(16,185,129,.6); --dark-emerald:#064e3b; }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0} html,body{width:100%;height:100%;background:var(--bg-obsidian);color:var(--text-main);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;-webkit-font-smoothing:antialiased} body{display:flex;flex-direction:column;justify-content:space-between;align-items:center;min-height:100vh;overflow-x:hidden;overflow-y:auto;padding-bottom:40px}.top-system-bar{width:100%;height:68px;background:rgba(5,6,10,.94);border-bottom:1.5px solid rgba(168,85,247,.4);box-shadow:0 8px 32px rgba(0,0,0,.95);display:flex;align-items:center;justify-content:space-between;padding:0 min(28px,5vw);position:sticky;top:0;z-index:100;backdrop-filter:blur(18px)}.brand-logo-group{display:flex;align-items:center;gap:14px;cursor:pointer}.brand-logo-group img{width:42px;height:42px;border-radius:12px;border:1.5px solid rgba(255,255,255,.8);box-shadow:0 0 20px var(--purple-aura);object-fit:contain}.brand-logo-title{font-size:min(1.2rem,4vw);font-weight:900;letter-spacing:.22em;color:#fff;text-transform:uppercase}.primo-btn{position:relative;background:radial-gradient(circle at 50% 0%,#221c40 0%,#05060a 100%);border:2px solid var(--purple-electric);border-radius:32px;padding:12px 24px;color:#fff;font-size:.88rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase;cursor:pointer;box-shadow:0 8px 25px var(--purple-aura),inset 0 1px 2px rgba(255,255,255,.3);transition:all .35s cubic-bezier(.16,1,.3,1);display:inline-flex;align-items:center;justify-content:center;gap:10px;white-space:nowrap}.activation-stage{width:100%;max-width:860px;margin:30px auto;padding:0 20px;text-align:center}.identity-pro-card{background:radial-gradient(circle at 50% 0%,#181c2e 0%,#040508 94%);border:2.5px solid var(--purple-electric);border-radius:36px;padding:42px 32px;box-shadow:0 25px 70px rgba(0,0,0,.95),0 0 50px var(--purple-aura);position:relative}.logo-hero{width:96px;height:96px;border-radius:24px;border:2px solid #fff;box-shadow:0 0 35px var(--purple-aura);margin-bottom:20px;object-fit:contain;background:#000}.card-title{font-size:min(2.1rem,6vw);font-weight:900;color:#fff;margin-bottom:10px;letter-spacing:.04em}.card-subtitle{font-size:min(1.1rem,3.8vw);color:var(--text-muted);margin-bottom:28px;font-weight:500;line-height:1.5;max-width:650px;margin-left:auto;margin-right:auto}.alias-input-box{width:100%;max-width:520px;margin:0 auto 28px;text-align:left}.alias-label{font-size:.8rem;font-weight:900;letter-spacing:.25em;color:var(--text-muted);text-transform:uppercase;margin-bottom:8px;display:block}.alias-field-wrapper{display:flex;align-items:center;background:#06070a;border:2px solid var(--purple-electric);border-radius:20px;padding:10px 18px;box-shadow:0 0 20px var(--purple-aura)}.alias-field-input{flex:1;background:transparent;border:none;outline:none;color:#fff;font-size:1.25rem;font-weight:800;font-family:inherit}.identity-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-bottom:28px;text-align:left}.id-box{background:rgba(12,15,24,.85);border:1.5px solid rgba(168,85,247,.5);border-radius:20px;padding:18px 20px}.id-box-label{font-size:.75rem;font-weight:900;letter-spacing:.25em;color:var(--text-muted);text-transform:uppercase;margin-bottom:6px}.id-box-value{font-size:1.15rem;font-weight:800;color:var(--readiness-green);word-break:break-all}.app-install-banner{background:linear-gradient(180deg,rgba(168,85,247,.15),rgba(124,58,237,.08));border:2px dashed var(--purple-electric);border-radius:24px;padding:22px;margin-bottom:32px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;text-align:left}.install-info{flex:1;min-width:220px}.install-title{font-size:1.05rem;font-weight:900;color:#fff;margin-bottom:4px;text-transform:uppercase;letter-spacing:.08em}.install-desc{font-size:.88rem;color:var(--text-muted);font-weight:500}.status-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(16,185,129,.15);border:1.5px solid var(--readiness-green);padding:8px 18px;border-radius:20px;font-size:.88rem;font-weight:800;color:#fff;margin-bottom:28px;box-shadow:0 0 15px var(--readiness-green-glow)}.status-dot{width:10px;height:10px;border-radius:50%;background:var(--readiness-green);box-shadow:0 0 10px var(--readiness-green)}.activate-btn{width:100%;padding:22px 28px;background:radial-gradient(circle at 50% 0%,#10b981 0%,#047857 100%);color:#fff;border:2px solid #a7f3d0;border-radius:32px;font-size:min(1.25rem,4vw);font-weight:900;letter-spacing:.22em;text-transform:uppercase;cursor:pointer;transition:all .35s ease;box-shadow:0 0 35px var(--readiness-green-glow)}.bottom-system-bar{width:100%;height:50px;background:rgba(5,6,10,.94);border-top:1.5px solid rgba(168,85,247,.4);display:flex;align-items:center;justify-content:space-between;padding:0 min(28px,5vw);font-size:.88rem;font-weight:800;color:#fff;letter-spacing:.12em;backdrop-filter:blur(14px);margin-top:30px}
  </style>
</head>
<body>
  <header class="top-system-bar">
    <div class="brand-logo-group" onclick="window.location.href='index.html'"><img src="icon-192.png" alt="NayaNET Crystal Logo"><span class="brand-logo-title">NayaNET</span></div>
    <button type="button" class="primo-btn" onclick="window.location.href='/'">🎧 Naya Player</button>
  </header>
  <main class="activation-stage">
    <div class="identity-pro-card">
      <img src="icon-512.png" alt="NayaNET Crystal Logo" class="logo-hero">
      <h1 class="card-title">Welcome to NayaNET</h1>
      <p class="card-subtitle">Choose the NayaNET address you want to use. This address is your NayaNET identity namespace — not an email address.</p>
      <div class="alias-input-box">
        <label class="alias-label" for="aliasInput">Your NayaNET Address</label>
        <div class="alias-field-wrapper"><span style="font-size:1.2rem;font-weight:900;color:#c084fc">@</span><input type="text" id="aliasInput" class="alias-field-input" placeholder="yourname" autocomplete="username"></div>
      </div>
      <div class="status-badge"><span class="status-dot"></span><span id="identityStatus">Ready to establish your private session</span></div>
      <div class="identity-grid">
        <div class="id-box"><div class="id-box-label">Smart Name</div><div class="id-box-value" id="displayName">—</div></div>
        <div class="id-box"><div class="id-box-label">NayaNET Address</div><div class="id-box-value" id="displayAlias">—</div></div>
        <div class="id-box"><div class="id-box-label">Identity State</div><div class="id-box-value" id="displayIdentity">NOT ESTABLISHED</div></div>
        <div class="id-box"><div class="id-box-label">Destination</div><div class="id-box-value">INTELLIGENT HUB</div></div>
      </div>
      <div class="app-install-banner">
        <div class="install-info"><div class="install-title">📲 Install NayaNET App</div><div class="install-desc">Your installed NayaNET app returns to the Intelligent Hub when a valid session exists.</div></div>
        <button type="button" class="primo-btn" id="installBtn">Add to Home Screen</button>
      </div>
      <button type="button" class="activate-btn" id="activateBtn">☀️ Enter NayaNET Intelligence Hub →</button>
      <div id="error" role="alert" style="min-height:22px;margin-top:14px;color:#fca5a5;font-weight:700"></div>
    </div>
  </main>
  <footer class="bottom-system-bar">NayaNET Private Network — Private by default</footer>
  <script>
    let deferredPrompt;
    window.addEventListener('beforeinstallprompt',(e)=>{e.preventDefault();deferredPrompt=e;});
    document.getElementById('installBtn').addEventListener('click',()=>{if(deferredPrompt){deferredPrompt.prompt();deferredPrompt.userChoice.finally(()=>{deferredPrompt=null;});}else{alert('To install: use your browser menu and choose Add to Home Screen.');}});
    const params=new URLSearchParams(location.search);
    const rawName=(params.get('name')||sessionStorage.getItem('nayanet_user_name')||localStorage.getItem('nayanet_smart_name')||'').trim();
    const cleanAlias=v=>String(v||'').toLowerCase().replace(/[^a-z0-9]/g,'').slice(0,48);
    const name=rawName;
    const aliasInput=document.getElementById('aliasInput');
    const displayName=document.getElementById('displayName');
    const displayAlias=document.getElementById('displayAlias');
    const displayIdentity=document.getElementById('displayIdentity');
    const status=document.getElementById('identityStatus');
    const error=document.getElementById('error');
    displayName.textContent=name||'—';
    aliasInput.value=cleanAlias(localStorage.getItem('nayanet_smart_alias')||name);
    function sync(){displayAlias.textContent=cleanAlias(aliasInput.value)||'—';}
    aliasInput.addEventListener('input',sync);sync();
    async function restore(){
      try{
        if(!window.NayaNETNameFirstAuth) return;
        const existing=await window.NayaNETNameFirstAuth.current();
        if(existing?.authenticated){
          localStorage.setItem('nayanet_smart_name',existing.smartName||name);
          localStorage.setItem('nayanet_smart_alias',existing.smartAlias||cleanAlias(aliasInput.value));
          window.location.replace('https://sparkling-shape-7ae5.smartnetpodcast.workers.dev/?name='+encodeURIComponent(smartName)+'&alias='+encodeURIComponent(smartAlias));
        }
      }catch(e){ console.debug('NayaNET session restore unavailable',e); }
    }
    window.addEventListener('load',restore);
    document.getElementById('activateBtn').addEventListener('click',async()=>{
      error.textContent='';
      const smartName=name;
      const smartAlias=cleanAlias(aliasInput.value||smartName);
      if(!smartName){error.textContent='NAME_REQUIRED';return;}
      if(!smartAlias){error.textContent='ALIAS_REQUIRED';return;}
      const btn=document.getElementById('activateBtn');btn.disabled=true;status.textContent='Establishing your private NayaNET session…';displayIdentity.textContent='AUTHENTICATING';
      try{
        if(!window.NayaNETNameFirstAuth) throw new Error('IDENTITY_ADAPTER_NOT_LOADED');
        const identity=await window.NayaNETNameFirstAuth.establish({name:smartName,alias:smartAlias});
        if(!identity?.authenticated||!identity?.userId) throw new Error('AUTH_SESSION_NOT_ESTABLISHED');
        displayIdentity.textContent='AUTHENTICATED';status.textContent=`Welcome, ${identity.smartName}. Entering Intelligent Hub…`;
        window.location.replace('https://sparkling-shape-7ae5.smartnetpodcast.workers.dev/?name='+encodeURIComponent(existing.smartName||name)+'&alias='+encodeURIComponent(existing.smartAlias||cleanAlias(aliasInput.value)));
      }catch(e){console.error(e);displayIdentity.textContent='NOT ESTABLISHED';status.textContent='Identity setup needs attention';error.textContent=e?.message||'Unable to establish your NayaNET session.';btn.disabled=false;}
    });
  </script>
</body>
</html>
