<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>NayaNET — Smart Identity Activation</title>
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <meta name="theme-color" content="#a855f7">
  <style>
    :root {
      --bg-obsidian: #010103; --text-main: #ffffff; --text-muted: #cbd5e1;
      --purple-electric: #a855f7; --purple-border: rgba(168, 85, 247, 0.85); --purple-aura: rgba(168, 85, 247, 0.45);
      --readiness-green: #10b981; --readiness-green-glow: rgba(16, 185, 129, 0.6);
      --dark-emerald: #064e3b;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { width: 100%; height: 100%; background-color: var(--bg-obsidian); color: var(--text-main); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
    body { display: flex; flex-direction: column; justify-content: space-between; align-items: center; min-height: 100vh; overflow-x: hidden; overflow-y: auto; padding-bottom: 40px; }
    .top-system-bar { width: 100%; height: 68px; background: rgba(5, 6, 10, 0.94); border-bottom: 1.5px solid rgba(168, 85, 247, 0.4); box-shadow: 0 8px 32px rgba(0,0,0,0.95); display: flex; align-items: center; justify-content: space-between; padding: 0 min(28px, 5vw); position: sticky; top: 0; z-index: 100; backdrop-filter: blur(18px); }
    .brand-logo-group { display: flex; align-items: center; gap: 14px; cursor: pointer; }
    .brand-logo-group img { width: 42px; height: 42px; border-radius: 12px; border: 1.5px solid rgba(255, 255, 255, 0.8); box-shadow: 0 0 20px var(--purple-aura); object-fit: contain; }
    .brand-logo-title { font-size: min(1.2rem, 4vw); font-weight: 900; letter-spacing: 0.22em; color: #ffffff; text-transform: uppercase; }
    .primo-btn { position: relative; background: radial-gradient(circle at 50% 0%, #221c40 0%, #05060a 100%); border: 2px solid var(--purple-electric); border-radius: 32px; padding: 12px 24px; color: #ffffff; font-size: 0.88rem; font-weight: 900; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; box-shadow: 0 8px 25px var(--purple-aura), inset 0 1px 2px rgba(255, 255, 255, 0.3); transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1); display: inline-flex; align-items: center; justify-content: center; gap: 10px; white-space: nowrap; }
    .primo-btn:hover { transform: translateY(-3px) scale(1.02); border-color: #ffffff; background: var(--dark-emerald); box-shadow: 0 12px 35px var(--readiness-green-glow), inset 0 1px 3px rgba(255, 255, 255, 0.6); color: #ffffff; }
    .activation-stage { width: 100%; max-width: 860px; margin: 30px auto; padding: 0 20px; text-align: center; }
    .identity-pro-card { background: radial-gradient(circle at 50% 0%, #181c2e 0%, #040508 94%); border: 2.5px solid var(--purple-electric); border-radius: 36px; padding: 42px 32px; box-shadow: 0 25px 70px rgba(0, 0, 0, 0.95), 0 0 50px var(--purple-aura); position: relative; }
    .logo-hero { width: 96px; height: 96px; border-radius: 24px; border: 2px solid #ffffff; box-shadow: 0 0 35px var(--purple-aura); margin-bottom: 20px; object-fit: contain; background: #000; }
    .card-title { font-size: min(2.1rem, 6vw); font-weight: 900; color: #ffffff; margin-bottom: 10px; letter-spacing: 0.04em; }
    .card-subtitle { font-size: min(1.1rem, 3.8vw); color: var(--text-muted); margin-bottom: 28px; font-weight: 500; line-height: 1.5; max-width: 650px; margin-left: auto; margin-right: auto; }
    .alias-input-box { width: 100%; max-width: 520px; margin: 0 auto 28px auto; text-align: left; }
    .alias-label { font-size: 0.8rem; font-weight: 900; letter-spacing: 0.25em; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block; }
    .alias-field-wrapper { display: flex; align-items: center; background: #06070a; border: 2px solid var(--purple-electric); border-radius: 20px; padding: 10px 18px; box-shadow: 0 0 20px var(--purple-aura); }
    .alias-field-input { flex: 1; background: transparent; border: none; outline: none; color: #ffffff; font-size: 1.25rem; font-weight: 800; font-family: inherit; }
    .identity-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-bottom: 28px; text-align: left; }
    .id-box { background: rgba(12, 15, 24, 0.85); border: 1.5px solid rgba(168, 85, 247, 0.5); border-radius: 20px; padding: 18px 20px; }
    .id-box-label { font-size: 0.75rem; font-weight: 900; letter-spacing: 0.25em; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; }
    .id-box-value { font-size: 1.15rem; font-weight: 800; color: var(--readiness-green); word-break: break-all; }
    .app-install-banner { background: linear-gradient(180deg, rgba(168, 85, 247, 0.15) 0%, rgba(124, 58, 237, 0.08) 100%); border: 2px dashed var(--purple-electric); border-radius: 24px; padding: 22px; margin-bottom: 32px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; text-align: left; }
    .install-info { flex: 1; min-width: 220px; }
    .install-title { font-size: 1.05rem; font-weight: 900; color: #ffffff; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.08em; }
    .install-desc { font-size: 0.88rem; color: var(--text-muted); font-weight: 500; }
    .status-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(16, 185, 129, 0.15); border: 1.5px solid var(--readiness-green); padding: 8px 18px; border-radius: 20px; font-size: 0.88rem; font-weight: 800; color: #ffffff; margin-bottom: 28px; box-shadow: 0 0 15px var(--readiness-green-glow); }
    .status-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--readiness-green); box-shadow: 0 0 10px var(--readiness-green); }
    .activate-btn { width: 100%; padding: 22px 28px; background: radial-gradient(circle at 50% 0%, #10b981 0%, #047857 100%); color: #ffffff; border: 2px solid #a7f3d0; border-radius: 32px; font-size: min(1.25rem, 4vw); font-weight: 900; letter-spacing: 0.22em; text-transform: uppercase; cursor: pointer; transition: all 0.35s ease; box-shadow: 0 0 35px var(--readiness-green-glow); }
    .activate-btn:hover { transform: translateY(-3px) scale(1.01); background: var(--dark-emerald); box-shadow: 0 0 60px var(--readiness-green); border-color: #ffffff; color: #ffffff; }
    .bottom-system-bar { width: 100%; height: 50px; background: rgba(5, 6, 10, 0.94); border-top: 1.5px solid rgba(168, 85, 247, 0.4); display: flex; align-items: center; justify-content: space-between; padding: 0 min(28px, 5vw); font-size: 0.88rem; font-weight: 800; color: #ffffff; letter-spacing: 0.12em; backdrop-filter: blur(14px); margin-top: 30px; }
  </style>
</head>
<body>
  <header class="top-system-bar">
    <div class="brand-logo-group" onclick="window.location.href='index.html'">
      <img src="icon-192.png" alt="NayaNET Crystal Logo" />
      <span class="brand-logo-title">Sovereign Identity</span>
    </div>
    <button type="button" class="primo-btn" onclick="window.location.href='NAYAHUB.html'">🎧 Naya Player</button>
  </header>
  <main class="activation-stage">
    <div class="identity-pro-card">
      <img src="icon-512.png" alt="NayaNET Crystal Logo" class="logo-hero" />
      <h1 class="card-title">Official Smart Identity Ready</h1>
      <p class="card-subtitle">Type your custom alias below to configure your Smart Link and Secure Smart Mail ID, then enter your NayaNET Intelligence Hub.</p>
      <div class="alias-input-box">
        <label class="alias-label" for="aliasInput">Type Your Custom Smart Alias</label>
        <div class="alias-field-wrapper">
          <input type="text" id="aliasInput" class="alias-field-input" placeholder="pioneer" autocomplete="off" oninput="updateSmartCredentials()" />
        </div>
      </div>
      <div class="status-badge"><span class="status-dot"></span> Auto-Login Security Key Configured</div>
      <div class="identity-grid">
        <div class="id-box"><div class="id-box-label">Smart Name</div><div class="id-box-value" id="displayName">Pioneer</div></div>
        <div class="id-box"><div class="id-box-label">Sovereign Smart Alias</div><div class="id-box-value" id="displayAlias">pioneer</div></div>
        <div class="id-box"><div class="id-box-label">Smart Link</div><div class="id-box-value" id="displayLink">pioneer.nayanet.app</div></div>
        <div class="id-box"><div class="id-box-label">Secure Smart Mail</div><div class="id-box-value" id="displayMail">pioneer</div></div>
      </div>
      <div class="app-install-banner">
        <div class="install-info"><div class="install-title">📲 Install NayaNET App</div><div class="install-desc">Add NayaNET to your Home Screen with official NayaNET Crystal Icon.</div></div>
        <button type="button" class="primo-btn" id="installBtn" onclick="triggerAppInstall()">Add to Home Screen</button>
      </div>
      <button type="button" class="activate-btn" onclick="activateAndRedirect()">☀️ Enter NayaNET Intelligence Hub →</button>
    </div>
  </main>
  <footer class="bottom-system-bar">NayaNET Private Network — Protected Sovereign Key</footer>
  <script>
    let deferredPrompt;
    window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferredPrompt = e; document.getElementById('installBtn').style.display = 'block'; });
    function triggerAppInstall() { if (deferredPrompt) { deferredPrompt.prompt(); deferredPrompt.userChoice.then(() => { deferredPrompt = null; }); } else { alert('To install: Tap your browser share/menu button and select "Add to Home Screen".'); } }
    const urlParams = new URLSearchParams(window.location.search);
    const rawName = urlParams.get('name') || sessionStorage.getItem('nayanet_user_name') || 'Pioneer';
    const cleanDefaultAlias = rawName.toLowerCase().replace(/[^a-z0-9]/g, '');
    document.getElementById('displayName').textContent = rawName;
    const aliasInput = document.getElementById('aliasInput');
    aliasInput.value = cleanDefaultAlias || 'pioneer';
    function updateSmartCredentials() { const currentAlias = aliasInput.value.toLowerCase().replace(/[^a-z0-9]/g, '') || 'pioneer'; document.getElementById('displayAlias').textContent = currentAlias; document.getElementById('displayLink').textContent = currentAlias + '.nayanet.app'; document.getElementById('displayMail').textContent = currentAlias; }
    updateSmartCredentials();
    window.activateAndRedirect = function() {
      const finalAlias = aliasInput.value.toLowerCase().replace(/[^a-z0-9]/g, '') || 'pioneer';
      const deviceKey = 'nayanet_key_' + Math.random().toString(36).substring(2, 15);
      localStorage.setItem('nayanet_vault_key', deviceKey);
      localStorage.setItem('nayanet_smart_alias', finalAlias);
      localStorage.setItem('nayanet_smart_name', rawName);
      window.location.href = 'NAYAHUB.html?name=' + encodeURIComponent(rawName);
    };
  </script>
</body>
</html>
