9-btn:hover,.e9-btn:focus-visible{transform:translateY(-2px);box-shadow:0 16px 40px rgba(255,255,255,.14);outline:none}.e9-btn:focus-visible{outline:2px solid #ad82ff;outline-offset:4px}
