function syncFromResult(r){var s=clamp(r&&r.overallScore);if(s===null)return false;scoreNode.textContent=formatScore(s);scoreNode.dataset.hydrated='true';scoreNode.dataset.demo='false';unavailableNode.dataset.visible='false';scoreDescription.textContent='Your AI score is '+formatScore(s)+' out of 100.';liveNode.textContent='Your AI score is '+formatScore(s)+' out of 100.';applyPalette(s);return true}
function render(){if(resultState&&syncFromResult(resultState))return true;if(consumeHash())return syncFromResult(resultState);if(consumeKnownGlobals())return syncFromResult(resultState);if(consumeStorage())return syncFromResult(resultState);scoreNode.textContent='';scoreNode.dataset.hydrated='false';scoreNode.dataset.demo='false';unavailableNode.dataset.visible='true';scoreDescription.textContent='Your AI score is waiting for a valid MAXESS result.';liveNode.textContent='Waiting for a valid MAXESS result.';return false}
function hexToRgb(h){h=h.replace('#','');return{r:parseInt(h.slice(0,2),16),g:parseInt(h.slice(2,4),16),b:parseInt(h.slice(4,6),16)}}
function rgbToHex(r,g,b){return'#'+[r,g,b].map(function(v){return Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,'0')}).join('')}
function mix(a,b,t){var x=hexToRgb(a),y=hexToRgb(b);return rgbToHex(x.r+(y.r-x.r)*t,x.g+(y.g-x.g)*t,x.b+(y.b-x.b)*t)}
function palette(s){if(s<50){var t=s/50;return{a:mix('#ff2d55','#ff3b1f',t),b:mix('#ff5a36','#ff1744',t),rgb:hexToRgb(mix('#ff2d55','#ff3b1f',t))}}if(s<75){var t=(s-50)/25;return{a:mix('#ff7a18','#ffd166',t),b:mix('#ff9f1c','#fff06a',t),rgb:hexToRgb(mix('#ff9f1c','#fff06a',t))}}if(s<90){var t=(s-75)/15;return{a:mix('#20c96b','#38bdf8',t),b:mix('#22e67d','#2563eb',t),rgb:hexToRgb(mix('#20c96b','#38bdf8',t))}}var t=Math.min(1,(s-90)/10);return{a:mix('#8b5cf6','#d946ef',t),b:mix('#a855f7','#ff3cac',t),rgb:hexToRgb(mix('#8b5cf6','#d946ef',t))}}
function applyPalette(s){var p=palette(s);root.style.setProperty('--score-a',p.a);root.style.setProperty('--score-b',p.b);root.style.setProperty('--score-rgb',p.rgb.r+','+p.rgb.g+','+p.rgb.b)}
function setSpeaking(active){if(!orbWrap)return;orbWrap.classList.toggle('orb-speaking',!!active);if(nayaCard)nayaCard.classList.toggle('is-speaking',!!active);if(listen)listen.classList.toggle('is-speaking',!!active);if(listen){var label=listen.querySelector('.listen-label');if(label)label.textContent=active?'NAYA IS SPEAKING':'LISTEN TO NAYA'}if(speakTimer){clearTimeout(speakTimer);speakTimer=null}if(active){speakTimer=setTimeout(function(){setSpeaking(false)},30000)}}
function onSpeechStart(){setSpeaking(true)}function onSpeechEnd(){setSpeaking(false)}
window.addEventListener(READY,function(e){if(e&&e.detail)acceptResult(e.detail,false);render()});window.addEventListener(UPDATED,function(e){if(e&&e.detail)acceptResult(e.detail,false);render()});window.addEventListener('hashchange',function(){render();requestFromParent()});window.addEventListener('storage',render);window.addEventListener('message',function(e){var d=e&&e.data;if(!d)return;if(d.type==='MAXESS_RESULT'&&validResult(d.result)){acceptResult(d.result);render()}});
render();requestFromParent();
var hydrationPoll=setInterval(function(){if(render()){clearInterval(hydrationPoll)}},250);setTimeout(function(){clearInterval(hydrationPoll)},15000);
['naya:speaking','naya:speech-start','naya:audio-start','naya:voice-start'].forEach(function(name){window.addEventListener(name,onSpeechStart)});['naya:speech-end','naya:audio-end','naya:voice-end'].forEach(function(name){window.addEventListener(name,onSpeechEnd)});
if(listen){listen.addEventListener('click',function(){setSpeaking(true);window.dispatchEvent(new CustomEvent('naya:listen',{detail:{source:'maxess-e01-section-01',score:resultState?resultState.overallScore:null}}));var result;if(window.Naya&&typeof window.Naya.listen==='function')result=window.Naya.listen();else if(window.nayaListen&&typeof window.nayaListen==='function')result=window.nayaListen();if(result&&typeof result.then==='function'){result.then(onSpeechEnd).catch(function(){onSpeechEnd()})}})}
})();
