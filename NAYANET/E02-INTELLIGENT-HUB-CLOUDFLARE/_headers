/* NayaNET Living Intelligence static delivery headers */
/* Canonical E02 runtime only. */
/
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  X-Frame-Options: SAMEORIGIN

/index.html
  Cache-Control: no-store

/nayanet-front-door-canonical.css
  Cache-Control: no-store

/nayanet-front-door-10-authority.css
  Cache-Control: no-store

/nayanet-10-experience.css
  Cache-Control: public, max-age=31536000, immutable
/nayanet-elite.css
  Cache-Control: public, max-age=31536000, immutable
/nayanet-mobile-overflow.css
  Cache-Control: public, max-age=31536000, immutable
/nayanet-intelligence-feed.css
  Cache-Control: public, max-age=31536000, immutable
/nayanet-living-entrance.css
  Cache-Control: public, max-age=31536000, immutable
/nayanet-10.js
  Cache-Control: public, max-age=31536000, immutable
/naya-data.js
  Cache-Control: public, max-age=300, must-revalidate
/nayanet-intelligence-feed.js
  Cache-Control: public, max-age=300, must-revalidate
/powercasts.json
  Cache-Control: public, max-age=3600, must-revalidate
