{
  "name": "nayanet-intelligent-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "python3 ../../scripts/build-smart-feed-projection.py && node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.mkdirSync('public/NAYANET',{recursive:true});fs.copyFileSync('../../scripts/nayanet-cognitive-engine.js','public/nayanet-cognitive-engine.js');fs.copyFileSync('../name-first-auth-adapter.js','public/NAYANET/name-first-auth-adapter.js');fs.copyFileSync('../../identity.html','public/identity.html')\" && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
