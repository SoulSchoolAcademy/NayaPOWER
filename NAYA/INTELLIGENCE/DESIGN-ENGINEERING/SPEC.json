{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nayanet://project-intelligence/design-engineering/spec-v1.1",
  "title": "Naya Design + Engineering Intelligence Specification",
  "version": "1.1",
  "status": "canonical",
  "purpose": "Machine-readable contract for designing, implementing, reviewing, verifying, and continuously improving NayaPOWER and NayaNET experiences.",
  "north_star": "Maximum useful quality per unit of necessary complexity.",
  "authority": {
    "current_standard_is_authority": true,
    "capability_does_not_create_authority": true,
    "filename_does_not_create_authority": true,
    "historical_intelligence_is_not_current_authority": true,
    "resolution_order": [
      "external_hard_constraints",
      "current_human_authority",
      "constitutional_governance",
      "current_repository_and_runtime_evidence",
      "current_design_engineering_standard",
      "product_specific_contracts",
      "current_mission_and_acceptance",
      "historical_intelligence",
      "assumptions"
    ]
  },
  "continuous_distillation": {
    "required_loop": ["optimize", "maximize", "synergize", "equalize", "balance", "tune", "distill", "update", "verify"],
    "new_information_protocol": ["compare", "identify_delta", "preserve_valid", "merge_useful", "retire_duplicate", "update_contracts", "verify", "record_provenance"],
    "no_parallel_duplicate_standards": true
  },
  "project_intelligence": {
    "unified_project_model": ["vision", "mission", "outcomes", "current_truth", "authority", "intelligence", "work", "evidence", "learning", "next_action"],
    "current_project_model": "NayaNET / NayaPOWER as one Project Intelligence environment",
    "library": {
      "path_model": "NAYA/INTELLIGENCE/LIBRARY/<PROJECT>/<CATEGORY>/<YEAR>/<MONTH>/<DAY>/<TIME>-<SLUG>.md",
      "metadata": ["project", "category", "year", "month", "day", "time", "title", "type", "status", "authority", "source", "provenance", "relationships", "privacy", "verification"],
      "retrieval_dimensions": ["project", "category", "date", "time", "type", "authority", "status", "relationship"],
      "date_is_not_authority": true,
      "duplicate_intelligence_is_forbidden": true
    },
    "brain_dump_to_project": true
  },
  "system_model": ["human_intent", "experience_design", "interaction", "state", "code", "engine", "runtime", "evidence", "verification", "learning", "compounding_intelligence"],
  "quality": {
    "target": "AAA",
    "service_target": "10-star",
    "definition": "maximum useful quality per unit of necessary complexity",
    "engineering_priority": ["human_outcome", "requirements", "correctness", "architecture", "security", "reliability", "maintainability", "performance", "usability_accessibility", "clarity", "elegance", "polish"],
    "design_priority": ["human_intent", "clarity", "hierarchy", "interaction", "feedback", "consequence", "accessibility", "performance", "emotional_quality", "polish"]
  },
  "design_language": {
    "identity": "living digital industrial design",
    "prime_law": "depth -> light -> state -> response -> consequence",
    "object_dimensions": ["material", "form", "depth", "light", "color", "state", "motion", "touch", "clarity", "consequence", "memory"],
    "material_stack": ["base", "inner_surface", "edge", "highlight", "shadow", "atmosphere"],
    "depth_levels": {"0": "background", "1": "environment", "2": "surface", "3": "interactive_object", "4": "intelligence_focal_point", "5": "active_consequence"},
    "light_layers": ["edge", "semantic", "atmospheric"],
    "color_semantics": {"obsidian": "foundation_depth", "white": "clarity_neutral", "silver": "precision_control", "green": "healthy_go_growth", "purple": "naya_intelligence_transformation", "magenta": "creation_energy_accent", "cyan": "connection_flow", "blue": "knowledge_trust", "red": "danger_destructive_state"},
    "color_rule": "color_must_not_be_the_only_carrier_of_important_meaning"
  },
  "interaction": {
    "minimum_state_machine": ["rest", "hover", "focus", "press", "processing", "success", "failure"],
    "extended_states": ["disabled", "authorized", "unauthorized", "queued", "blocked", "retryable", "partial", "complete"],
    "fundamental_transition": "intent -> response -> transformation",
    "truth_rule": "ui_must_never_claim_engine_success_without_engine_success"
  },
  "component_contract": {
    "required": ["purpose", "semantic_role", "states", "interaction", "accessibility", "responsive_behavior", "failure_behavior", "engine_binding", "verification"],
    "completion_questions": ["purpose_obvious", "hierarchy_clear", "material_intentional", "depth_meaningful", "light_meaningful", "color_meaningful", "states_explicit", "response_immediate", "press_physical_when_appropriate", "consequence_visible", "state_preserved", "accessible", "responsive", "engine_truthful", "failure_recoverable", "important_behavior_proven"]
  },
  "button": {
    "type": "power_object",
    "states": {
      "rest": ["dimensional_core", "restrained_edge", "semantic_light", "depth"],
      "hover": ["controlled_lift", "edge_response", "semantic_response", "shadow_change"],
      "focus": ["visible_keyboard_focus", "preserved_geometry", "non_color_only"],
      "press": ["physical_compression", "shadow_collapse", "immediate_feedback"],
      "processing": ["honest_busy_state", "duplicate_guard_when_required"],
      "success": ["engine_backed_consequence", "truthful_persistence"],
      "failure": ["local_explanation", "input_preservation", "recovery_path", "truthful_state"]
    }
  },
  "human_service": {
    "loop": ["understand", "anticipate", "act", "verify", "improve"],
    "minimum_question_rule": "ask_only_when_answer_materially_changes_safe_or_correct_outcome",
    "blocked_action_rule": ["blocked", "reason", "alternatives", "next_action"],
    "agency_rule": "human_remains_decision_maker_within_authority"
  },
  "engineering": {
    "laws": ["source_of_truth", "preserve_what_works", "smallest_coherent_change", "architecture_first", "single_source", "explicit_data_contracts", "least_privilege", "no_hard_coded_secrets", "intentional_failure", "explicit_state", "async_safety", "concurrency_safety", "dependency_minimization", "readability", "meaningful_tests", "measure_before_micro_optimization", "ai_generated_code_untrusted_until_verified"],
    "failure_protocol": ["observe", "localize", "explain", "root_cause", "repair", "test", "reverify", "prevent_recurrence"]
  },
  "verification": {
    "status_order": ["unknown", "documented", "implemented", "locally_tested", "remotely_observed", "live_verified"],
    "execution_chain": ["requested", "attempted", "executed", "observed", "verified"],
    "runtime_chain": ["source", "build_artifact", "deployment", "exact_runtime", "independent_observation", "verification"],
    "forbidden_inference": ["commit_exists_implies_runtime_verified", "build_passes_implies_product_verified", "ui_success_implies_engine_success", "document_exists_implies_capability_exists"]
  },
  "nayanet": {
    "engine": "NayaPOWER",
    "human_surface": "Intelligent Hub",
    "hub_rule": "projection_and_action_surface_not_source_of_truth",
    "smart_feed": "canonical_event -> projection -> human_view",
    "intelligence_today": "human_facing_intelligence_diary",
    "diary_principle": "your_intelligence_is_your_diary"
  },
  "privacy": {"rule": "private_by_default shared_by_choice collective_by_consent public_by_decision"},
  "maintenance": {
    "required_loop": ["search", "compare", "distill", "update_current_standard", "retire_duplicate", "verify"],
    "canonical_files": ["README.md", "CONSTITUTION.md", "SPEC.json", "PLAYBOOK.md"]
  }
}
