<script id="MAXESS-E00-01-BRIDGE-V10">
(function () {
  'use strict';

  if (window.__MAXESS_E00_01_BRIDGE_V10__) return;
  window.__MAXESS_E00_01_BRIDGE_V10__ = true;

  const BRIDGE = 'MAXESS-E00-01-BRIDGE-V10';
  const CONTRACT = 'MAXESS_RESULT_V1';
  const OFFICIAL_RESULT_EVENT = 'MAXESS_OFFICIAL_RESULT_READY';

  let officialResult = null;
  let released = false;
  let terminalTriggered = false;
  let terminalTimer = null;
  let terminalAttempt = 0;

  const TERMINAL_RETRY_DELAYS = [0, 20, 50, 100, 180, 300, 500];

  function getResult() {
    if (validResult(window.MAXESS_OFFICIAL_RESULT)) {
      return window.MAXESS_OFFICIAL_RESULT;
    }

    if (validResult(window.MAXESS_RESULT)) {
      return window.MAXESS_RESULT;
    }

    try {
      const stored = sessionStorage.getItem(CONTRACT);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (validResult(parsed)) {
          window.MAXESS_RESULT = parsed;
          return parsed;
        }
      }
    } catch (e) {}

    return null;
  }

  function validResult(result) {
    return !!result &&
      result.contractVersion === CONTRACT &&
      Number.isInteger(result.overallScore) &&
      result.overallScore >= 0 && result.overallScore <= 100 &&
      ['foundation', 'developing', 'advancing', 'mastery'].includes(result.masteryBand) &&
      Array.isArray(result.dimensions) && result.dimensions.length === 5 &&
      result.dimensions.every(function (d) {
        return d && Number.isInteger(d.score) && d.score >= 0 && d.score <= 100;
      }) &&
      Array.isArray(result.responses) && result.responses.length === 15 &&
      new Set(result.responses.map(function (r) { return r.questionId; })).size === 15;
  }

  function cloneResult(result) {
    try {
      return JSON.parse(JSON.stringify(result));
    } catch (e) {
      return null;
    }
  }

  function announceOfficial(result) {
    if (!validResult(result)) return false;

    const safeResult = cloneResult(result);
    if (!safeResult) return false;

    officialResult = safeResult;
    window.MAXESS_OFFICIAL_RESULT = officialResult;
    window.MAXESS_RESULT = officialResult;
    window.MAXESS_RESULTS_DATA = officialResult;
    window.MAXESS_RESULTS_BRIDGE = BRIDGE;

    try {
      sessionStorage.setItem(CONTRACT, JSON.stringify(officialResult));
    } catch (e) {}

    try {
      window.dispatchEvent(new CustomEvent(OFFICIAL_RESULT_EVENT, {
        detail: officialResult
      }));
    } catch (e) {}

    return true;
  }

  function isQ15() {
    const label = document.getElementById('progressLabel');
    return !!label && /^QUESTION\s+15\s+OF\s+15$/i.test((label.textContent || '').trim());
  }

  function clearTerminalTimer() {
    if (terminalTimer !== null) {
      clearTimeout(terminalTimer);
      terminalTimer = null;
    }
  }

  /*
   * CANONICAL TERMINAL TRIGGER
   *
   * The scoring authority remains E00 (E00.796 / MAXESS_AISCORE.publish).
   * E00.01 does NOT calculate, score, or manufacture a result.
   *
   * The important architectural change is timing:
   * Q15 answer selection is now the terminal signal. Once the user
   * selects an answer on Q15, E00.01 gives E00 a short, bounded window
   * to finish its own selection handler and then calls the existing
   * publish() authority. This removes the obsolete completion popup
   * dependency and the disabled-Q15-Continue deadlock.
   */
  function attemptTerminalPublish() {
    terminalTimer = null;

    if (!isQ15()) {
      terminalTriggered = false;
      terminalAttempt = 0;
      return;
    }

    const api = window.MAXESS_AISCORE;

    if (api && typeof api.publish === 'function') {
      try {
        const ok = api.publish();

        if (ok) {
          clearTerminalTimer();
          terminalTriggered = true;
          terminalAttempt = 0;
          console.log('[MAXESS BRIDGE] Q15 -> E00.publish() completed immediately.');
          return;
        }
      } catch (error) {
        console.warn('[MAXESS BRIDGE] E00.publish() attempt failed; retrying.', error);
      }
    }

    if (terminalAttempt < TERMINAL_RETRY_DELAYS.length - 1) {
      terminalAttempt += 1;
      terminalTimer = setTimeout(attemptTerminalPublish, TERMINAL_RETRY_DELAYS[terminalAttempt]);
      return;
    }

    terminalTriggered = false;
    terminalAttempt = 0;
    console.error('[MAXESS BRIDGE] Q15 terminal publish could not be completed inside the bounded execution window.');
  }

  function triggerTerminal() {
    if (terminalTriggered || !isQ15()) return;

    terminalTriggered = true;
    terminalAttempt = 0;
    clearTerminalTimer();

    /* Start after the target answer button's own onclick has run. */
    terminalTimer = setTimeout(attemptTerminalPublish, TERMINAL_RETRY_DELAYS[0]);
  }

  function terminalClick(event) {
    const target = event.target;
    const answer = target && target.closest && target.closest('#maxess-ai-score .answer');

    if (answer && isQ15()) {
      triggerTerminal();
      return;
    }

    /* Compatibility fallback: if a future E00 version exposes an
       enabled Q15 Continue button, this bridge still supports it. */
    const button = target && target.closest && target.closest('#maxess-ai-score #continueButton');

    if (!button || button.disabled || !isQ15()) return;

    event.preventDefault();
    event.stopPropagation();
    triggerTerminal();
  }

  /* Capture phase guarantees the terminal signal is seen before
     Webflow or other page-level click handlers can interfere. */
  document.addEventListener('click', terminalClick, true);

  function release(result) {
    if (released) return true;
    if (!validResult(result)) return false;

    const safeResult = cloneResult(result);
    if (!safeResult) return false;

    released = true;
    officialResult = safeResult;

    window.MAXESS_OFFICIAL_RESULT = officialResult;
    window.MAXESS_RESULT = officialResult;
    window.MAXESS_RESULTS_RELEASED = true;
    window.MAXESS_RESULTS_BRIDGE = BRIDGE;
    window.MAXESS_RESULTS_DATA = officialResult;

    try {
      sessionStorage.setItem(CONTRACT, JSON.stringify(officialResult));
    } catch (e) {}

    try {
      window.dispatchEvent(new CustomEvent('MAXESS_ISOLATION_RELEASE', {
        detail: {
          result: officialResult,
          contractVersion: CONTRACT,
          bridge: BRIDGE
        }
      }));
    } catch (e) {}

    try {
      window.dispatchEvent(new CustomEvent('MAXESS_RESULTS_READY', {
        detail: officialResult
      }));
    } catch (e) {}

    try {
      document.documentElement.setAttribute('data-maxess-results-state', 'released');
    } catch (e) {}

    console.log('[MAXESS BRIDGE] RESULTS RELEASED', officialResult.overallScore);
    return true;
  }

  function receiveResult(result) {
    if (!validResult(result)) return false;
    announceOfficial(result);
    return release(result);
  }

  window.addEventListener('MAXESS_RESULT_READY', function (event) {
    const result = event && event.detail;
    if (result && result.result) {
      receiveResult(result.result);
    } else {
      receiveResult(result);
    }
  });

  window.addEventListener('maxess:result-updated', function (event) {
    const result = event && event.detail;
    if (result && result.result) {
      receiveResult(result.result);
    } else {
      receiveResult(result);
    }
  });

  window.addEventListener('MAXESS_RESULTS_RELEASE', function (event) {
    const result = event && event.detail;
    if (result && result.result) {
      receiveResult(result.result);
    } else {
      receiveResult(result);
    }
  });

  window.addEventListener('MAXESS_OFFICIAL_RESULT_READY', function (event) {
    const result = event && event.detail;
    receiveResult(result && result.result ? result.result : result);
  });

  window.addEventListener('message', function (event) {
    const data = event && event.data;
    if (!data || typeof data !== 'object') return;

    if (
      data.type === 'MAXESS_RESULT_READY' ||
      data.type === 'MAXESS_OFFICIAL_RESULT_READY' ||
      data.type === 'MAXESS_ISOLATION_RELEASE'
    ) {
      receiveResult(data.result || data.payload || data.detail);
    }
  });

  window.MAXESS_E00_01 = {
    version: 10,
    contractVersion: CONTRACT,
    bridge: BRIDGE,
    getResult: getResult,
    isReady: function () {
      return validResult(officialResult);
    },
    release: function (result) {
      return receiveResult(result || getResult());
    },
    terminal: function () {
      if (!isQ15()) return false;
      terminalTriggered = false;
      triggerTerminal();
      return true;
    }
  };

  console.log('[MAXESS BRIDGE] E00.01 V10 initialized: Q15 answer -> E00 scoring authority -> MAXESS_RESULT_V1 -> E00.03/E00.02 -> E01-E09.');
})();
</script>
