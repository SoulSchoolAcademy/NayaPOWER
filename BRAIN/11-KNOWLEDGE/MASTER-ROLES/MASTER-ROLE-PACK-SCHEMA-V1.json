{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya.master-role-pack.v1",
  "title": "NayaPOWER Master Role Pack V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role_key",
    "title",
    "version",
    "status",
    "proof_state",
    "mission",
    "responsibility_boundary",
    "non_goals",
    "domain_knowledge",
    "first_principles",
    "mental_models",
    "diagnostic_questions",
    "decision_frameworks",
    "methods",
    "heuristics",
    "failure_modes",
    "anti_patterns",
    "tradeoffs",
    "evidence_hierarchy",
    "verification_requirements",
    "tools_and_capabilities",
    "collaboration_interfaces",
    "escalation_rules",
    "expected_outputs",
    "quality_gates",
    "learning_behavior",
    "proof_requirements",
    "refuses_to_assume",
    "applicability_signals",
    "conflict_handling",
    "authority_boundary",
    "source_lineage",
    "relationships",
    "canonical_object_refs"
  ],
  "properties": {
    "schema": {
      "const": "naya.master-role-pack.v1"
    },
    "role_key": {
      "type": "string",
      "pattern": "^master-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "CANDIDATE",
        "CANONICAL",
        "SUPERSEDED",
        "REVOKED"
      ]
    },
    "proof_state": {
      "enum": [
        "STRUCTURED",
        "VERIFIED",
        "PRODUCTION_PROVEN"
      ]
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "responsibility_boundary": {
      "type": "object",
      "required": [
        "owns",
        "does_not_own"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "does_not_own": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domain_knowledge": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_principles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mental_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostic_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heuristics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anti_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_hierarchy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools_and_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collaboration_interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning_behavior": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refuses_to_assume": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicability_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_handling": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "DERIVED_FROM",
              "SUPPORTS",
              "CONTRADICTS",
              "DEPENDS_ON",
              "IMPLEMENTS",
              "GOVERNS",
              "AUTHORIZED_BY",
              "USED_BY",
              "CAUSED",
              "RESULTED_IN",
              "VERIFIED_BY",
              "LEARNED_FROM",
              "SUPERSEDES",
              "SUCCEEDS",
              "RELATED_TO",
              "CONTEXTUALIZES",
              "INVALIDATES",
              "REFINES",
              "CORRECTS",
              "ENABLES",
              "PRODUCES",
              "APPLIES_TO"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "canonical_object_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^NAYA-[A-Z][A-Z0-9_]*-[0-9]{4,}$"
      }
    }
  }
}
