      },
      {
        "action": "STOP_AT_BOUNDARY",
        "id": "GATE-5-SECURITY-PRIVACY-AUTHORITY",
        "triggers": [
          "security_change",
          "privacy_change",
          "consent_change",
          "authority_envelope_change"
        ]
      }
    ],
    "handoff_format": {
      "required": [
        "direct_link",
        "exact_value_in_code_block",
        "numbered_steps"
      ],
      "rule": "ONE message. Never split link and value. Paste-clean for paste targets."
    }
  },
  "protocol": "TEAM-NAYA-OPERATING-PROTOCOL-ULTIMATE",
  "quality_gate": {
    "below_threshold_action": "RETURN_TO_BUILD \u2014 do not deliver",
    "pipeline": [
      "BUILD",
      "VERIFY",
      "SCORECARD",
      "GATE",
      "DELIVER"
