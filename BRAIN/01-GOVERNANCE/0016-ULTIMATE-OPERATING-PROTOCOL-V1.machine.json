  "truth_states": {
    "can_claim_works": {
      "BLOCKED": false,
      "CANDIDATE": false,
      "DOCUMENTED": false,
      "IMPLEMENTED": false,
      "PRODUCTION-PROVEN": true,
      "UNKNOWN": false,
      "VERIFIED": true
    },
    "strict_inequalities": [
      "IMPLEMENTED != VERIFIED",
      "VERIFIED != PRODUCTION-PROVEN",
      "STORED != LEARNED",
      "RETRIEVED != APPLIED",
      "DOCUMENTED != TRUE",
      "UNKNOWN != PASS",
      "BLOCKED != PASS",
      "CANDIDATE != RATIFIED"
    ],
    "valid_states": [
      "UNKNOWN",
      "DOCUMENTED",
      "IMPLEMENTED",
      "VERIFIED",
      "PRODUCTION-PROVEN",
      "BLOCKED",
