{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://naya.power/schemas/graph-query-v1.json",
  "title": "Graph Query",
  "description": "Defines the structure for graph queries that retrieve relevant intelligence by semantic, structural, relational, and contextual relevance.",
  "type": "object",
  "required": ["query_id", "query_type", "target", "context"],
  "properties": {
    "query_id": {
      "type": "string",
      "description": "Unique identifier for this query"
    },
    "query_type": {
      "type": "string",
      "enum": ["SEMANTIC", "STRUCTURAL", "RELATIONAL", "CONTEXTUAL", "HYBRID"],
      "description": "Type of query being performed"
    },
    "target": {
      "type": "object",
      "properties": {
        "object_id": { "type": "string", "description": "Specific object to query about" },
        "object_type": { "type": "string", "description": "Type of objects to retrieve" },
        "relationship_type": { "type": "string", "description": "Type of relationships to traverse" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "current_objective": { "type": "string" },
        "current_domain": { "type": "string" },
        "known_constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "epistemic_states": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Filter by epistemic state"
        },
        "knowledge_types": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Filter by knowledge type"
        },
        "freshness_threshold": {
          "type": "string",
          "format": "date-time",
          "description": "Minimum freshness for results"
        },
        "include_superseded": {
          "type": "boolean",
          "default": false
        },
        "include_contradicted": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "traversal": {
      "type": "object",
      "properties": {
        "max_depth": { "type": "integer", "default": 3 },
        "relationship_types": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relationship types to follow"
        },
        "direction": {
          "type": "string",
          "enum": ["OUTGOING", "INCOMING", "BOTH"],
          "default": "BOTH"
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["actor"],
      "properties": {
        "actor": { "type": "string" },
        "scope": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
