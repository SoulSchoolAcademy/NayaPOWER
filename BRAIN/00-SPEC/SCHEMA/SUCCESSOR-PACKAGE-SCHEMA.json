{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://naya.power/schemas/successor-package-v1.json",
  "title": "Successor Package",
  "description": "Defines the structure for successor packages that ensure continuity across context death and system restarts.",
  "type": "object",
  "required": ["package_id", "created_at", "identity_context", "current_reality", "applicable_intelligence", "authority_context", "unresolved_uncertainty", "recent_outcomes", "verified_learning", "active_work", "constraints", "proof_summary", "next_actions"],
  "properties": {
    "package_id": {
      "type": "string",
      "description": "Unique identifier for this successor package"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this package was created"
    },
    "identity_context": {
      "type": "object",
      "required": ["actor", "system", "mission"],
      "properties": {
        "actor": { "type": "string" },
        "system": { "type": "string" },
        "mission": { "type": "string" },
        "continuity_context": { "type": "string" }
      }
    },
    "current_reality": {
      "type": "object",
      "properties": {
        "operational_state": { "type": "string" },
        "active_incidents": { "type": "array", "items": { "type": "string" } },
        "deployment_state": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "applicable_intelligence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "object_type", "epistemic_state"],
        "properties": {
          "object_id": { "type": "string" },
          "object_type": { "type": "string" },
          "epistemic_state": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "authority_context": {
      "type": "object",
      "properties": {
        "active_authorities": { "type": "array", "items": { "type": "string" } },
        "pending_authorizations": { "type": "array", "items": { "type": "string" } },
        "revoked_authorities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unresolved_uncertainty": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known unknowns and unresolved questions"
    },
    "recent_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "outcome_id": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "verified_learning": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "learning_id": { "type": "string" },
          "lesson": { "type": "string" },
          "applicability": { "type": "string" }
        }
      }
    },
    "active_work": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "work_id": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string" },
          "blockers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "proof_summary": {
      "type": "object",
      "properties": {
        "verified_count": { "type": "integer" },
        "unverified_count": { "type": "integer" },
        "contradicted_count": { "type": "integer" }
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "priority": { "type": "string" },
          "authority_required": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
