{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://naya.power/schemas/proof-record-v1.json",
  "title": "Proof Record",
  "description": "Defines the structure for proof records that establish evidence chains for claims.",
  "type": "object",
  "required": ["proof_id", "claim", "epistemic_state", "evidence", "verification_method", "scope", "created_at", "status"],
  "properties": {
    "proof_id": {
      "type": "string",
      "description": "Unique identifier for this proof record"
    },
    "claim": {
      "type": "string",
      "description": "The claim being proven or disproven"
    },
    "epistemic_state": {
      "type": "string",
      "enum": ["UNKNOWN", "UNVERIFIED", "CLAIMED", "SUPPORTED", "VERIFIED", "DISPUTED", "CONTRADICTED", "CORRECTED", "SUPERSEDED", "RETRACTED", "STALE", "CONTEXT_BOUND", "BLOCKED", "REVOKED"],
      "description": "Current epistemic state of the claim"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "source", "strength"],
        "properties": {
          "evidence_id": { "type": "string" },
          "source": { "type": "string" },
          "strength": { "type": "string", "enum": ["WEAK", "MODERATE", "STRONG", "CONCLUSIVE"] },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Evidence supporting or contradicting the claim"
    },
    "verification_method": {
      "type": "string",
      "description": "Method used to verify the claim"
    },
    "scope": {
      "type": "string",
      "description": "Scope within which this proof is valid"
    },
    "verifier": {
      "type": "string",
      "description": "Entity that performed verification"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this proof record was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this proof record was last updated"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "SUPERSEDED", "RETRACTED", "EXPIRED"],
      "description": "Current status of this proof record"
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known limitations of this proof"
    },
    "unresolved_gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Gaps that prevent full verification"
    }
  },
  "additionalProperties": false
}
