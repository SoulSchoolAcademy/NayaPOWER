{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "naya.kernel.connect/v1",
  "title": "CONNECT Node",
  "type": "object",
  "required": ["node_id", "connection_context", "state"],
  "properties": {
    "node_id": {"const": "NAYA-KERNEL-CONNECT"},
    "connection_context": {
      "type": "object",
      "properties": {
        "source_object": {"type": "string"},
        "relationship_type": {"enum": ["SUPPORTS", "REFINES", "DERIVES_FROM", "CONTRADICTS", "SUPERSEDES", "APPLIES_TO", "PRODUCED", "CAUSED", "ENABLES", "REQUIRES", "EXEMPLIFIES", "INVALIDATES", "LEARNS_FROM", "RELATED_TO"]},
        "target_object": {"type": "string"},
        "provenance": {"type": "object"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "state": {"enum": ["UNINITIALIZED", "RESOLVING", "CONNECTED", "CONFLICTED", "FAILED"]},
    "graph_health": {"type": "object"},
    "reconciliation_context": {"type": "object"}
  },
  "additionalProperties": false
}