{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "naya.kernel.law/v1",
  "title": "LAW Node",
  "type": "object",
  "required": ["node_id", "decision", "authority_context", "state"],
  "properties": {
    "node_id": {"const": "NAYA-KERNEL-LAW"},
    "decision": {"enum": ["AUTHORIZED", "DENIED", "REQUIRES_CONFIRMATION", "AMBIGUOUS", "EXPIRED", "REVOKED", "OUT_OF_SCOPE"]},
    "authority_context": {
      "type": "object",
      "required": ["actor", "action", "scope", "grant_id"],
      "properties": {
        "actor": {"type": "string"},
        "action": {"type": "string"},
        "scope": {"type": "string"},
        "grant_id": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "revoked": {"type": "boolean"},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "state": {"enum": ["UNINITIALIZED", "RESOLVING", "DECIDED", "ESCALATED", "FAILED"]},
    "rationale": {"type": "string"},
    "audit_trail": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}