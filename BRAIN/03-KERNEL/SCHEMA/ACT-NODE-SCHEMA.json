{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "naya.kernel.act/v1",
  "title": "ACT Node",
  "type": "object",
  "required": ["node_id", "action_context", "execution_state", "state"],
  "properties": {
    "node_id": {"const": "NAYA-KERNEL-ACT"},
    "action_context": {
      "type": "object",
      "required": ["action_id", "action_type", "target", "authority_decision"],
      "properties": {
        "action_id": {"type": "string", "format": "uuid"},
        "action_type": {"type": "string"},
        "target": {"type": "string"},
        "authority_decision": {"$ref": "naya.kernel.law/v1"},
        "reversibility": {"enum": ["REVERSIBLE", "IRREVERSIBLE", "UNKNOWN"]},
        "expected_outcome": {"type": "string"},
        "proof_requirements": {"type": "array", "items": {"type": "string"}}
      }
    },
    "execution_state": {"enum": ["PLANNED", "EXECUTING", "COMPLETED", "FAILED", "ROLLED_BACK"]},
    "state": {"enum": ["UNINITIALIZED", "PLANNING", "EXECUTING", "COMPLETED", "FAILED"]},
    "receipt": {"type": "object"},
    "observation_target": {"type": "string"}
  },
  "additionalProperties": false
}