{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "naya.kernel.verify/v1",
  "title": "VERIFY Node",
  "type": "object",
  "required": ["node_id", "verification_context", "state"],
  "properties": {
    "node_id": {"const": "NAYA-KERNEL-VERIFY"},
    "verification_context": {
      "type": "object",
      "required": ["expected_outcome", "observed_outcome", "outcome_status"],
      "properties": {
        "expected_outcome": {"type": "string"},
        "observed_outcome": {"type": "string"},
        "outcome_status": {"enum": ["SUCCESS", "FAILURE", "INCONCLUSIVE", "NOT_PROVEN"]},
        "acceptance_decision": {"enum": ["ACCEPTED", "REJECTED", "PENDING"]},
        "causal_evidence_status": {"enum": ["NOT_CLAIMED", "CLAIMED", "VERIFIED", "UNVERIFIED", "CONTRADICTED"]},
        "unresolved_gaps": {"type": "array", "items": {"type": "string"}},
        "verification_receipt": {"type": "object"}
      }
    },
    "state": {"enum": ["UNINITIALIZED", "VERIFYING", "VERIFIED", "INCONCLUSIVE", "FAILED"]},
    "independent_verifier": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}