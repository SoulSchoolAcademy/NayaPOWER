{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "naya.kernel.learn/v1",
  "title": "LEARN Node",
  "type": "object",
  "required": ["node_id", "learning_context", "state"],
  "properties": {
    "node_id": {"const": "NAYA-KERNEL-LEARN"},
    "learning_context": {
      "type": "object",
      "required": ["candidate_id", "source_outcome", "learning_state"],
      "properties": {
        "candidate_id": {"type": "string", "format": "uuid"},
        "source_outcome": {"type": "string"},
        "learning_state": {"enum": ["CANDIDATE", "VERIFIED", "REJECTED", "CONTRADICTED", "PROMOTED"]},
        "applicability_conditions": {"type": "array", "items": {"type": "string"}},
        "behavioral_effect_measurement": {"type": "object"},
        "compounding_evidence": {"type": "object"}
      }
    },
    "state": {"enum": ["UNINITIALIZED", "CANDIDATE", "VERIFYING", "PROMOTED", "REJECTED", "FAILED"]},
    "promotion_gate": {"type": "object"}
  },
  "additionalProperties": false
}