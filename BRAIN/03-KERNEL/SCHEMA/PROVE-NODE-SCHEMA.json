{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "naya.kernel.prove/v1",
  "title": "PROVE Node",
  "type": "object",
  "required": ["node_id", "proof_context", "state"],
  "properties": {
    "node_id": {"const": "NAYA-KERNEL-PROVE"},
    "proof_context": {
      "type": "object",
      "required": ["claim", "evidence", "epistemic_state"],
      "properties": {
        "claim": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "object"}},
        "epistemic_state": {"enum": ["UNKNOWN", "CLAIMED", "SUPPORTED", "VERIFIED", "CONTRADICTED", "UNVERIFIED"]},
        "claim_strength": {"enum": ["WEAK", "MODERATE", "STRONG"]},
        "evidence_strength": {"enum": ["WEAK", "MODERATE", "STRONG"]},
        "verification_method": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "object"}}
      }
    },
    "state": {"enum": ["UNINITIALIZED", "ASSESSING", "ASSESSED", "CONFLICTED", "FAILED"]},
    "provenance_chain": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}