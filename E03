<section id="e03" aria-labelledby="e03-title" data-stage="waiting">
  <div class="e03-stage">
    <div class="e03-light" aria-hidden="true"></div>
    <main class="e03-report">
      <header class="e03-header">
        <img class="e03-logo" src="https://i.postimg.cc/Twqw14vv/ICON-LOGO.png" alt="MAXESS" loading="eager">
