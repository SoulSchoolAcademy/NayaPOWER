<script>
(function(){
  'use strict';
  const root=document.getElementById('e03');
  if(!root)return;

  const STAGES={foundation:'Foundation Stage',developing:'Developing Stage',advancing:'Advancing Stage',mastery:'Mastery Stage'};
  const NARRATIVES={
    foundation:{blocks:[
      {p:"I've looked at your results, and I want you to know something right away. You're currently in what we call the <strong>Foundation stage.</strong>"},
      {p:"That doesn't mean you're bad at AI. And it certainly doesn't mean you can't become excellent at it."},
      {p:"It simply means you're still building the fundamentals that allow AI to work at its highest level for you."},
      {p:"Right now, you may be using AI to get answers, create things, or help you complete tasks. But you may not yet be consistently directing it, evaluating what it gives you, refining the work, and guiding the process toward the result you actually want."},
      {pause:"And that's the opportunity."},
      {p:"You don't need to become more technical. You need a better way of working with the intelligence that's already available to you."},
      {p:"That's exactly what the MAXESS method is designed to help you develop."},
      {p:"It's a battle-tested approach to thinking with AI — giving it better direction, asking better questions, looking carefully at what it produces, scoring the result, improving it, and repeating that process until the work becomes exceptional."},
      {p:"And here's something I really want you to notice: <strong>You're experiencing that approach right now.</strong>"},
      {p:"This assessment isn't simply telling you where you are. It's beginning to show you how powerful AI can become when you have a deliberate process for working with it."},
      {p:"You have a foundation."},
      {p:"<strong>Now let's build something extraordinary on it.</strong>"}
    ]},
    developing:{blocks:[
      {p:"I've looked at your results, and you're currently in the <strong>Developing stage.</strong>"},
      {p:"And I actually like this stage because it means something important: <strong>You've already discovered that AI can do far more than simply answer questions.</strong>"},
      {p:"You're beginning to direct it, experiment with it, and use it to create better results."},
      {p:"But there's still a gap between what you're capable of getting from AI and what you're consistently getting from it."},
      {p:"That's completely normal. Most people never learn how to close that gap."},
      {p:"They learn a few prompts. They discover a few tricks. They get occasional great results. But they don't have a repeatable system for producing exceptional work."},
      {pause:"That's where your next level is."},
      {p:"The MAXESS approach is built around a simple idea: exceptional results don't happen by accident."},
      {p:"You give AI clear direction. You tell it what matters. You ask intelligently. You look at what it produces. You score the result. You improve it. And you repeat until the work reaches the standard you're looking for."},
      {p:"It's a simple process, but when you apply it consistently, something changes."},
      {p:"<strong>AI stops feeling like a tool you're experimenting with and starts becoming an intelligence you know how to work with.</strong>"},
      {p:"And you're actually experiencing that process right now."},
      {p:"So your result isn't a ceiling. <strong>It's a starting point for becoming much more powerful with AI.</strong>"}
    ]},
    advancing:{blocks:[
      {p:"I've looked at your results, and you're currently in the <strong>Advancing stage.</strong>"},
      {p:"And that tells me something important."},
      {pause:"You already know how to work with AI."},
      {p:"You can direct it. You can recognize useful output. You can shape a conversation and turn AI into something more than a simple question-and-answer machine."},
      {p:"You've developed real capability."},
      {p:"But here's where it gets interesting."},
      {p:"At this level, the biggest gains don't usually come from learning more AI tricks."},
      {p:"They come from becoming more deliberate."},
      {list:['Better direction.','Better evaluation.','Better refinement.','Better consistency.']},
      {p:"Because there's a difference between getting an impressive result from AI occasionally and being able to produce exceptional results <strong>reliably.</strong>"},
      {p:"That's the gap the MAXESS method is designed to close."},
      {p:"It's a battle-tested protocol built around a simple principle: <strong>Don't settle for the first good answer.</strong>"},
      {p:"Direct the work. Look at it critically. Score it. Ask what's missing. Improve it. Then do it again."},
      {p:"That's how good becomes excellent."},
      {p:"And that's why I want you to pay attention to what you're experiencing right now."},
      {p:"This assessment itself is an example of that philosophy."},
      {p:"We're not simply giving you an answer. We're looking at the result, interpreting the pattern, identifying the opportunity, and showing you what to do next."},
      {p:"<strong>You already have significant capability.</strong>"},
      {p:"Now imagine what happens when you pair that capability with a proven system for consistently getting more from AI."},
      {pause:"That's where your next level begins."}
    ]},
    mastery:{blocks:[
      {p:"I've looked at your results, and you're currently in the <strong>Mastery stage.</strong>"},
      {p:"That's significant."},
      {p:"You've developed the ability to work with AI deliberately, critically, and creatively."},
      {p:"You understand that the quality of the result depends heavily on the quality of the direction, the thinking, the evaluation, and the refinement behind it."},
      {pause:"You don't simply use AI. You know how to work with it."},
      {p:"But mastery has an interesting quality."},
      {p:"The better you become, the more you realize there's always another level available."},
      {p:"At this stage, the question isn't really whether you can get excellent results. You can."},
      {p:"The question becomes: <strong>Can you make exceptional results repeatable?</strong>"},
      {p:"Can you build systems around your thinking? Can you teach what you've learned? Can you turn your capability into something that compounds?"},
      {p:"That's where the MAXESS protocol becomes especially powerful."},
      {p:"It's not designed to replace your intelligence. <strong>It's designed to amplify it.</strong>"},
      {p:"Direction. Ask. Look. Score. Improve. Repeat."},
      {p:"The process is simple. The depth you can reach with it isn't."},
      {p:"And you're experiencing that philosophy right now."},
      {p:"This assessment isn't the end of your journey. <strong>It's evidence of what you're already capable of — and an invitation to see how far you can take it.</strong>"},
      {p:"You've built the capability."},
      {pause:"Now let's turn that capability into mastery you can repeat, teach, and use to create extraordinary results."}
    ]}
  };

  function normalizeStage(score,explicit){
    const raw=String(explicit||'').trim().toLowerCase();
    if(Object.prototype.hasOwnProperty.call(STAGES,raw))return raw;
    if(!Number.isFinite(score))return null;
    if(score<50)return 'foundation';
    if(score<75)return 'developing';
    if(score<90)return 'advancing';
    return 'mastery';
  }

  function getResult(){
    try{
      const external=window.MAXESS_RESULT;
      return external&&typeof external==='object'?external:null;
    }catch(error){
      return null;
    }
  }

  function render(result){
    const stageName=document.getElementById('e03-stage-name');
    const stageLabel=document.getElementById('e03-stage-label');
    const footerStage=document.getElementById('e03-footer-stage');
    const letter=document.getElementById('e03-letter');
    const hook=document.getElementById('e03-audio-hook');
    if(!result){
      root.dataset.stage='waiting';
      stageName.dataset.state='waiting';
      stageLabel.textContent='Awaiting your MAXESS result';
      footerStage.textContent='RESULT PENDING';
      letter.innerHTML='<p>MAXESS is waiting for your real assessment result. No score or narrative is invented here.</p>';
      hook.dataset.section='E03';
      hook.dataset.narrativeId='';
      hook.dataset.audioId='';
      return;
    }

    const score=Number(result.overallScore);
    const stage=normalizeStage(score,result.masteryStage||result.stage||result.masteryBand);
    if(!Number.isFinite(score)||!stage){
      root.dataset.stage='waiting';
      stageName.dataset.state='waiting';
      stageLabel.textContent='Result received — awaiting valid MAXESS data';
      footerStage.textContent='RESULT VALIDATION';
      letter.innerHTML='<p>MAXESS received a result, but the result is not complete enough to create this report section.</p>';
      return;
    }

    root.dataset.stage=stage;
    stageName.dataset.state='ready';
    stageLabel.textContent=STAGES[stage];
    footerStage.textContent=stage.toUpperCase()+' · PERSONAL REPORT';

    const blocks=NARRATIVES[stage].blocks;
    letter.innerHTML=blocks.map(function(block){
      if(block.pause)return '<div class="e03-pause"><strong>'+block.pause+'</strong></div>';
      if(block.list)return '<ul class="e03-list">'+block.list.map(function(x){return '<li>'+x+'</li>';}).join('')+'</ul>';
      return '<p>'+block.p+'</p>';
    }).join('');

    const naya=result.naya&&typeof result.naya==='object'?result.naya:null;
    hook.dataset.section='E03';
    hook.dataset.narrativeId=naya&&naya.narrativeId?naya.narrativeId:'e03_'+stage+'_v1';
    hook.dataset.audioId=naya&&naya.audioId?naya.audioId:'';
  }

  document.getElementById('e03-print').addEventListener('click',function(){window.print();});
  render(getResult());
  window.addEventListener('MAXESS_RESULT_READY',function(event){render((event.detail&&typeof event.detail==='object')?event.detail:getResult());});
  window.addEventListener('maxess:result-updated',function(event){render((event.detail&&typeof event.detail==='object')?event.detail:getResult());});
  window.addEventListener('storage',function(){render(getResult());});
})();
</script>
<script data-maxess-result-consumer="v3">
(function(){
  'use strict';
  if(window.__MAXESS_RESULT_CONSUMER_V3__) return;
  window.__MAXESS_RESULT_CONSUMER_V3__ = true;

  var CONTRACT='MAXESS_RESULT_V1';
  var READY='MAXESS_RESULT_READY';
  var UPDATED='maxess:result-updated';
  var STORAGE_KEY='MAXESS_RESULT_V1';
  var lastSignature='';
  var timer=null;
  var attempts=0;

  function emit(name, detail){
    try{ window.dispatchEvent(new CustomEvent(name,{detail:detail||null})); }
    catch(e){ try{ window.dispatchEvent(new Event(name)); }catch(_){} }
  }

  function decode(value){
    var s=String(value||'').replace(/-/g,'+').replace(/_/g,'/');
    while(s.length%4) s+='=';
    var binary=atob(s), bytes='';
    for(var i=0;i<binary.length;i++) bytes+='%'+('00'+binary.charCodeAt(i).toString(16)).slice(-2);
    return decodeURIComponent(bytes);
  }

  function payload(){
    var hash=window.location.hash||'';
    var m=hash.match(/(?:^#|&)maxess-result=([^&]+)/i);
    if(!m) return null;
    try{return decodeURIComponent(m[1]);}catch(e){return m[1];}
  }

  function valid(r){
    if(!r||typeof r!=='object'||r.contractVersion!==CONTRACT) return false;
    var overall=Number(r.overallScore);
    if(!Number.isFinite(overall)||overall<0||overall>100) return false;
    if(!Array.isArray(r.dimensions)||r.dimensions.length!==5) return false;
    if(!Array.isArray(r.responses)||r.responses.length!==15) return false;
    for(var i=0;i<5;i++){
      var d=r.dimensions[i];
      if(!d||typeof d.name!=='string'||!d.name.trim()) return false;
      var score=Number(d.score);
      if(!Number.isFinite(score)||score<0||score>100) return false;
    }
    return true;
  }

  function sig(r){
    try{return [r.contractVersion,Number(r.overallScore),r.masteryBand||'',r.dimensions.map(function(d){return String(d.name)+':'+Number(d.score);}).join('|'),r.responses.length].join('::');}
    catch(e){return '';}
  }

  function publish(r,source,force){
    if(!valid(r)) return false;
    var s=sig(r), changed=s!==lastSignature;
    window.MAXESS_RESULT=r;
    try{sessionStorage.setItem(STORAGE_KEY,JSON.stringify(r));}catch(e){}
    if(changed||force){
      lastSignature=s;
      emit(READY,{result:r,source:source||'hash'});
      emit(UPDATED,{result:r,source:source||'hash'});
    }
    return true;
  }

  function consume(){
    var raw=payload();
    if(raw){
      try{var r=JSON.parse(raw);if(publish(r,'hash',false)) return true;}catch(e){}
    }
    try{var stored=JSON.parse(sessionStorage.getItem(STORAGE_KEY)||'null');if(publish(stored,'session',false)) return true;}catch(e){}
    return false;
  }

  function run(){
    var ok=consume();
    if(ok) emit(UPDATED,{result:window.MAXESS_RESULT,source:'hydration'});
    attempts++;
    if(attempts<80) timer=window.setTimeout(run,250);
  }

  window.MAXESS_RESULT_CONSUMER_V3={consume:consume,get:function(){return window.MAXESS_RESULT||null;},contractVersion:CONTRACT,version:'V3'};
  window.addEventListener('hashchange',function(){attempts=0;lastSignature='';if(timer)clearTimeout(timer);run();});
  window.addEventListener('pageshow',function(){attempts=0;run();});
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',function(){attempts=0;run();},{once:true});
  else run();
})();
</script>
</body>
