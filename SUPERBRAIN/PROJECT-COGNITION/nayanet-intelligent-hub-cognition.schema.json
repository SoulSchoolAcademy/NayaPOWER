{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nayanet-intelligent-hub-cognition-v1",
  "title": "NayaNET Intelligent Hub Persistent Cognition State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "mission", "current_state", "cognition", "execution", "handoff", "audit"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "north_star"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "north_star": {"type": "string", "minLength": 1}
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "desired_state", "success_criteria"],
      "properties": {
        "goal": {"type": "string"},
        "desired_state": {"type": "string"},
        "success_criteria": {"type": "array", "items": {"type": "string"}}
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verified", "unknowns", "active_block", "protected_baseline"],
      "properties": {
        "status": {"enum": ["VERIFIED", "PARTIAL", "BLOCKED", "FAILED"]},
        "verified": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}},
        "active_block": {"type": "string"},
        "protected_baseline": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["situation", "action", "history", "objective", "confidence", "matters", "self_evaluation", "next_action", "result", "change"],
      "properties": {
        "situation": {"type": "string"},
        "action": {"type": "string"},
        "history": {"type": "string"},
        "objective": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_basis": {"type": "array", "items": {"type": "string"}},
        "matters": {"type": "array", "items": {"type": "string"}},
        "self_evaluation": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string"},
        "result": {"type": "string"},
        "change": {"type": "string"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_action", "expected_result", "authorization_boundary", "evidence_refs", "lessons"],
      "properties": {
        "last_action": {"type": "string"},
        "expected_result": {"type": "string"},
        "authorization_boundary": {"enum": ["L1", "L2", "L3"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "lessons": {"type": "array", "items": {"type": "string"}},
        "decisions": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "remaining_work", "next_naya_instruction"],
      "properties": {
        "status": {"enum": ["READY", "IN_PROGRESS", "BLOCKED"]},
        "remaining_work": {"type": "array", "items": {"type": "string"}},
        "next_naya_instruction": {"type": "string", "minLength": 1}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "last_actor", "last_updated", "event_id"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "last_actor": {"type": "string"},
        "last_updated": {"type": "string", "format": "date-time"},
        "event_id": {"type": "string"}
      }
    }
  }
}
