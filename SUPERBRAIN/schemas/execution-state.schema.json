{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nayanet.technology/schemas/naya-execution-state.schema.json",
  "title": "Team Naya Execution State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "repository",
    "branch",
    "current_head",
    "production_head",
    "deployment",
    "active_block",
    "block_status",
    "owner",
    "start_head",
    "target_state",
    "dependencies",
    "protected_scope",
    "evidence",
    "checkpoint",
    "unknowns",
    "failures",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "branch": { "type": "string", "minLength": 1 },
    "current_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "production_head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "deployment": { "type": ["object", "null"] },
    "active_block": { "type": "string", "minLength": 1 },
    "block_status": { "enum": ["PENDING", "ACTIVE", "VERIFIED", "BLOCKED", "FAILED", "SUPERSEDED"] },
    "owner": { "type": "string", "minLength": 1 },
    "start_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target_state": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "protected_scope": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "checkpoint": { "type": ["object", "null"] },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "failures": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
