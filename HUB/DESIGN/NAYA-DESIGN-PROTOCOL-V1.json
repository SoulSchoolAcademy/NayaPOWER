      "pass": "loading/processing/connected/verified motion and labels exist only while applicable backend/runtime evidence supports them and terminate/change on resolved/error"
    },
    "P03": {
      "measure": "CONTROL_ACTIVATION_TRACE",
      "pass": "each required apparently-live control produces operation->observation->result->state/evidence, or renders explicit unavailable/blocked state"
    },
    "P04": {
      "measure": "APPLICABLE_STATE_MATRIX",
      "pass": "all applicable truth and interaction states declared by protocol are rendered/tested; missing state fails"
    },
    "P05": {
      "measure": "REQUIRED_VIEWPORT_BROWSER_MATRIX",
      "pass": "at 320/375/390/430/768/820 and required zoom, no unintended horizontal overflow and hierarchy/location/primary action remain usable"
    },
    "P06": {
      "measure": "KEYBOARD_FOCUS_JOURNEY",
      "pass": "all required controls reachable, focus visible, semantics correct, no trap, activation/recovery possible without pointer"
    },
    "P07": {
      "measure": "EXACT_BASELINE_COMPARISON_PLUS_INDEPENDENT_RESCORE",
      "pass": "no hard-gate regression and no protected material dimension/signature/accessibility/performance/truth regression"
    },
    "P08": {
      "measure": "D1_D8_AND_V1_V10_EVIDENCE_SCORE",
      "pass": "acceptance requires each material D1-D8>=9.5 and all hard gates; Signature/Masterpiece additionally D1=10, V1-V9>=9.5, V10=10"
    },
    "P09": {
      "measure": "SMART_BOARD_STRUCTURE_CHECK",
      "pass": "exactly eight canonical intelligence layers in required order; furniture/extensions are not counted as layers; no fifteen-layer canonical claim"
    },
    "P10": {
      "measure": "FREEZE_ARTIFACT_HASH_AND_REVIEW_SET",
      "pass": "spec + annotated visual + machine contract are present and synchronized; any material change invalidates the corresponding freeze until counterpart artifacts are updated/reviewed"
    },
    "P11": {
      "measure": "COMPLETION_MATRIX_COVERAGE",
      "pass": "all declared required rooms/surfaces/journeys remain machine-visible until their proof gate closes; no slice silently reduces scope"
    },
    "P12": {
      "measure": "REVIEWER_SEPARATION_AND_EXACT_SHA_RECOMPUTATION",
      "pass": "a different reviewer/process inspects exact SHA, rendered artifact where applicable, predicates/evidence, and can return FAIL/UNKNOWN/BLOCKED"
    }
  }
}
