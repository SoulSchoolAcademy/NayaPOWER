{
  "amendment_protocol": "amend by scored evidence only; PR against HUB/DESIGN-LAWS/ with scorecard attached",
  "board": {
    "anatomy_order": [
      "rail",
      "wash",
      "identity_row",
      "headline",
      "meta",
      "nutshell",
      "layers",
      "actions",
      "provenance_footer"
    ],
    "headline": {
      "letter_spacing_em": -0.055,
      "line_height": 1.0,
      "max_width_px": 820,
      "size": "clamp(30px, 3.6vw, 50px)",
      "weight": 800
    },
    "inner_max_width_px": [
      860,
      980
    ],
    "layout": "full-bleed section, never grid card",
    "max_layers": 3,
    "nutshell": {
      "color": "#eeeaf2",
      "line_height": 1.7,
      "max_words": 60,
      "paragraphs": 1,
      "size_px": 17,
      "well": {
        "background": "#08080d",
        "border": "2px solid #ffffff16",
        "radius_px": 18
      }
    },
    "padding_desktop": "46px 42px 50px 46px",
    "padding_mobile": "36px 24px",
    "separator": "1px solid #ffffff12",
    "text_floor_px": 10
  },
  "button": {
    "flat_banned": true,
    "hierarchy": {
      "ghost": "quiet/secondary, no glow until hover",
      "primary_catch": {
        "background": "linear-gradient(145deg,#ffe1a1,#e8c766 60%,#c79a35)",
        "border": "2px solid #e8c76688",
        "max_per_viewport": 1,
        "text": "#1a1206"
      },
      "standard": "see standard"
    },
    "on_states": {
      "ask": {
        "background": "tone@16%",
        "border": "var(--tone)",
        "text": "#ffffff"
      },
      "default": {
        "background": "#0a1710",
        "border": "#55e39a",
        "text": "#c9ffdf"
      },
      "love": {
        "background": "#170a0d",
        "border": "#ff5e6c",
        "text": "#ffb4bd"
      }
    },
    "standard": {
      "background": "linear-gradient(145deg, #14131c, #08080c)",
      "border": "2px solid #8b63ff55",
      "hover": {
        "border_color": "var(--tone)",
        "glow": "0 0 24px tone@28%",
        "translateY_px": -2
      },
      "label": {
        "letter_spacing_em": 0.1,
        "size_px": 10,
        "weight": 800
      },
      "min_height_px": 44,
      "padding": "0 18px",
      "radius_px": 12,
      "shadow": "inset 0 1px #fff3, 0 8px 18px #0007",
      "sheen": "radial-gradient(circle at 50% 0%, #fff7, transparent 30%)"
    }
  },
  "glyph": {
    "background": "radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--tone) 26%, transparent), #09090e 72%)",
    "border": "2px solid color-mix(in srgb, var(--tone) 55%, #fff 10%)",
    "icon": {
      "color": "var(--tone)",
      "size_px": [
        24,
        26
      ],
      "stroke": [
        1.7,
        1.8
      ]
    },
    "radius_px": [
      14,
      15
    ],
    "shadow": "inset 0 1px #fff4, 0 10px 26px #0009, 0 0 22px tone@22%",
    "size_px": [
      45,
      52
    ]
  },
  "motion": {
    "decorative_animation": "banned",
    "ease": "cubic-bezier(.16,.84,.22,1)",
    "hover_lift_px": -2,
    "micro_s": 0.2,
    "overlay_s": 0.32,
    "reduced_motion": "all transitions/animations none"
  },
  "precedence": [
    "law-zero",
    "design-north-star",
    "design-laws-v1",
    "room-specs"
