{
  "registry": "smart-builder/functions/v1",
  "authority": "Shawn Vibert — amendable only through Shawn",
  "locked": "2026-10-17",
  "law": "No interface ships without its functions wired. Plumbing before paint — a page that can't operate is not a page.",
  "groups": {
    "intake": {
      "intent": "Fill the contract. Every function writes into the same contract schema — nothing lives outside it.",
      "functions": [
        {
          "id": "intake.ask",
          "name": "Ask — questions mode",
          "intent": "Draw out intent, vision, goal, function in plain words.",
          "in": [
            "session"
          ],
          "out": [
            "contract.intent",
            "contract.words"
          ],
          "activated_by": "human picks questions mode",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "intake.show_specimens",
          "name": "Show me — specimens mode",
          "intent": "Real library pieces as multiple choice; the human points at what they like.",
          "in": [
            "session"
          ],
          "out": [
            "contract.picks"
          ],
          "activated_by": "human picks specimens mode",
          "status": "specified",
          "code": null,
          "depends_on": [
            "library.browse"
          ]
        },
        {
          "id": "intake.dictate",
          "name": "Talk — dictation mode",
          "intent": "Talk the page into existence; words land in the contract like images do.",
          "in": [
            "audio"
          ],
          "out": [
            "contract.words"
          ],
          "activated_by": "human picks dictation mode",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "intake.attach_media",
          "name": "Attach media",
          "intent": "Images uploaded in chat attach to the contract; the build applies them.",
          "in": [
            "images"
          ],
          "out": [
            "contract.media"
          ],
          "activated_by": "human uploads images",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "intake.attach_links",
          "name": "Attach links",
          "intent": "Social and other links land in contract fields; the build wires them in.",
          "in": [
            "urls"
          ],
          "out": [
            "contract.links"
          ],
          "activated_by": "human enters links",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "intake.attach_words",
          "name": "Attach words",
          "intent": "Page copy from talking, pasting, or a doc lands in the contract.",
          "in": [
            "text"
          ],
          "out": [
            "contract.words"
          ],
          "activated_by": "human talks/pastes/shares doc",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "intake.propose_skeleton",
          "name": "Propose skeleton",
          "intent": "The builder proposes page structure from intent; the human approves or rearranges.",
          "in": [
            "contract.intent"
          ],
          "out": [
            "contract.structure"
          ],
          "activated_by": "contract has intent",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "intake.set_address",
          "name": "Set address",
          "intent": "The page's address goes in the contract (nayanet.live/anything).",
          "in": [
            "address string"
          ],
          "out": [
            "contract.address"
          ],
          "activated_by": "human names the address",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "intake.set_icon",
          "name": "Set app icon",
          "intent": "Upload at exact size, or Naya generates the image for the page.",
          "in": [
            "image or prompt"
          ],
          "out": [
            "contract.icon"
          ],
          "activated_by": "human uploads or asks Naya",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "intake.revise",
          "name": "Revise in plain words",
          "intent": "After the first build, changes happen in plain words. No intake redo.",
          "in": [
            "note"
          ],
          "out": [
            "contract.diff"
          ],
          "activated_by": "human writes a change note",
          "status": "specified",
          "code": null,
          "depends_on": [
            "customize.apply_note"
          ]
        },
        {
          "id": "intake.finalize",
          "name": "Finalize — human says build",
          "intent": "Two authors, one finalizer. Only the human fires the build.",
          "in": [
            "contract complete"
          ],
          "out": [
            "build.assemble trigger"
          ],
          "activated_by": "human says 'okay, build' (button or word)",
          "status": "specified",
          "code": null,
          "depends_on": []
        }
      ]
    },
    "library": {
      "intent": "Resolve parts. Every piece comes from the library by model number — never recreated, never improvised.",
      "functions": [
        {
          "id": "library.search",
          "name": "Search pieces",
          "intent": "Type 'buttons' — all buttons. Reads human labels, model numbers, styles, colors.",
          "in": [
            "query"
          ],
          "out": [
            "ranked pieces"
          ],
          "activated_by": "human types in builder search",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "library.browse",
          "name": "Browse gallery",
          "intent": "Gallery sub-pages per category — every piece rendered in its real code.",
          "in": [
            "category"
          ],
          "out": [
            "piece grid"
          ],
          "activated_by": "human opens a category",
          "status": "specified",
          "code": null,
          "depends_on": [
            "library.resolve"
          ]
        },
        {
          "id": "library.recommend",
          "name": "Recommend pieces",
          "intent": "Human states intent; Naya recommends pieces by name and model number.",
          "in": [
            "contract.intent"
          ],
          "out": [
            "recommended models"
          ],
          "activated_by": "intake has intent",
          "status": "specified",
          "code": null,
          "depends_on": [
            "library.search"
          ]
        },
        {
          "id": "library.resolve",
          "name": "Resolve piece",
          "intent": "Model number in, real HTML + real CSS out. A lookup, not a judgment call.",
          "in": [
            "model"
          ],
          "out": [
            "html",
            "css"
          ],
          "activated_by": "assembler or browser asks",
          "status": "built",
          "code": "HUB/design-system/library/catalog/builder-index-v1.json",
          "depends_on": []
        },
        {
          "id": "library.verify",
          "name": "Verify pieces present",
          "intent": "Every piece verified present in the library before assembly. No hand-writing.",
          "in": [
            "model list"
          ],
          "out": [
            "pass/fail + gaps"
          ],
          "activated_by": "before assemble",
          "status": "built",
          "code": "HUB/design-system/tools/smart-builder/verify-build.py",
          "depends_on": []
        }
      ]
    },
    "template": {
      "intent": "Start from finished. Twelve pre-done templates; pick one and it's already a page.",
      "functions": [
        {
          "id": "template.list",
          "name": "List templates",
          "intent": "The twelve templates, most common first, each with its shape.",
          "in": [],
          "out": [
            "12 templates"
          ],
          "activated_by": "builder opens",
          "status": "built",
          "code": "HUB/design-system/tools/smart-builder/contracts/smart-builder-v1.json#templates",
          "depends_on": []
        },
        {
          "id": "template.pick",
          "name": "Pick template",
          "intent": "Template choice seeds the contract — structure, sections, default pieces.",
          "in": [
            "template id"
          ],
          "out": [
            "contract seeded"
          ],
          "activated_by": "human picks a template",
          "status": "specified",
          "code": null,
          "depends_on": [
            "library.resolve"
          ]
        },
        {
          "id": "template.swap_piece",
          "name": "Swap piece",
          "intent": "Any piece in the tray swaps into the template. Same contract, new part.",
          "in": [
            "model",
            "slot"
          ],
          "out": [
            "contract updated"
          ],
          "activated_by": "human taps + Add / swap",
          "status": "specified",
          "code": null,
          "depends_on": [
            "library.resolve"
          ]
        },
        {
          "id": "template.note",
          "name": "Note on template/piece",
          "intent": "'I want button XYZ here' / 'make this one coral' — plain words into the contract.",
          "in": [
            "note",
            "target"
          ],
          "out": [
            "contract.notes[]"
          ],
          "activated_by": "human writes a note",
          "status": "specified",
          "code": null,
          "depends_on": []
        }
      ]
    },
    "customize": {
      "intent": "Your words are the editor. Change anything — or change nothing and just say what you want.",
      "functions": [
        {
          "id": "customize.color",
          "name": "Change color",
          "intent": "Any piece, any spectrum color — or let Naya pick what fits.",
          "in": [
            "model",
            "color"
          ],
          "out": [
            "contract.diff"
          ],
          "activated_by": "human names a color",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "customize.position",
          "name": "Change position",
          "intent": "Move things where the human wants them; layout follows words.",
          "in": [
            "model",
            "position"
          ],
          "out": [
            "contract.diff"
          ],
          "activated_by": "human names a position",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "customize.apply_note",
          "name": "Apply note",
          "intent": "A plain-words note becomes a contract edit. The mechanism behind revise + template notes.",
          "in": [
            "note"
          ],
          "out": [
            "contract.diff"
          ],
          "activated_by": "any note lands",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "customize.name_function",
          "name": "Name the function",
          "intent": "'I want this page but personal to me' — a complete instruction.",
          "in": [
            "plain words"
          ],
          "out": [
            "contract.diff"
          ],
          "activated_by": "human states a want",
          "status": "specified",
          "code": null,
          "depends_on": [
            "customize.apply_note"
          ]
        }
      ]
    },
    "build": {
      "intent": "Contract in, page out. Deterministic, scored, receipted — the program, not a person.",
      "functions": [
        {
          "id": "build.assemble",
          "name": "Assemble",
          "intent": "Contract data + library index + template in; finished page + manifest out. Same inputs, same bytes.",
          "in": [
            "contract",
            "index",
            "template"
          ],
          "out": [
            "page.html",
            "manifest"
          ],
          "activated_by": "intake.finalize fires",
          "status": "built",
          "code": "HUB/design-system/tools/smart-builder/assemble.py",
          "depends_on": []
        },
        {
          "id": "build.verify",
          "name": "Verify build",
          "intent": "No empty placeholders, JS parses, every piece resolves, the page renders.",
          "in": [
            "page",
            "manifest"
          ],
          "out": [
            "pass/fail"
          ],
          "activated_by": "after assemble",
          "status": "built",
          "code": "HUB/design-system/tools/smart-builder/verify-build.py",
          "depends_on": []
        },
        {
          "id": "build.scorecard",
          "name": "Scorecard gate",
          "intent": "The rendered page gets scored. 9+ ships; below 9 goes back with the why-not-10.",
          "in": [
            "page"
          ],
          "out": [
            "score"
          ],
          "activated_by": "after verify",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "build.preview",
          "name": "Preview",
          "intent": "The human sees the page before it goes anywhere. Nobody deploys what nobody has seen.",
          "in": [
            "page"
          ],
          "out": [
            "human yeah/no"
          ],
          "activated_by": "score 9+",
          "status": "specified",
          "code": null,
          "depends_on": []
        },
        {
          "id": "build.deploy",
          "name": "Deploy",
          "intent": "The human's 'yeah' fires the deploy through the pipeline. Live on its own, no re-asking.",
          "in": [
            "page",
            "approval"
          ],
          "out": [
            "live url"
          ],
          "activated_by": "human approves preview",
          "status": "specified",
          "code": null,
          "depends_on": [
            "systems.cloudflare_pipeline"
          ]
        },
        {
          "id": "build.receipt",
          "name": "Receipt",
          "intent": "Contract hash, library version, piece manifest, score. Reproducible down to the byte.",
          "in": [
            "build data"
          ],
          "out": [
            "manifest"
          ],
          "activated_by": "after deploy",
          "status": "built",
          "code": "HUB/design-system/tools/smart-builder/assemble.py#manifest",
          "depends_on": []
        }
      ]
    },
