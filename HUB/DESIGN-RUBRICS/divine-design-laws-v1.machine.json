  "sections": [
    {
      "id": "visual",
      "name": "Visual Laws - the awe standard",
      "law_range": "DL-001-DL-010",
      "truth_states": {
        "TIMELESS": 10
      },
      "laws": [
        {
          "id": "DL-001",
          "section": "visual",
          "number": 1,
          "text": "Design for awe at first glance - the first 3 seconds decide.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-002",
          "section": "visual",
          "number": 2,
          "text": "White space like a Zen master - restraint is luxury.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-003",
          "section": "visual",
          "number": 3,
          "text": "Color = consciousness: purple=power, blue=trust, gold=divinity; palette order black,white,purple,blues,green,gold; purple accent/glow only, never solid fill.",
          "truth_state": "TIMELESS",
          "note": "canvas superseded: black, not white"
        },
        {
          "id": "DL-004",
          "section": "visual",
          "number": 4,
          "text": "Consistency is king - one visual language everywhere.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-005",
          "section": "visual",
          "number": 5,
          "text": "Typography speaks soul - type carries emotion, not just information.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-006",
          "section": "visual",
          "number": 6,
          "text": "Animate with intention - every motion communicates state.",
          "truth_state": "TIMELESS",
          "note": "cf. PB-084"
        },
        {
          "id": "DL-007",
          "section": "visual",
          "number": 7,
          "text": "Use real faces, real people - avatar + human fusion; Naya's picture welcomes the user by name on first Hub entry.",
          "truth_state": "TIMELESS",
          "note": "identity-page authority"
        },
        {
          "id": "DL-008",
          "section": "visual",
          "number": 8,
          "text": "Self-explaining icons - no icon needs a manual.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-009",
          "section": "visual",
          "number": 9,
          "text": "Hierarchy = harmony - visual weight matches importance.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-010",
          "section": "visual",
          "number": 10,
          "text": "Design like Apple x Tesla x Avatar - the craft bar.",
          "truth_state": "TIMELESS"
        }
      ]
    },
    {
      "id": "intuitive_ux",
      "name": "Intuitive UX Laws - the clarity test",
      "law_range": "DL-011-DL-020",
      "truth_states": {
        "TIMELESS": 10
      },
      "laws": [
        {
          "id": "DL-011",
          "section": "intuitive_ux",
          "number": 11,
          "text": "The user always knows: What is this? Why does it matter? What do I do now?",
          "truth_state": "TIMELESS",
          "note": "acceptance test for every page"
        },
        {
          "id": "DL-012",
          "section": "intuitive_ux",
          "number": 12,
          "text": "3 clicks or less to any primary outcome.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-013",
          "section": "intuitive_ux",
          "number": 13,
          "text": "Zero learning curve - a new user succeeds without instruction.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-014",
          "section": "intuitive_ux",
          "number": 14,
          "text": "Every action gives feedback - no silent taps.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-015",
          "section": "intuitive_ux",
          "number": 15,
          "text": "Never dead-end - every state offers a next step.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-016",
          "section": "intuitive_ux",
          "number": 16,
          "text": "Gamify decisions - progress visible, effort rewarded.",
          "truth_state": "TIMELESS",
          "note": "bound by DL-087"
        },
        {
          "id": "DL-017",
          "section": "intuitive_ux",
          "number": 17,
          "text": "Onboarding is activation - first-time = delight + clarity.",
          "truth_state": "TIMELESS",
          "note": "onboarding XP mission statement"
        },
        {
          "id": "DL-018",
          "section": "intuitive_ux",
          "number": 18,
          "text": "Personalize on sight - the interface knows who it serves.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-019",
          "section": "intuitive_ux",
          "number": 19,
          "text": "Ask before telling - invite, don't lecture.",
          "truth_state": "TIMELESS"
        },
        {
          "id": "DL-020",
          "section": "intuitive_ux",
          "number": 20,
          "text": "Navigation is sacred geometry - fixed, learnable, never shuffled.",
          "truth_state": "TIMELESS"
        }
      ]
    },
