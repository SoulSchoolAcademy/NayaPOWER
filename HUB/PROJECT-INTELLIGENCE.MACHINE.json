 "visual_bliss_law": {
  "precedence": "supreme — outranks spectrum, depth, and motion choices",
  "test": "Using the interface must feel effortless on the eyes: contrast, clarity, cleanliness.",
  "rules": {
   "VB-1": "Contrast first. If a glow, accent, depth effect, or background treatment makes anything harder to read, the treatment loses — remove or redesign it. No exceptions.",
   "VB-2": "Generous type by default. Most people cannot see small print. When in doubt, go bigger.",
   "VB-3": "One clear hierarchy per surface. A glance must answer: what is this, what matters most, what can I do.",
   "VB-4": "Cleanliness. Every element earns its place.",
   "VB-5": "Clarity over cleverness. A plain readable screen beats a spectacular confusing one."
  },
  "type_minima_px": {
   "body": 15,
   "small": 13,
   "micro": 11.5,
   "absolute_minimum": 11
  }
 },
 "color_dominance": {
  "dominant": [
   "purple",
   "black",
   "white"
  ],
  "complementary": "the twelve-color spectrum — semantic, supporting, never dominating",
  "rules": {
   "CD-1": "Purple, black, and white carry the visual weight: surfaces, primary text, primary actions, brand presence.",
   "CD-2": "The spectrum is complementary — it communicates meaning (room identity, board energy, state), never dominates.",
   "CD-3": "Yellow and gold are the most restrained accents: small semantic markers only (hairline, dot, status tick). Never body text. Never large surfaces. Never more prominent than purple/black/white.",
   "CD-4": "Meaning before decoration, always. A color that does not communicate something true is decoration — remove it."
  }
 }
