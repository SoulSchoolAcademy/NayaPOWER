          var targetId = link.getAttribute("href");

          if (!targetId || targetId === "#") {
            return;
          }

          var target = document.querySelector(targetId);

          if (!target) {
            return;
          }

          event.preventDefault();

          var bar = app.querySelector(".np-appbar");
          var offset = bar ? bar.offsetHeight + 10 : 10;

          var position =
            target.getBoundingClientRect().top +
            window.pageYOffset -
            offset;

          window.scrollTo({
            top: position,
            behavior: "smooth"
          });

        });

      });


      /*
       * =======================================================
       * FAQ ACCORDIONS
       * =======================================================
       */

      var faqButtons = app.querySelectorAll(
        ".np-faq-question"
      );

      faqButtons.forEach(function (button) {

        button.addEventListener("click", function () {

          var item = button.closest(".np-faq-item");

          if (!item) {
            return;
          }

          var wasOpen =
            item.classList.contains("open");

          app.querySelectorAll(".np-faq-item").forEach(
            function (other) {

              other.classList.remove("open");

            }
          );

          if (!wasOpen) {
            item.classList.add("open");
          }

        });

      });


      /*
       * =======================================================
       * REVEAL ANIMATION
       * =======================================================
       */

      var revealItems = app.querySelectorAll(
        ".np-reveal"
      );

      if ("IntersectionObserver" in window) {

        var observer =
          new IntersectionObserver(
            function (entries) {

              entries.forEach(function (entry) {

                if (entry.isIntersecting) {

                  entry.target.classList.add(
                    "np-visible"
                  );

                  observer.unobserve(
                    entry.target
                  );

                }

              });

            },
            {
              threshold: 0.08,
              rootMargin: "0px 0px -40px 0px"
            }
          );

        revealItems.forEach(function (item) {

          observer.observe(item);

        });

      } else {

        revealItems.forEach(function (item) {

          item.classList.add("np-visible");

        });

      }


      /*
       * =======================================================
       * HASH ON LOAD
       * =======================================================
       */

      if (window.location.hash) {

        window.setTimeout(
          function () {

            var target =
              document.querySelector(
                window.location.hash
              );

            if (target) {

              var bar =
                app.querySelector(
                  ".np-appbar"
                );

              var offset =
                bar
                  ? bar.offsetHeight + 10
                  : 10;

              window.scrollTo(
                0,
                target.getBoundingClientRect().top +
                window.pageYOffset -
                offset
              );

            }

          },
          250
        );

      }

    })();
  </script>

</div>
