<div id="naya-power-app">

  <style>
    /* =========================================================
       NAYA POWER
       GROOVEPAGES PRODUCTION BUILD
       ========================================================= */

    #naya-power-app {
      --np-black: #08070c;
      --np-black-2: #111019;
      --np-purple: #2c183f;
      --np-purple-2: #6e459b;
      --np-purple-3: #a66fe0;
      --np-purple-light: #d9bcff;
      --np-white: #f8f5fb;
      --np-ink: #18131f;
      --np-muted: #c8bfce;
      --np-gold: #d7b979;
      --np-line-dark: rgba(255,255,255,.11);
      --np-line-light: rgba(55,35,70,.14);
      --np-bar: 72px;

      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      box-sizing: border-box;

      background: var(--np-black);
      color: var(--np-white);

      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Arial,
        sans-serif;

      overflow: hidden;
    }

    #naya-power-app *,
    #naya-power-app *::before,
    #naya-power-app *::after {
      box-sizing: border-box;
    }

    #naya-power-app img {
      display: block;
      max-width: 100%;
    }

    #naya-power-app a {
      color: inherit;
      text-decoration: none;
    }

    #naya-power-app button {
      font: inherit;
    }

    /* =========================================================
       GLOBAL
       ========================================================= */

    #naya-power-app .np-container {
      width: min(1180px, calc(100% - 40px));
      margin: 0 auto;
    }

    #naya-power-app .np-serif {
      font-family:
        Georgia,
        "Times New Roman",
        serif;
      font-weight: 400;
    }

    #naya-power-app .np-kicker {
      display: inline-flex;
      align-items: center;
      gap: 10px;

      margin-bottom: 18px;

      color: var(--np-purple-light);

      font-size: 12px;
      line-height: 1;
      letter-spacing: .22em;
      text-transform: uppercase;
      font-weight: 700;
    }

    #naya-power-app .np-kicker::before {
      content: "";
      width: 28px;
      height: 1px;
      background: currentColor;
      opacity: .7;
    }

    #naya-power-app h1,
    #naya-power-app h2,
    #naya-power-app h3,
    #naya-power-app p {
      margin-top: 0;
    }

    #naya-power-app h1,
    #naya-power-app h2,
    #naya-power-app h3 {
      margin-bottom: 0;
    }

    #naya-power-app .np-body {
      color: var(--np-muted);
      font-size: 17px;
      line-height: 1.75;
    }

    #naya-power-app .np-body strong {
      color: var(--np-white);
    }

    #naya-power-app .np-title {
      font-size: clamp(42px, 6vw, 78px);
      line-height: .98;
      letter-spacing: -.035em;
    }

    #naya-power-app .np-section-title {
      max-width: 850px;
      font-size: clamp(38px, 5vw, 68px);
      line-height: 1.02;
      letter-spacing: -.025em;
    }

    #naya-power-app .np-rule {
      width: 64px;
      height: 1px;
      margin: 28px 0;
      background: var(--np-purple-3);
    }

    /* =========================================================
       TOP NAVIGATION
       ========================================================= */

    #naya-power-app .np-appbar {
      position: sticky;
      top: 0;
      z-index: 9999;

      width: 100%;

      background: rgba(8,7,12,.94);
      border-bottom: 1px solid var(--np-line-dark);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    #naya-power-app .np-appbar-inner {
      min-height: var(--np-bar);

      display: flex;
      align-items: center;
      gap: 22px;

      padding: 0 24px;
    }

    #naya-power-app .np-brand {
      flex: 0 0 auto;

      display: flex;
      align-items: center;
      gap: 10px;

      font-size: 12px;
      font-weight: 800;
      letter-spacing: .18em;
      white-space: nowrap;
    }

    #naya-power-app .np-brand-mark {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--np-purple-3);
      box-shadow: 0 0 18px rgba(166,111,224,.55);
    }

    #naya-power-app .np-nav {
      flex: 1 1 auto;

      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4px;

      overflow-x: auto;
      scrollbar-width: none;
    }

    #naya-power-app .np-nav::-webkit-scrollbar {
      display: none;
    }

    #naya-power-app .np-nav a {
      padding: 9px 11px;

      color: #d7d0dc;

      border-radius: 999px;

      font-size: 11px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;

      white-space: nowrap;

      transition:
        color .2s ease,
        background .2s ease;
    }

    #naya-power-app .np-nav a:hover {
      color: #fff;
      background: rgba(166,111,224,.13);
    }

    #naya-power-app .np-top-actions {
      flex: 0 0 auto;

      display: flex;
      align-items: center;
      gap: 8px;
    }

    #naya-power-app .np-mini-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 38px;
      padding: 0 14px;

      border: 1px solid rgba(255,255,255,.18);
      border-radius: 999px;

      color: #fff;
      background: transparent;

      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;

      white-space: nowrap;

      transition:
        transform .2s ease,
        background .2s ease,
        border-color .2s ease;
    }

    #naya-power-app .np-mini-btn:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,.08);
      border-color: rgba(255,255,255,.35);
    }

    #naya-power-app .np-mini-btn.primary {
      background: var(--np-purple-3);
      border-color: var(--np-purple-3);
      color: #fff;
    }

    /* =========================================================
       HERO
       ========================================================= */

    #naya-power-app .np-hero {
      position: relative;
      min-height: 88vh;

      display: flex;
      align-items: center;

      background:
        radial-gradient(
          circle at 75% 30%,
          rgba(110,69,155,.28),
          transparent 42%
        ),
        var(--np-black);
    }

    #naya-power-app .np-hero-grid {
      min-height: 88vh;

      display: grid;
      grid-template-columns: 1.05fr .95fr;
      align-items: center;
      gap: 70px;

      padding: 90px 0;
    }

    #naya-power-app .np-hero-copy {
      position: relative;
      z-index: 2;
    }

    #naya-power-app .np-hero-copy h1 {
      margin-bottom: 26px;
    }

    #naya-power-app .np-hero-copy .np-body {
      max-width: 670px;
      font-size: 19px;
    }

    #naya-power-app .np-hero-media {
      position: relative;
    }

    #naya-power-app .np-hero-media::after {
      content: "";
      position: absolute;
      inset: 12px -12px -12px 12px;

      border: 1px solid rgba(166,111,224,.34);
      pointer-events: none;
    }

    #naya-power-app .np-hero-media img {
      position: relative;
      z-index: 1;

      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;

      filter: saturate(.9);
    }

    #naya-power-app .np-hero-label {
      margin-top: 24px;

      color: var(--np-gold);

      font-size: 12px;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */

    #naya-power-app .np-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;

      margin-top: 34px;
    }

    #naya-power-app .np-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;

      min-height: 50px;
      padding: 0 22px;

      border: 1px solid rgba(255,255,255,.18);
      border-radius: 999px;

      color: #fff;
      background: transparent;

      font-size: 11px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;

      transition:
        transform .2s ease,
        background .2s ease,
        border-color .2s ease,
        box-shadow .2s ease;
    }

    #naya-power-app .np-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(255,255,255,.38);
      background: rgba(255,255,255,.07);
    }

    #naya-power-app .np-btn.primary {
      border-color: var(--np-purple-3);
      background: var(--np-purple-3);
      box-shadow: 0 12px 35px rgba(166,111,224,.18);
    }

    #naya-power-app .np-btn.primary:hover {
      background: #b27ae9;
    }

    #naya-power-app .np-btn.gold {
      border-color: var(--np-gold);
      color: var(--np-gold);
    }

    /* =========================================================
       SECTION SYSTEM
       ========================================================= */

    #naya-power-app .np-section {
      position: relative;

      padding: 110px 0;
    }

    #naya-power-app .np-black {
      background: var(--np-black);
      color: var(--np-white);
    }

    #naya-power-app .np-dark {
      background: var(--np-black-2);
      color: var(--np-white);
    }

    #naya-power-app .np-purple {
      background: var(--np-purple);
      color: var(--np-white);
    }

    #naya-power-app .np-white {
      background: var(--np-white);
      color: var(--np-ink);
    }

    #naya-power-app .np-white .np-kicker {
      color: var(--np-purple-2);
    }

    #naya-power-app .np-white .np-body {
      color: #62586a;
    }

    #naya-power-app .np-white .np-rule {
      background: var(--np-purple-2);
    }

    #naya-power-app .np-index {
      position: absolute;
      top: 36px;
      right: 24px;

      color: rgba(255,255,255,.24);

      font-size: 11px;
      font-weight: 800;
      letter-spacing: .2em;
    }

    #naya-power-app .np-white .np-index {
      color: rgba(24,19,31,.24);
    }

    #naya-power-app .np-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 70px;
      align-items: center;
    }

    #naya-power-app .np-grid.reverse .np-media {
      order: 2;
    }

    #naya-power-app .np-grid.reverse .np-copy {
      order: 1;
    }

    #naya-power-app .np-media {
      position: relative;
    }

    #naya-power-app .np-media img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }

    #naya-power-app .np-media-frame::after {
      content: "";
      position: absolute;
      inset: 14px -14px -14px 14px;

      border: 1px solid rgba(166,111,224,.4);
      pointer-events: none;
    }

    #naya-power-app .np-copy {
      position: relative;
      z-index: 1;
    }

    #naya-power-app .np-copy .np-body {
      max-width: 680px;
    }

    /* =========================================================
       PULL QUOTES
       ========================================================= */

    #naya-power-app .np-pullquote {
      margin: 34px 0 0;
      padding: 24px 0 0;

      border-top: 1px solid rgba(255,255,255,.16);

      color: #fff;

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: clamp(24px, 3vw, 38px);
      line-height: 1.18;
      font-style: italic;
    }

    #naya-power-app .np-white .np-pullquote {
      border-color: var(--np-line-light);
      color: var(--np-ink);
    }

    /* =========================================================
       CARDS
       ========================================================= */

    #naya-power-app .np-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;

      margin-top: 48px;
    }

    #naya-power-app .np-card {
      min-height: 210px;

      padding: 28px;

      border: 1px solid var(--np-line-dark);

      background: rgba(255,255,255,.035);
    }

    #naya-power-app .np-white .np-card {
      border-color: var(--np-line-light);
      background: rgba(44,24,63,.035);
    }

    #naya-power-app .np-card-number {
      color: var(--np-purple-light);

      font-size: 11px;
      font-weight: 800;
      letter-spacing: .16em;
    }

    #naya-power-app .np-white .np-card-number {
      color: var(--np-purple-2);
    }

    #naya-power-app .np-card h3 {
      margin: 20px 0 12px;

      font-size: 24px;
      line-height: 1.05;
    }

    #naya-power-app .np-card p {
      margin: 0;

      color: var(--np-muted);

      font-size: 15px;
      line-height: 1.65;
    }

    #naya-power-app .np-white .np-card p {
      color: #6d6375;
    }

    /* =========================================================
       PROCESS
       ========================================================= */

    #naya-power-app .np-process {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;

      margin-top: 48px;
    }

    #naya-power-app .np-process-item {
      position: relative;

      padding: 24px 16px;

      border: 1px solid var(--np-line-dark);

      background: rgba(255,255,255,.035);
    }

    #naya-power-app .np-white .np-process-item {
      border-color: var(--np-line-light);
      background: rgba(44,24,63,.035);
    }

    #naya-power-app .np-process-item span {
      display: block;
      margin-bottom: 12px;

      color: var(--np-purple-light);

      font-size: 10px;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    #naya-power-app .np-white .np-process-item span {
      color: var(--np-purple-2);
    }

    #naya-power-app .np-process-item strong {
      font-size: 16px;
      line-height: 1.2;
    }

    /* =========================================================
       TIMELINE
       ========================================================= */

    #naya-power-app .np-timeline {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 0;

      margin-top: 48px;

      border-top: 1px solid var(--np-line-dark);
      border-bottom: 1px solid var(--np-line-dark);
    }

    #naya-power-app .np-white .np-timeline {
      border-color: var(--np-line-light);
    }

    #naya-power-app .np-time {
      position: relative;

      min-height: 150px;
      padding: 28px 18px;

      border-right: 1px solid var(--np-line-dark);
    }

    #naya-power-app .np-white .np-time {
      border-color: var(--np-line-light);
    }

    #naya-power-app .np-time:last-child {
      border-right: 0;
    }

    #naya-power-app .np-time strong {
      display: block;
      margin-bottom: 12px;

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 24px;
    }

    #naya-power-app .np-time span {
      color: var(--np-muted);
      font-size: 13px;
      line-height: 1.5;
    }

    #naya-power-app .np-white .np-time span {
      color: #6d6375;
    }

    /* =========================================================
       BIG STATEMENT
       ========================================================= */

    #naya-power-app .np-statement {
      max-width: 980px;
      margin: 0 auto;

      text-align: center;
    }

    #naya-power-app .np-statement h2 {
      font-size: clamp(42px, 6vw, 82px);
      line-height: 1;
      letter-spacing: -.04em;
    }

    #naya-power-app .np-statement p {
      max-width: 760px;
      margin: 30px auto 0;

      color: var(--np-muted);

      font-size: 18px;
      line-height: 1.75;
    }

    #naya-power-app .np-purple .np-statement p {
      color: #ddd1e7;
    }

    /* =========================================================
       FAQ
       ========================================================= */

    #naya-power-app .np-faq {
      max-width: 920px;
      margin: 50px auto 0;
    }

    #naya-power-app .np-faq-item {
      border-top: 1px solid var(--np-line-light);
    }

    #naya-power-app .np-faq-item:last-child {
      border-bottom: 1px solid var(--np-line-light);
    }

    #naya-power-app .np-faq-question {
      width: 100%;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;

      padding: 23px 0;

      border: 0;

      color: var(--np-ink);
      background: transparent;

      text-align: left;
      cursor: pointer;

      font-size: 18px;
      font-weight: 700;
    }

    #naya-power-app .np-faq-icon {
      flex: 0 0 auto;

      width: 30px;
      height: 30px;

      display: grid;
      place-items: center;

      border: 1px solid rgba(55,35,70,.25);
      border-radius: 50%;

      font-size: 18px;
      line-height: 1;

      transition: transform .2s ease;
    }

    #naya-power-app .np-faq-item.open .np-faq-icon {
      transform: rotate(45deg);
    }

    #naya-power-app .np-faq-answer {
      display: none;

      padding: 0 50px 24px 0;

      color: #6d6375;

      font-size: 16px;
      line-height: 1.75;
    }

    #naya-power-app .np-faq-item.open .np-faq-answer {
      display: block;
    }

    /* =========================================================
       FINAL CTA
       ========================================================= */

    #naya-power-app .np-final {
      position: relative;
      overflow: hidden;
    }

    #naya-power-app .np-final-grid {
      display: grid;
      grid-template-columns: 1.15fr .85fr;
      gap: 60px;
      align-items: center;
    }

    #naya-power-app .np-final-copy h2 {
      max-width: 850px;
    }

    #naya-power-app .np-final-copy p {
      max-width: 680px;
      margin-top: 28px;

      color: var(--np-muted);

      font-size: 19px;
      line-height: 1.7;
    }

    #naya-power-app .np-final-media img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }

    /* =========================================================
       FOOTER
       ========================================================= */

    #naya-power-app .np-footer {
      padding: 42px 0;

      border-top: 1px solid var(--np-line-dark);

      background: #050409;
    }

    #naya-power-app .np-footer-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    #naya-power-app .np-footer-brand {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .18em;
    }

    #naya-power-app .np-footer-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 18px;
    }

    #naya-power-app .np-footer-links a {
      color: #b8afbf;

      font-size: 11px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    #naya-power-app .np-footer-links a:hover {
      color: #fff;
    }

    #naya-power-app .np-footer-bottom {
      margin-top: 30px;

      color: #706877;

      font-size: 12px;
      line-height: 1.6;
    }

    /* =========================================================
       REVEAL
       ========================================================= */

    #naya-power-app .np-reveal {
      opacity: 1;
      transform: none;
    }

    #naya-power-app.np-js .np-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity .7s ease,
        transform .7s ease;
    }

    #naya-power-app.np-js .np-reveal.np-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 1050px) {

      #naya-power-app .np-nav {
        justify-content: flex-start;
      }

      #naya-power-app .np-top-actions {
        display: none;
      }

      #naya-power-app .np-hero-grid,
      #naya-power-app .np-final-grid {
        grid-template-columns: 1fr;
        gap: 55px;
      }

      #naya-power-app .np-grid {
        grid-template-columns: 1fr;
        gap: 50px;
      }

      #naya-power-app .np-grid.reverse .np-media,
      #naya-power-app .np-grid.reverse .np-copy {
        order: initial;
      }

      #naya-power-app .np-process {
        grid-template-columns: repeat(3, 1fr);
      }

      #naya-power-app .np-timeline {
        grid-template-columns: repeat(3, 1fr);
      }

      #naya-power-app .np-time:nth-child(3) {
        border-right: 0;
      }

      #naya-power-app .np-time:nth-child(n+4) {
        border-top: 1px solid var(--np-line-dark);
      }

      #naya-power-app .np-white .np-time:nth-child(n+4) {
        border-top-color: var(--np-line-light);
      }

    }

    @media (max-width: 700px) {

      #naya-power-app {
        --np-bar: 62px;
      }

      #naya-power-app .np-container {
        width: min(100% - 28px, 1180px);
      }

      #naya-power-app .np-appbar-inner {
        padding: 0 14px;
        gap: 12px;
      }

      #naya-power-app .np-brand {
        font-size: 10px;
      }

      #naya-power-app .np-nav a {
        padding: 8px 9px;
        font-size: 9px;
      }

      #naya-power-app .np-section {
        padding: 76px 0;
      }

      #naya-power-app .np-hero,
      #naya-power-app .np-hero-grid {
        min-height: auto;
      }

      #naya-power-app .np-hero-grid {
        padding: 70px 0;
      }

      #naya-power-app .np-title {
        font-size: clamp(42px, 13vw, 66px);
      }

      #naya-power-app .np-section-title {
        font-size: clamp(38px, 11vw, 58px);
      }

      #naya-power-app .np-body {
        font-size: 16px;
      }

      #naya-power-app .np-cards {
