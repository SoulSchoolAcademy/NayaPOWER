            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "qty": {
            "minimum": 0,
            "type": "integer"
          },
          "size": {
            "type": "string"
          }
        },
        "required": [
          "model",
          "name",
          "size",
          "qty",
          "note"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "rules": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "version": {
      "const": "contract-v1"
    },
    "vision": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "handle",
    "idea",
    "vision",
    "do",
    "behave",
    "template",
    "functions",
    "pieces",
    "rules"
  ],
  "title": "Smart Factory draftContract JSON contract-v1",
  "type": "object"
