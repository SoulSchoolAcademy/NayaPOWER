      },
      "type": "object"
    },
    "handle": {
      "pattern": "^[a-z0-9]*$",
      "type": "string"
    },
    "idea": {
      "type": "string"
    },
    "pieces": {
      "items": {
        "additionalProperties": false,
        "properties": {
