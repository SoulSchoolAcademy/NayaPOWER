{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naya.kernel.genome.v1",
  "title": "NayaPOWER Nine-Node Genome Contract",
  "type": "object",
  "required": [
    "schema_version",
    "kernel_id",
    "node_order",
    "nodes",
    "proof_ladder",
    "receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kernel_id": {
      "const": "NAYAPOWER-MASTER-KERNEL-V1"
    },
    "node_order": {
      "const": [
        "SELF",
        "LAW",
        "ACT",
        "KNOW",
        "PROVE",
        "CONNECT",
        "VERIFY",
        "LEARN",
        "EVOLVE"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9
    },
    "proof_ladder": {
      "type": "array",
      "items": {
        "enum": [
          "EXISTS",
          "LOADS",
          "INVOCATION",
          "INFLUENCE",
          "APPLICATION",
          "OUTCOME_OBSERVED",
          "VERIFIED",
          "LEARNED",
          "COMPOUNDED",
          "SUCCESSOR_RETAINED",
          "EVOLVED"
        ]
      }
    },
    "receipt": {
      "type": "object"
    }
  },
  "additionalProperties": false
}