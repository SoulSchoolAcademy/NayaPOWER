    {
      "naya_id": "layout.three-tongue",
      "human_label": "Three-tongue law cards",
      "category": "layout",
      "source_file": "DESIGN/SPECIMENS/page-specimens/naya-smart-blocks.html",
      "source_branch": "nitro/design-specimens-tmp",
      "html": "<div class=\"tongues\">\n      <div class=\"tongue\" style=\"--tc3:var(--soul)\"><h3>Machine \u00b7 normative</h3><ul><li><span class=\"jw\" style=\"--j:var(--magenta)\">\u25c6</span>idle.glow_max_px \u2264 18</li><li><span class=\"jw\" style=\"--j:var(--soul)\">\u25c6</span>rest.chrome = silver</li></ul></div>\n      <div class=\"tongue\" style=\"--tc3:var(--emerald)\"><h3>AI \u00b7 operational</h3><ul><li><span class=\"jw\" style=\"--j:var(--emerald)\">\u25c6</span>Glow only where a value is earned</li><li><span class=\"jw\" style=\"--j:var(--emerald)\">\u25c6</span>White at rest, color on touch</li></ul></div>\n      <div class=\"tongue\" style=\"--tc3:var(--gold)\"><h3>Human \u00b7 plain words</h3><ul><li><span class=\"jw\" style=\"--j:var(--gold)\">\u25c6</span>Calm until you need it excited</li><li><span class=\"jw\" style=\"--j:var(--gold)\">\u25c6</span>Expensive, not loud</li></ul></div>\n    </div>",
      "css_classes": [
        ".tongues",
