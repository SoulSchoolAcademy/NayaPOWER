    {
      "naya_id": "board.world-destination",
      "human_label": "Destination board (board-mix)",
      "category": "board",
      "source_file": "DESIGN/SPECIMENS/element-sets/epic-elements-lego-n5.html",
      "source_branch": "nitro/design-specimens-tmp",
      "html": "<div class=\"board-mix\" style=\"--ic:#a06bff\">\n    <span class=\"corner\" style=\"--ic:#a06bff\">\u25c6</span>\n    <h3>Color has four jobs. Never cross them.</h3>\n    <p>Chrome acts. Text speaks. Theme identifies. Adjacent things never share a hue.</p>\n  </div>",
      "css_classes": [
        ".board-mix",
        ".corner"
      ],
      "function": "A world, not a rectangle: theme-edged, corner-jewel-marked board. One spectrum color owns the room's destination.",
      "props": {
        "tunable": [
          "accent_color",
          "title",
          "copy"
        ]
      }
    },
    {
      "naya_id": "board.layered-intelligence",
      "human_label": "Layered intelligent block (board-tone)",
      "category": "board",
      "source_file": "DESIGN/SPECIMENS/element-sets/epic-elements-lego-n5.html",
      "source_branch": "nitro/design-specimens-tmp",
      "html": "<div class=\"board-tone\" style=\"--tone:var(--purple)\">\n    <div class=\"board-content\">\n      <p class=\"board-tag\">Intelligent Block \u00b7 IB-0001</p>\n      <h3 class=\"board-name\">The board is a world.</h3>\n      <p class=\"board-sub\">Not a rectangle. A destination you enter.</p>\n      <div class=\"layer-grid\">\n        <div class=\"layer\" style=\"--tone:var(--purple)\"><p class=\"micro\"><span class=\"gem-bullet\"></span>In a nutshell</p><p>Capture the essence. Verify the result.</p></div>\n        <div class=\"layer\" style=\"--tone:var(--blue)\"><p class=\"micro\"><span class=\"gem-bullet\"></span>What it means</p><p>Understanding changes what Naya does next.</p></div>\n        <div class=\"layer\" style=\"--tone:var(--gold)\"><p class=\"micro\"><span class=\"gem-bullet\"></span>How to use it</p><p>Retrieve, check limits, carry into action.</p></div>\n      </div>\n    </div>\n  </div>",
      "css_classes": [
        ".board-tone",
        ".board-content",
        ".board-tag",
        ".board-name",
        ".board-sub",
        ".layer-grid",
        ".layer",
        ".gem-bullet",
        ".micro"
      ],
      "function": "The intelligent block pattern: tag, name, sub, then meaning nested in layers (nutshell \u2192 meaning \u2192 use).",
      "props": {
        "tunable": [
          "accent_color",
          "tag",
          "title",
          "layers"
        ]
      }
    },
    {
      "naya_id": "board.elevated",
      "human_label": "Elevated board",
      "category": "board",
      "source_file": "DESIGN/SPECIMENS/page-specimens/naya-smart-blocks.html",
      "source_branch": "nitro/design-specimens-tmp",
      "html": "<div class=\"elevated-board\" style=\"--tone:var(--soul)\">\n        <span class=\"board-spine\"></span><span class=\"board-corner\"></span>\n        <h3 style=\"font-family:var(--voice);font-size:24px;margin:0 0 6px;color:#fff\">The Reading Room</h3>\n        <p style=\"color:var(--ink-dim);font-size:14px;margin:0;max-width:420px;line-height:1.6\">Every note you ever kept, arranged the way your mind already arranged them.</p>\n      </div>",
      "css_classes": [
        ".elevated-board",
        ".board-spine",
        ".board-corner"
      ],
      "function": "Deep black board with an identity spine and corner marks that catch the light. A room you step into.",
      "props": {
        "tunable": [
          "tone",
          "title",
          "copy"
        ]
      }
    },
    {
      "naya_id": "card.truth-trio",
      "human_label": "Truth badge cards",
      "category": "card",
      "source_file": "DESIGN/SPECIMENS/element-sets/epic-elements-lego-n5.html",
      "source_branch": "nitro/design-specimens-tmp",
      "html": "<div class=\"truthgrid\">\n    <div class=\"truth\" style=\"--tc2:#2fe89e\"><span class=\"torb\" style=\"--tc2:#2fe89e\">\u2713</span><div><b>AUTH \u00b7 VERIFIED</b><p>Independent evidence exists. The number survived contact with reality.</p></div></div>\n    <div class=\"truth\" style=\"--tc2:#ffbf3d\"><span class=\"torb\" style=\"--tc2:#ffbf3d\">?</span><div><b>CLAIM \u00b7 UNVERIFIED</b><p>Self-reported, awaiting its stamp. Shown honestly, never hidden.</p></div></div>\n    <div class=\"truth\" style=\"--tc2:#e84fff\"><span class=\"torb\" style=\"--tc2:#e84fff\">\u25c8</span><div><b>DEMONSTRATION</b><p>Specimen content. Beautiful on purpose, not pretending to be live.</p></div></div>\n  </div>",
      "css_classes": [
        ".truthgrid",
        ".truth",
        ".torb"
      ],
      "function": "A claim and a proof must never look the same: VERIFIED (green orb), CLAIM (gold), DEMONSTRATION (magenta).",
      "props": {
        "tunable": [
          "states"
        ]
      }
    },
    {
      "naya_id": "card.law-cards",
      "human_label": "Law cards",
      "category": "card",
      "source_file": "DESIGN/SPECIMENS/page-specimens/naya-smart-blocks.html",
      "source_branch": "nitro/design-specimens-tmp",
      "html": "<div class=\"laws\">\n      <div class=\"lawcard\" style=\"--lc:var(--magenta)\"><p class=\"ln\"><span class=\"ld\"></span>Law 1</p><h3>Score the experience, never the code.</h3><p>The lived page is the only scorecard.</p></div>\n      <div class=\"lawcard\" style=\"--lc:var(--emerald)\"><p class=\"ln\"><span class=\"ld\"></span>Law 2</p><h3>Restraint is the excellence.</h3><p>Less glow, fewer colors, generous black space.</p></div>\n      <div class=\"lawcard\" style=\"--lc:var(--gold)\"><p class=\"ln\"><span class=\"ld\"></span>Law 3</p><h3>Every effect encodes information.</h3><p>No visual is acceptable merely because it moves.</p></div>\n    </div>",
      "css_classes": [
        ".laws",
        ".lawcard",
        ".ln",
        ".ld"
      ],
      "function": "Law dials: numbered law cards with a spectrum light, one per law. The contract made visible.",
      "props": {
        "tunable": [
          "accent_color",
          "law_number",
          "title",
          "text"
        ]
      }
    },
