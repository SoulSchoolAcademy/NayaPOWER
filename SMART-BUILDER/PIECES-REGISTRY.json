      "source_file": "DESIGN/SPECIMENS/page-specimens/naya-smart-blocks.html",
      "source_branch": "nitro/design-specimens-tmp",
      "html": "<footer class=\"naya-footer\">\n        <div class=\"naya-footer-inner\">\n          <div><div class=\"naya-footer-brand\">NayaNET</div><p class=\"naya-footer-tag\">Intelligence you can hold. Built to compound, designed to disappear.</p></div>\n          <div><h4>Build</h4><a href=\"#buttons\">Buttons</a><a href=\"#cards\">Cards</a><a href=\"#new\">New P0</a></div>\n          <div><h4>Learn</h4><a href=\"#data\">Data</a><a href=\"#specialty\">Specialty</a><a href=\"#overlays\">Overlays</a></div>\n          <div><h4>Go</h4><a href=\"#navigation\">Navigation</a><a href=\"#inputs\">Inputs</a><a href=\"#media\">Media</a></div>\n        </div>\n        <div class=\"naya-footer-base\"><span>\u00a9 2026 NayaNET \u2014 black is the suit.</span><span>Made of light, kept honest.</span></div>\n      </footer>",
