  "pieces": [
    {
      "naya_id": "hero.naya-entrance",
      "human_label": "Naya entrance hero (N5 lego)",
      "category": "hero",
      "source_file": "DESIGN/SPECIMENS/element-sets/epic-elements-lego-n5.html",
      "source_branch": "nitro/design-specimens-tmp",
      "html": "<header class=\"hero wrap\">\n  <h1>The Naya <span class=\"soul\">Ultimate</span> Lego Library</h1>\n  <p class=\"tagline\">The best of the best. One library. Every component copy-paste ready.</p>\n  <p class=\"law-line\">One standard \u00b7 Every page \u00b7 No drift</p>\n  <div class=\"spectrum-bar\" aria-label=\"Spectrum: magenta, purple, blue, green, gold\"><span></span><span></span><span></span><span></span><span></span></div>\n  <p class=\"spectrum-label\">Magenta \u2192 Purple \u2192 Blue \u2192 Green \u2192 Gold</p>\n  <div style=\"height:56px\"></div>\n  <div class=\"hero-buttons\">\n    <button class=\"naya-btn naya-btn--primary\" data-spectrum=\"magenta\" onclick=\"document.getElementById('buttons').scrollIntoView({behavior:'smooth'})\">\n      <span class=\"btn-glow\"></span>\n      <span class=\"btn-label\">\u2726 ENTER THE STANDARD</span>\n    </button>\n    <button class=\"naya-btn naya-btn--primary\" data-spectrum=\"purple\" onclick=\"document.getElementById('smarttabs').scrollIntoView({behavior:'smooth'})\">\n      <span class=\"btn-glow\"></span>\n      <span class=\"btn-label\">\u25c8 SEE IT WORKING</span>\n    </button>\n    <button class=\"naya-btn naya-btn--primary\" data-spectrum=\"blue\" onclick=\"document.getElementById('laws').scrollIntoView({behavior:'smooth'})\">\n      <span class=\"btn-glow\"></span>\n      <span class=\"btn-label\">\uff0b READ THE LAW</span>\n    </button>\n  </div>\n  <p class=\"micro btn-note\">These three buttons are the standard. Living depth. Lit at rest. Ignite on touch.<br>Every button you ever build starts here.</p>\n  <nav class=\"toc\">\n    <a href=\"#buttons\">Buttons</a><a href=\"#smarttabs\">SmartTabs</a><a href=\"#spectrum\">Spectrum</a><a href=\"#boards\">Boards</a><a href=\"#jewels\">Jewels</a><a href=\"#type\">Typography</a><a href=\"#truth\">Truth</a><a href=\"#laws\">Laws</a><a href=\"#rules\">Do's & Don'ts</a><a href=\"#machine\">Machine Law</a>\n  </nav>\n</header>",
      "css_classes": [
        ".hero",
        ".living-btn",
        ".naya-btn",
        ".naya-btn--primary",
        ".soul",
        ".spectrum-bar",
        ".tagline",
        ".toc"
      ],
      "function": "The entrance ritual: identity headline, spectrum strip, three living CTA buttons and an anchor nav. One spectrum-bar + one hero per page.",
      "props": {
        "tunable": [
          "headline",
          "tagline",
          "cta_labels",
          "cta_targets"
        ]
      },
      "normalizations": [
        "living-btn -> naya-btn naya-btn--primary (3 buttons): pre-canonical specimen class retired per DESIGN contract (.naya-btn is THE button); data-spectrum + onclick behavior preserved verbatim"
      ]
    },
