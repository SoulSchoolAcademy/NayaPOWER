      "category": "card",
      "source_file": "DESIGN/SPECIMENS/page-specimens/naya-smart-blocks.html",
      "source_branch": "nitro/design-specimens-tmp",
      "html": "<div class=\"jobs\">\n      <div class=\"job\" style=\"--jc:var(--soul)\"><div class=\"swatch\" style=\"background:linear-gradient(120deg,var(--soul),transparent)\"></div><h3>Design</h3><p>Bring the library page to a 9+.</p></div>\n      <div class=\"job\" style=\"--jc:var(--emerald)\"><div class=\"swatch\" style=\"background:linear-gradient(120deg,var(--emerald),transparent)\"></div><h3>Verify</h3><p>Independent eyes on every claim.</p></div>\n      <div class=\"job\" style=\"--jc:var(--gold)\"><div class=\"swatch\" style=\"background:linear-gradient(120deg,var(--gold),transparent)\"></div><h3>Ship</h3><p>Merge what earned it, nothing else.</p></div>\n    </div>",
      "css_classes": [
        ".jobs",
        ".job",
        ".swatch"
      ],
      "function": "Three-up card grid with a color swatch wash per card \u2014 for offerings, actions, template previews.",
