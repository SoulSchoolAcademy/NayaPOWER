+    var ctl=document.getElementById('skillsControls'),sign=document.getElementById('skillsSign');
+    var next=document.getElementById('skillsNext'),all=document.getElementById('skillsAll'),idx=1;
+    function scrollBehavior(){return window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth';}
+    function show(n){var b=beats[n];if(!b)return;b.hidden=false;b.classList.add('reveal');if(dots[n])dots[n].classList.add('on');}
+    function ensureBeatVisible(b){
+      if(!b)return;
+      var r=b.getBoundingClientRect();
+      if(r.bottom>window.innerHeight||r.top<0){
+        b.scrollIntoView({behavior:scrollBehavior(),block:'nearest',inline:'nearest'});
+      }
+    }
+    function bringButtonIntoView(){
+      var btn=document.getElementById('skillsSign');
+      if(!btn)return;
+      var doScroll=function(){btn.scrollIntoView({behavior:scrollBehavior(),block:'center',inline:'nearest'});};
+      if(window.requestAnimationFrame)window.requestAnimationFrame(doScroll);else doScroll();
+    }
+    function finish(){ctl.hidden=true;sign.hidden=false;sign.classList.add('reveal');bringButtonIntoView();}
+    if(next)next.addEventListener('click',function(){
+      if(idx<beats.length){var cur=idx;show(cur);idx++;if(idx>=beats.length)finish();else ensureBeatVisible(beats[cur]);}
+    });
+    if(all)all.addEventListener('click',function(){
+      for(var k=1;k<beats.length;k++)show(k);
+      idx=beats.length;finish();
+    });
+  })();
